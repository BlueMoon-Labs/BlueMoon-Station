/datum/gear/neck/syntech/pendant
	name = "Normalizer Pendant"
	description = "Яркий фиолетовый камень в серебристо-золотом металле — элегантность NanoTrasen и мощь SynTech. Пока надето, украшение «нормализует» размер владельца до заданного роста, одобренного для условий работы. Искусственный фиолетовый камень внутри зловеще мерцает."
	path = /obj/item/clothing/neck/syntech

/datum/gear/neck/syntech/choker
	name = "Normalizer Choker"
	description = "Гладкий плотный чокер с серебряной и золотой отделкой, украшенный ярко-фиолетовыми шпильками; объединённая технология NanoTrasen и SynTech. Пока надет, он «нормализует» размер владельца до заданного роста, одобренного для условий работы. На нём жужжит маленький экран с информацией."
	path = /obj/item/clothing/neck/syntech/choker

/datum/gear/neck/syntech/collar
	name = "Normalizer Collar"
	description = "Милый ошейник для питомца, технологично оформленный в ярко-фиолетовом и гладком серебристом цветах. Спереди маленький камень в золотой оправе, на металле выгравировано «SYNTECH». Пока надет, он «нормализует» размер владельца до заданного роста, одобренного для условий работы. Искусственный фиолетовый камень внутри зловеще мерцает."
	path = /obj/item/clothing/neck/syntech/collar

/datum/gear/neck/polypetcollar
	name = "Collar (poly)"
	description = "Это для питомцев. Хоть ты и сам мог бы это надеть, но неизбежно стал бы посмешищем. Похоже, сделано из полихромного материала."
	path = /obj/item/clothing/neck/petcollar/poly
	loadout_flags = LOADOUT_CAN_NAME_DESC_POLY
	loadout_initial_colors = list("#00bb70", "#FFC600")

