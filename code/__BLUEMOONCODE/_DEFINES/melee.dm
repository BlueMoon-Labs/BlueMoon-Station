#define MARTIALART_HONEST_BOXING "honest_boxing" // honest-boxing

// Шкала бронепробития для ближнего боя (/obj/item/armour_penetration).
//
// AP вычитается из брони ПЛОСКИМ значением, а не в процентах:
//   living_defense.dm:29 - armor = max(0, armor - armour_penetration)
// Итоговое снижение урона капнуто на 90% (species.dm:2127), т.е. 100 брони = полный иммунитет.
//
// Для ориентира - снижение урона по тиру против основных костюмов:
//   костюм (melee)     AP 0   AP 15  AP 25  AP 50
//   platecarrier (40)   40%    25%    15%     0%
//   combat armor (50)   50%    35%    25%     0%
//   riot suit (70)      70%    55%    45%    20%
//   knight/com (80)     80%    65%    55%    30%
#define MELEE_AP_CIVILIAN 0 // бытовое, инструменты, импровизация - пробития нет вообще
#define MELEE_AP_COMBAT 15 // серийное оружие, выдаваемое персоналом
#define MELEE_AP_ANTAGONIST 25 // антагонисты и Центральное Командование
#define MELEE_AP_EXCLUSIVE 50 // уникальное и легендарное оружие, высший тир

// AP ближнего боя сжат до четырёх тиров (потолок 50 вместо прежних 70-200),
// поэтому энергощит MOD-а, который тратит ячейку пропорционально AP
// (modules_security.dm - calculate_cell_drain), стал бы почти бесплатным против клинков.
// Компенсируем только для melee, чтобы баланс огнестрела и лазеров не сдвинулся:
// 15 -> 22.5, 25 -> 37.5, 50 -> 75 (было 70-100 у элитного ближнего боя).
#define MOD_SHIELD_MELEE_AP_MULTIPLIER 1.5
