// Дефайны шагового расписания и зонда шагов.
//
// Лежат здесь, а не рядом с кодом в modular_bluemoon, потому что #define в DM
// виден только ниже по порядку включения, а юнит-тесты подключаются раньше
// модульного блока.

/// Допуск при переводе задержки в тики. Задержка складывается из десятка
/// модификаторов (турф, пуллинг, вес, спринт, урон) и приходит с плавающим
/// хвостом. Без допуска хвост в 1e-7 добавил бы целый лишний тик, а на беге
/// это пятая часть скорости из ничего.
#define MOVEMENT_TICK_EPSILON 0.0001

/// Мёртвая зона множителя glide. Дилатация меньше этой глазом не отличима -
/// два процента шага при 32 пикселях на тайл дают полпикселя, - а вот
/// множитель, застрявший в 0.99, ломает главное свойство выровненного
/// расписания: glide перестаёт быть ровным числом пикселей на тик, и спрайт
/// систематически не доезжает до тайла.
///
/// Зона одна на оба конца обработки: и на замер, и на сглаженный результат.
/// Раньше результат снапился своей зоной в четыре раза уже, и после каждой
/// настоящей просадки множитель подолгу висел в полосе 0.98-0.995 - ровно в том
/// состоянии, ради отсутствия которого зона и заводилась.
#define MOVEMENT_GLIDE_DILATION_DEADBAND 0.02

// Дальше идёт зонд шагов - диагностика, а не механика. Ни один дефайн отсюда
// боевой код не читает, поэтому убрать зонд можно вместе с этим блоком и его
// файлами в modular_bluemoon/code/modules/movement_schedule.

/// Шаг не сменил тайл - персонаж упёрся. Шаг при этом потрачен, а glide
/// выставлен, так что кадр всё равно испорчен.
#define MOVEMENT_PROBE_BLOCKED "упёрся"
/// Задержка шага изменилась - интервал объясняется этим, а не сбоем.
#define MOVEMENT_PROBE_SPEED_CHANGE "смена скорости"
/// Интервал заметно длиннее номинала без видимой причины: пауза ввода,
/// просадка тика или потерянное нажатие.
#define MOVEMENT_PROBE_STALL "пауза"
/// Гуляние вокруг номинала в пределах тика - так и должно быть.
#define MOVEMENT_PROBE_NORMAL "норма"

/// Насколько интервал должен превысить номинал, чтобы считаться паузой.
/// Один тик - это штатное гуляние дискретной сетки, а не выброс.
#define MOVEMENT_PROBE_STALL_MARGIN 1

/// В паузе виноват просевший сервер: серверное время отстало от настоящего.
#define MOVEMENT_PROBE_STALL_SERVER "просадка сервера"
/// Отставание есть, но в полосе, где вердикт по одному замеру ненадёжен.
#define MOVEMENT_PROBE_STALL_UNCLEAR "сервер на грани"
/// Игрок сам отпускал клавишу - пауза его собственная, а не сбой.
#define MOVEMENT_PROBE_STALL_RELEASED "отпустил клавишу"
/// Сервер шёл вровень, клавиша была зажата насквозь - вот это уже настоящая
/// потеря: ввод не дошёл или его съел гейт в /client/Move.
#define MOVEMENT_PROBE_STALL_ELSEWHERE "не сервер"
/// Ниже этого отставание считается настоящим, а не разбросом замера.
#define MOVEMENT_PROBE_DILATION_MARGIN 0.9
/// Между порогом и этим значением вердикт неопределённый: разброс замера того
/// же порядка, что и сама величина.
#define MOVEMENT_PROBE_DILATION_UNCERTAIN 0.95

/// Недоезд меньше пикселя показывать бессмысленно: пиксель - минимальная
/// единица, которая вообще способна быть видна на экране.
#define MOVEMENT_PROBE_UNDERSHOOT_PIXELS 1

/// Скачок недоезда, начиная с которого шаг попадает в выбросы. Четверть тайла -
/// это уже смена скорости спрайта, которую видно, а не сдвиг картинки.
///
/// Порог намеренно грубый. Мелкий разброс недоезда есть всегда, и если тащить
/// его в отчёт, выбросом станет каждый второй шаг - на этом список выбросов
/// один раз уже потерял смысл.
#define MOVEMENT_PROBE_UNDERSHOOT_JUMP_PIXELS 8

/// Сколько шагов зонд держит в памяти. Бегом это около минуты записи.
#define MOVEMENT_PROBE_MAX_SAMPLES 400
/// Интервал длиннее этого считается паузой между забегами, а не шагом.
#define MOVEMENT_PROBE_SERIES_GAP 20
