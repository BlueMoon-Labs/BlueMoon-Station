/**
 * Категории книги недатумных аллокаций. Номера, а не строки: книга - плоский числовой
 * список, и индекс по константе дешевле поиска по ключу в горячем проке.
 *
 * Лежат отдельно от самой книги (code/__HELPERS/nondatum_ledger.dm), потому что их зовут
 * файлы, которые включаются раньше неё: icons.dm стоит в tgstation.dme выше __HELPERS,
 * а дефайн, объявленный позже первого использования, для DM просто не существует.
 */

/// Иконок собрано (getFlatIcon, icon2html мимо кэша, icon2base64 и родня).
#define NONDATUM_LEDGER_ICONS 1
/// Пикселей в собранных иконках - размер важнее числа: одна иконка манекена во весь рост
/// стоит сотни маленьких.
#define NONDATUM_LEDGER_ICON_PIXELS 2
/// Байтов ассетов, отправленных клиентам (browse_rsc через транспорт ассетов).
#define NONDATUM_LEDGER_ASSET_BYTES 3
/// Байтов ресурсов, отправленных клиентам напрямую по игровому соединению (Export load_rsc).
#define NONDATUM_LEDGER_RSC_BYTES 4
/// Байтов собранных полезных нагрузок tgui (json + url_encode + склейка живут в памяти разом).
#define NONDATUM_LEDGER_TGUI_BYTES 5
/// Байтов полезных нагрузок статбраузера (статус-таб и иконки осмотренного турфа). Идут
/// каждому клиенту каждый стат-тик и собираются json + url_encode, то есть двумя копиями.
#define NONDATUM_LEDGER_STATPANEL_BYTES 6
/// Проходов сборки спрайтшитов через IconForge.
#define NONDATUM_LEDGER_SPRITESHEETS 7
/// Ширина книги. Держать в конце: снимок - плоский список этой длины.
#define NONDATUM_LEDGER_LEN 7
