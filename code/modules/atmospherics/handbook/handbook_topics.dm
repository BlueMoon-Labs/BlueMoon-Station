// Разделы внутриигрового справочника сверх газов и реакций.
//
// Газы и реакции справочник описывал и раньше, но ни одно устройство и ни одна
// схема сборки не были описаны нигде: игрок узнавал их с вики или перебором.
// Здесь лежит то, что должно было быть в игре с самого начала.
//
// Текст держится в датумах, а не в TGUI, ровно по одной причине: числа
// механики живут в дефайнах, и справочник обязан пересчитываться вместе с
// ними. Захардкоженные в интерфейсе числа разъедутся с балансом в первую же
// правку и никто этого не заметит.

/datum/atmos_handbook_topic
	/// Раздел, в котором топик показывается. Он же заголовок секции в окне.
	var/category
	/// Заголовок топика.
	var/title
	/// Порядок внутри раздела. Задаётся с шагом, чтобы вставка нового топика в
	/// середину не требовала перенумеровать соседей.
	var/order = 0
	/// Абзацы. Окно рисует каждый отдельным блоком.
	var/list/paragraphs

/datum/atmos_handbook_topic/New()
	..()
	init_body()

/// Собирает абзацы. Вынесено из инициализатора переменной по той же причине,
/// по которой у реакций есть init_factors: тексты подставляют числа из
/// дефайнов, и держать их рядом с механикой надёжнее, чем переписывать руками.
/datum/atmos_handbook_topic/proc/init_body()
	paragraphs = list()

/// Порядок топиков внутри раздела. Без явного поля он зависел бы от порядка
/// типов в дереве, то есть от порядка include в .dme - справочник менял бы
/// структуру от несвязанной правки.
/proc/cmp_atmos_handbook_topic_asc(datum/atmos_handbook_topic/a, datum/atmos_handbook_topic/b)
	return a.order - b.order

/// Порядок разделов в окне. Ведётся явно по той же причине, что и порядок
/// топиков.
GLOBAL_LIST_INIT(atmos_handbook_categories, list(
	ATMOS_HANDBOOK_CATEGORY_TOOLS,
	ATMOS_HANDBOOK_CATEGORY_METHODS,
	ATMOS_HANDBOOK_CATEGORY_SAFETY,
))

// ИНСТРУМЕНТЫ

/datum/atmos_handbook_topic/pipes
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Трубы, слои и RPD"
	order = 10

/datum/atmos_handbook_topic/pipes/init_body()
	paragraphs = list(
		"Трубы и устройства ставит RPD. В нём три вкладки: обычные трубы, устройства и теплообменные трубы. Гаечный ключ прикручивает то, что вы выложили; сама выложенная заготовка ещё ничего не соединяет.",
		"На одном тайле помещаются пять независимых слоёв разводки. Слой у заготовки переключается прямо в RPD, и трубы разных слоёв друг друга не видят вообще. Если две трубы лежат вплотную и не соединились - почти всегда дело в слое. Перейти со слоя на слой можно послойным манифолдом.",
		"Кроме слоя соединение решает цвет: покрашенные в разные цвета трубы одного слоя не стыкуются. Цветовой адаптер - единственное место, где цвет меняется без разрыва линии. Красьте разводку по назначению, а не по вкусу: это единственная подпись, которую линия несёт на себе.",
	)

/datum/atmos_handbook_topic/pumps
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Насосы и клапаны"
	order = 20

/datum/atmos_handbook_topic/pumps/init_body()
	paragraphs = list(
		"Газовый насос задаёт ДАВЛЕНИЕ на выходе и качает, пока выход его не достигнет. Потолок уставки - [MAX_OUTPUT_PRESSURE] кПа. Это рабочая лошадь любой разводки: почти везде, где нужно перегнать газ, стоит именно он.",
		"Объёмный насос задаёт РАСХОД в литрах в секунду, до [MAX_TRANSFER_RATE] л/с, и не смотрит на давление вообще - он останавливается только на [VOLUME_PUMP_PRESSURE_CEILING] кПа. Быстрее газового, и только он додавливает линию до давлений, куда газовый насос не достаёт.",
		"Ручной клапан открывают и закрывают руками, цифровой - сигналом на расстоянии. Пассивный клапан пропускает газ сам, без питания, пока перепад давления идёт в нужную сторону, и придерживает выход на заданной отметке.",
		"Клапан давления открывается сам, когда давление на входе перешло порог, и закрывается, когда упало. Питания не требует. Из него получается регулятор: высокое давление в магистрали, обычное - в разводке за клапаном.",
		"Сбросной клапан бывает двух видов. Двухпортовый при перегрузке пропускает газ дальше по трубе, однопортовый выбрасывает его прямо в помещение. Оба - страховка: порог задаёт давление, выше которого линия не поднимется.",
	)

/datum/atmos_handbook_topic/vents
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Вентиляция и скрубберы"
	order = 30

/datum/atmos_handbook_topic/vents/init_body()
	paragraphs = list(
		"Вент нагнетает воздух из трубы в комнату и умеет работать в обе стороны: подавать до заданного давления или, наоборот, откачивать комнату в трубу. Именно переключением вентов на откачку и вычищают загазованный отсек.",
		"Скруббер сосёт из комнаты не всё подряд, а выбранные газы, и отправляет их в контур отходов. В обычном режиме он обрабатывает только свой тайл; расширенный режим захватывает соседние, но и грузит систему сильнее.",
		"Инжектор - это вент без регулятора: он льёт газ в комнату с заданным расходом, не глядя на давление. Им наполняют камеры, им же устраивают залив станции. Пассивный вент вообще ничем не управляет: это просто дыра из трубы в комнату.",
		"Вентами и скрубберами в отсеке командует воздушная тревога. Всё, что вы настраиваете на самом венте, тревога может переписать - если правите руками, отключите отсек от неё или правьте через её же панель.",
	)

/datum/atmos_handbook_topic/filters
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Фильтры и смесители"
	order = 40

/datum/atmos_handbook_topic/filters/init_body()
	paragraphs = list(
		"Фильтр забирает поток с входа, отводит ВЫБРАННЫЙ газ в боковой порт, а всё остальное пропускает прямо. Чтобы разложить смесь на составляющие, фильтры ставят цепочкой: каждый снимает свой газ, а в конце остаётся то, что не отфильтровали.",
		"Смеситель делает обратное: сводит два входа в один выход в заданной пропорции. Доли задаются в процентах и в сумме дают сто. Так собирают дыхательную смесь и любую другую по рецепту.",
		"Омни-фильтр и омни-смеситель - те же машины на четыре порта: у каждого порта своя роль и свой газ, и одна машина заменяет цепочку. Стоят дороже, зато не отнимают место в тесной технической.",
	)

/datum/atmos_handbook_topic/temperature
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Нагрев и охлаждение"
	order = 50

/datum/atmos_handbook_topic/temperature/init_body()
	paragraphs = list(
		"Термомашина - основной способ задать температуру. Морозильник и нагреватель это одна и та же машина в разных сборках; её диапазон зависит от установленных деталей, и осмотр честно показывает, до чего именно она дотянет. Чем лучше детали, тем шире диапазон и тем быстрее выход на режим.",
		"Тепловой насос перекачивает тепло из одной линии в другую, не перегоняя сам газ. Им греют один контур за счёт другого - это дешевле, чем греть нагревателем и морозить морозильником по отдельности.",
		"Теплообменные трубы обмениваются теплом с тем турфом, на котором лежат. В космосе они отдают тепло даром и без питания - это самый мощный холодильник в игре. На лаве всё наоборот: они греют. Соединяются такие трубы с обычными только через переходник.",
		"Теплообменник ставится между двумя такими контурами и гоняет тепло между ними. Температурные ворота пропускают газ дальше только когда он с нужной стороны от порога - так горячий газ не уходит в обычную разводку раньше, чем остынет.",
	)

/datum/atmos_handbook_topic/instruments
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Приборы и переносное"
	order = 60

/datum/atmos_handbook_topic/instruments/init_body()
	paragraphs = list(
		"Газоанализатор показывает состав, температуру и давление того, на что его навели: турфа, трубы, канистры, бака.",
		"Метр прикручивается к трубе и постоянно показывает давление в ней. Метр на выходе насоса - самый дешёвый способ видеть линию, не открывая панелей.",
		"Канистры хранят газ и стыкуются с разъёмом коннектора. Давление сброса задаётся на самой канистре.",
		"Переносные насос и скруббер работают с воздухом комнаты, в которой стоят, и не требуют разводки вообще. Космический электролизёр так же работает с воздухом вокруг себя: разбирает пар на кислород и водород, BZ - на галон, а под разрядом супермтерии переворачивает гипернобель в антиноблий.",
	)

/datum/atmos_handbook_topic/production
	category = ATMOS_HANDBOOK_CATEGORY_TOOLS
	title = "Кристаллизатор и производство"
	order = 70

/datum/atmos_handbook_topic/production/init_body()
	paragraphs = list(
		"Кристаллизатор превращает газ в предметы. Ему нужны два порта: подающая линия и линия отвода. Рецепт выбирается в панели, там же видно, каких газов и сколько не хватает.",
		"У верхних рецептов - алмаз и осколок супермтерии - есть ещё одно требование: давление на подающей линии не ниже [GAS_RECIPE_HIGH_PRESSURE] кПа. Газовый насос столько не даёт - подающую линию додавливают объёмным насосом или нагревом. Машина вслух говорит, чего именно ей не хватает.",
		"Правило простое: чем глубже цепочка газа, тем дороже и требовательнее рецепт. Дешёвые рецепты дают расходники, дорогие - вещи на всю смену.",
	)

// МЕТОДЫ

/datum/atmos_handbook_topic/station_loop
	category = ATMOS_HANDBOOK_CATEGORY_METHODS
	title = "Как устроена станционная разводка"
	order = 10

/datum/atmos_handbook_topic/station_loop/init_body()
	paragraphs = list(
		"Штатных контуров два. Раздающий несёт дыхательную смесь из бака смеси ко всем вентам станции и держится примерно на [round(ONE_ATMOSPHERE)] кПа - ровно столько, сколько нужно в комнатах. Контур отходов собирает то, что вытянули скрубберы, и уводит его на выброс или в камеру сжигания.",
		"Между ними стоят баки: кислород, азот, углекислота, плазма, закись азота, воздух и смесь. Каждый бак виден в консоли мониторинга атмосферики, и там же у бака-смесителя есть управление подачей и выпуском.",
		"Первое, что стоит сделать в начале смены, - посмотреть на консоль, а не бежать в трубы. Сенсор, который молчит, и бак, который пуст, выглядят в консоли по-разному, и это половина диагностики.",
		"Второе - не поднимать давление в раздающем контуре просто так. Оно не даёт ничего: комнаты всё равно наполняются до уставки вента.",
	)

/datum/atmos_handbook_topic/build_loop
	category = ATMOS_HANDBOOK_CATEGORY_METHODS
	title = "Как собрать свой контур"
	order = 20

/datum/atmos_handbook_topic/build_loop/init_body()
	paragraphs = list(
		"Порядок такой: решить, откуда газ и куда он идёт; выложить трубы одним слоем и одним цветом; поставить насос в начале и то, ради чего всё делается, в конце; прикрутить всё ключом; и только потом подавать газ.",
		"До подачи газа продуйте линию. В любой свежесобранной трубе лежит тот воздух, который был на тайле, и он попадёт в вашу смесь. Пустая линия набирается вентом на откачку или объёмным насосом в отходы.",
		"Ставьте метр там, где давление важно: одна дешёвая деталь на этапе сборки экономит смену на поиске проблемы вслепую.",
		"Замкнутый контур без выхода - самая частая ошибка. Насос, качающий в тупик, поднимает там давление ровно до своей уставки и дальше просто молотит вхолостую. Всегда оставляйте сброс: клапан, отвод в отходы или бак.",
	)

/datum/atmos_handbook_topic/cooling
	category = ATMOS_HANDBOOK_CATEGORY_METHODS
	title = "Как получить нужную температуру"
	order = 30

/datum/atmos_handbook_topic/cooling/init_body()
	paragraphs = list(
		"Половина верхней химии живёт в узком температурном окне, и попасть в него важнее, чем набрать моли. Смотрите в карточку реакции: там написана и нижняя, и верхняя граница.",
		"Дёшево охладить можно теплообменными трубами в космосе - они работают без питания и уводят тепло в пустоту. Дорого и точно - термомашиной: она держит заданную отметку, но упирается в диапазон своих деталей.",
		"Греть проще всего нагревателем, а держать горячий газ в контуре - температурными воротами: они не выпустят его дальше, пока он не остынет до нужной отметки.",
		"Помните, что реакции сами меняют температуру. Экзотермический синтез разгоняет контур вверх и может выбить сам себя из окна, эндотермический - наоборот, замерзает и останавливается. Смотрите на строку про энергию в карточке реакции.",
	)

/datum/atmos_handbook_topic/breach
	category = ATMOS_HANDBOOK_CATEGORY_METHODS
	title = "Что делать при разгерметизации"
	order = 40

/datum/atmos_handbook_topic/breach/init_body()
	paragraphs = list(
		"Сначала перекрыть, потом откачивать. Файрлоки закрываются сами, но дальше по коридору давление продолжит падать, пока дыра открыта. Заварить пробоину, поставить стену или хотя бы закрыть шлюз - первое действие.",
		"Дальше отсек наполняют. Вент в режиме подачи с уставкой около [round(ONE_ATMOSPHERE)] кПа сделает это сам; для большого объёма быстрее инжектор или переносной насос от канистры воздуха.",
		"Загазованный, а не разгерметизированный отсек чистят иначе: скрубберы переводят на нужный газ и на расширенный захват, а вент - на откачку. Когда состав вернулся к норме, вент переключают обратно на подачу.",
	)

// БЕЗОПАСНОСТЬ

/datum/atmos_handbook_topic/breathing
	category = ATMOS_HANDBOOK_CATEGORY_SAFETY
	title = "Давление и температура"
	order = 10

/datum/atmos_handbook_topic/breathing/init_body()
	paragraphs = list(
		"Человек живёт в узкой полосе. Ниже [WARNING_LOW_PRESSURE] кПа начинается кислородное голодание, ниже [HAZARD_LOW_PRESSURE] кПа - декомпрессия с уроном. Выше [WARNING_HIGH_PRESSURE] кПа давление само по себе начинает давить, а выше [HAZARD_HIGH_PRESSURE] кПа - калечит.",
		"По температуре полоса ещё уже: урон от холода начинается ниже [BODYTEMP_COLD_DAMAGE_LIMIT] К, урон от жара - выше [BODYTEMP_HEAT_DAMAGE_LIMIT] К. Скафандр и внутренние баллоны сдвигают обе границы, но не отменяют их.",
		"Космос это [TCMB] К и ноль давления одновременно. Любой вакуумный отсек убивает двумя способами сразу, и внутренние баллоны без скафандра спасают только от одного из них.",
	)

/datum/atmos_handbook_topic/toxic
	category = ATMOS_HANDBOOK_CATEGORY_SAFETY
	title = "Чем какой газ убивает"
	order = 20

/datum/atmos_handbook_topic/toxic/init_body()
	paragraphs = list(
		"Плазма травит даже в малой доле и вдобавок горит. Миазма разносит болезни. Нитрил разъедает лёгкие, бром и метилбромид - дыхательные пути.",
		"BZ бьёт по мозгу и вызывает галлюцинации, закись азота усыпляет, а в большой доле душит. Нитрий копится в организме как токсин, зато ускоряет; хилий, наоборот, лечит и вводит в целебный сон.",
		"Заукер убивает быстро и почти без шансов - это боевой газ, а не рабочий. В присутствии азота он разваливается сам, поэтому баллон азота в загазованном отсеке работает противоядием.",
		"Отдельная категория - газы, которые не ядовиты, но вытесняют кислород: углекислота, азот, галон, гелий. Отравления нет, задохнуться можно ровно так же.",
	)

/datum/atmos_handbook_topic/fire
	category = ATMOS_HANDBOOK_CATEGORY_SAFETY
	title = "Огонь, взрыв и радиация"
	order = 30

/datum/atmos_handbook_topic/fire/init_body()
	paragraphs = list(
		"Пожар в атмосе это плазма плюс кислород выше [FIRE_MINIMUM_TEMPERATURE_TO_EXIST] К. Он греет смесь, смесь расширяется, давление растёт, и дальше горит уже само. Метан и водород дают то же самое, но объёмным взрывом.",
		"Тритий горит жарче плазмы и вдобавок облучает всё вокруг. Реакция синтеза делает то же самое. Радиационный костюм или расстояние - других вариантов нет.",
		"Тушить можно тремя способами: убрать кислород, убрать тепло, убрать топливо. Галон связывает кислород, фреон и водяной пар отбирают тепло, скруббер и вент на откачку убирают всё сразу.",
		"Гипернобель глушит вообще любые реакции в смеси, включая пожар. Это самое надёжное аварийное средство в игре и самая веская причина держать баллон с ним наготове.",
	)

/datum/atmos_handbook_topic/hot_loop_safety
	category = ATMOS_HANDBOOK_CATEGORY_SAFETY
