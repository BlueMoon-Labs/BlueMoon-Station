/datum/unit_test/netrun_cli_argument_parser/Run()
	var/list/expected = list("rename", "Мой щит.exe", "Новый щит.exe")
	TEST_ASSERT_EQUAL(json_encode(netrun_cli_tokens("rename \"Мой щит.exe\" 'Новый щит.exe'")), json_encode(expected), "All verbs must receive quoted filenames as one decoded argument")
	TEST_ASSERT_EQUAL(json_encode(netrun_cli_tokens("cat my\\ file.txt")), json_encode(list("cat", "my file.txt")), "Escaped spaces must be decoded consistently")
	TEST_ASSERT_EQUAL(json_encode(netrun_cli_tokens("chat \"a \\\"quote\\\"\"")), json_encode(list("chat", "a \"quote\"")), "Escaped quotes must not prematurely terminate an argument")
	TEST_ASSERT_NULL(netrun_cli_tokens("exec \"unfinished"), "Unclosed quotes must reject the entire command")
	TEST_ASSERT_NULL(netrun_cli_tokens("cat trailing\\"), "A trailing escape must not silently truncate the filename")
	TEST_ASSERT_EQUAL(length(netrun_cli_tokens(" \t ")), 0, "Whitespace-only input has no executable verb")

/// Count actual authorization queries on the standalone static-data/completion path.
/datum/netrun_console/cli_projection_fixture
	var/list/network_checks = list()

/datum/netrun_console/cli_projection_fixture/network_level(datum/netrun_network/network, datum/netrun_path_tree/tree)
	network_checks[network.id] = (network_checks[network.id] || 0) + 1
	return ..()

/// Opening several terminals must calculate a LAN's permissions once per viewer,
/// rather than once for every machine on that LAN before the first ui_data pass.
/datum/unit_test/netrun_cli_completion_lan_scaling/Run()
	var/turf/origin = run_loc_floor_bottom_left
	var/datum/netrun_route_scene/scene = allocate(/datum/netrun_route_scene, origin.z)
	var/area/room = scene.room(/area/engineering/netrun_route_test)
	scene.take(origin, room)
	scene.take(get_step(origin, NORTH), room)
	scene.machine(/obj/machinery/power/apc, get_step(origin, NORTH))
	var/obj/machinery/computer/netrun_terminal/terminal = scene.machine(/obj/machinery/computer/netrun_terminal, origin)
	var/datum/component/netrun_node/source = terminal.GetComponent(/datum/component/netrun_node)
	for(var/index in 1 to 16)
		var/obj/item/endpoint = allocate(/obj/item, origin)
		endpoint.AddComponent(/datum/component/netrun_node, NETRUN_NODE_TERMINAL)
	var/datum/netrun_topology/graph = SSnetrun.ensure_topology()
	for(var/index in 1 to 4)
		var/datum/netrun_console/cli_projection_fixture/console = allocate(/datum/netrun_console/cli_projection_fixture, terminal)
		console.connection.wireless = FALSE
		var/list/addresses = console.cli_completion_values("nodes")
		TEST_ASSERT(length(addresses) >= 18, "Each viewer must still receive every permitted endpoint and its APC")
		TEST_ASSERT_EQUAL(console.network_checks[source.network.id], 1, "Completion must resolve one authorization level per LAN, independent of its endpoint population")
		var/list/networks = console.cli_completion_values("networks")
		TEST_ASSERT(source.network.code in networks, "The same projection must provide its network completion code")
		TEST_ASSERT_EQUAL(console.network_checks[source.network.id], 1, "Shared verb pools must reuse the same per-viewer projection")
		TEST_ASSERT_NULL(console.ui_routes, "A standalone completion query must release its transient route reference")
		TEST_ASSERT(!QDELETED(graph.route_tables[source.address]), "Completion teardown must preserve the shared routing table for subsequent viewers")

/datum/unit_test/netrun_cli_renamed_daemon/Run()
	var/obj/item/host = allocate(/obj/item)
	var/datum/netrun_console/console = allocate(/datum/netrun_console, host)
	var/datum/netrun_file/file = netrun_daemon_file("buffer")
	console.store_file(file)
	TEST_ASSERT_EQUAL(console.daemon_bonus("buffer"), 1, "The original file must provide its real passive effect")
	console.cli("rename buffer.exe \"Мой буфер.exe\"")
	TEST_ASSERT_EQUAL(file.name, "Мой буфер.exe", "The terminal must rename the actual disk file")
	TEST_ASSERT_EQUAL(file.content, "buffer", "Renaming must not mutate the stable effect identity")
	TEST_ASSERT_EQUAL(console.daemon_bonus("buffer"), 1, "A renamed daemon must retain its passive effect")
	TEST_ASSERT_NULL(console.cli_file("buffer.exe"), "The obsolete original filename must not remain a hidden executable alias")
	TEST_ASSERT_EQUAL(console.cli_file("Мой буфер.exe"), file, "The current filename must resolve the actual file")
	TEST_ASSERT(console.cli_execute_file("Мой буфер.exe"), "The current daemon filename must be callable without pretending to toggle its passive effect")
	TEST_ASSERT_EQUAL(SSnetrun.get_daemon("buffer").name, "buffer.exe", "A renamed file must not mutate the shared daemon catalog")
	var/list/completions = console.cli_file_completions()
	TEST_ASSERT(("Мой буфер.exe" in completions) && !("buffer.exe" in completions), "Completion must advertise actual filenames rather than stale definitions")

/datum/unit_test/netrun_cli_duplicate_file_names/Run()
	var/obj/item/host = allocate(/obj/item)
	var/datum/netrun_console/console = allocate(/datum/netrun_console, host)
	var/obj/item/netrun_shard/shard = allocate(/obj/item/netrun_shard)
	console.inventory.set_shard(shard)
	var/datum/netrun_file/local_file = new("same.txt", NETRUN_FILE_TEXT, "local")
	var/datum/netrun_file/shard_file = new("same.txt", NETRUN_FILE_TEXT, "shard")
	console.store_file(local_file)
	console.store_file(shard_file, TRUE)
	TEST_ASSERT_NULL(console.cli_file("same.txt"), "Duplicate names must not silently choose the first disk")
	TEST_ASSERT_EQUAL(console.cli_file("local:same.txt"), local_file, "A scoped filename must resolve only its named disk")
	TEST_ASSERT_EQUAL(console.cli_file("shard:same.txt"), shard_file, "A shard scope must select the actual removable file")
	TEST_ASSERT_EQUAL(console.cli_file("#[shard_file.uid]"), shard_file, "A UID must address a duplicate without ambiguity")
	console.inventory.set_shard(null)
	TEST_ASSERT_NULL(console.cli_file("#[shard_file.uid]"), "An ejected shard's UID must stop resolving immediately")
	TEST_ASSERT_EQUAL(console.cli_file("same.txt"), local_file, "Removing a duplicate disk must restore unambiguous name resolution")

/datum/unit_test/netrun_cli_file_operations/Run()
	var/obj/item/host = allocate(/obj/item)
	var/datum/netrun_console/console = allocate(/datum/netrun_console, host)
	var/datum/netrun_file/file = new("old.txt", NETRUN_FILE_TEXT, "hello from disk")
	console.store_file(file)
	var/revision = console.inventory.local_store.revision
	console.cli("rename old.txt \"new file.txt\"")
	TEST_ASSERT(console.inventory.local_store.revision > revision, "CLI renaming must invalidate the same storage projections as the graphical editor")
	console.cli("cat \"new file.txt\"")
	TEST_ASSERT_EQUAL(console.inventory.selected_file_uid, file.uid, "Reading a named file must also select its graphical preview")
	var/list/line = console.log[length(console.log)]
	TEST_ASSERT_EQUAL(line["text"], "hello from disk", "cat must display the actual text in terminal output")
	console.cli("rm \"unterminated")
	TEST_ASSERT(!QDELETED(file), "A malformed command must not perform a partial delete")
	console.cli("rm \"new file.txt\"")
	TEST_ASSERT(QDELETED(file), "rm must operate on the decoded current filename")

/datum/unit_test/netrun_cli_transfers/Run()
	var/obj/item/host = allocate(/obj/item)
	var/datum/netrun_console/console = allocate(/datum/netrun_console, host)
	var/obj/item/netrun_shard/shard = allocate(/obj/item/netrun_shard)
	console.inventory.set_shard(shard)
	var/datum/netrun_file/file = new("notes.txt", NETRUN_FILE_TEXT, "owned")
	console.store_file(file)
	console.cli("mv notes.txt shard")
	TEST_ASSERT_EQUAL(console.inventory.store_for(file), shard.file_store, "mv must transfer actual ownership to the removable disk")
	TEST_ASSERT_EQUAL(console.cli_file("#[file.uid]"), file, "A move must preserve UID-based invocation")
	console.cli("cp notes.txt local")
	TEST_ASSERT_EQUAL(length(console.inventory.local_store.files), 1, "cp must create one independent local copy")
	TEST_ASSERT_EQUAL(console.inventory.store_for(file), shard.file_store, "Copying must leave the original on its disk")
	var/datum/netrun_file/copied = console.inventory.local_store.files[1]
	TEST_ASSERT(copied.uid != file.uid, "A copy must not impersonate the original executable identity")

/datum/unit_test/netrun_cli_program_rename_identity/Run()
	netrun_connected_test_area()
	var/obj/item/host = allocate(/obj/item, run_loc_floor_bottom_left)
	var/datum/component/netrun_node/node = host.AddComponent(/datum/component/netrun_node, NETRUN_NODE_TERMINAL)
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, node)
	var/datum/netrun_console/console = entity.console
	var/datum/netrun_file/file = netrun_program_file("patch")
	console.store_file(file)
	console.rename_local_file(file, "Ремонт.exe")
	var/list/programs = console.combat_programs()
	var/list/entry
	for(var/list/candidate as anything in programs)
		if(candidate["uid"] == file.uid)
			entry = candidate
	TEST_ASSERT_EQUAL(entry?["name"], file.name, "The combat UI must use the same current filename as CLI invocation")
	entity.integrity = 40
	TEST_ASSERT(console.cli_execute_file(file.name), "A renamed executable must launch by its actual filename")
	TEST_ASSERT_EQUAL(entity.integrity, 70, "Renaming must preserve the executable's real repair behavior")
	console.rename_local_file(file, "Ещё ремонт.exe")
	console.combat_context.next_program = 0
	TEST_ASSERT(!console.cli_execute_file(file.name), "Renaming must never reset the stable definition's cooldown")
	TEST_ASSERT_EQUAL(entity.integrity, 70, "A renamed file may not bypass cooldown to apply another effect")
	TEST_ASSERT_NULL(console.cli_file("patch.exe"), "The program definition name must not survive as a hidden alias")

/datum/unit_test/netrun_cli_cosmetic_commands/Run()
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity)
	var/datum/netrun_console/console = entity.console
	console.operator = entity
	console.cli("theme phosphor")
	TEST_ASSERT_EQUAL(console.theme_id(), "phosphor", "CLI theme selection must use the ordinary validated cosmetic API")
	console.cli("profile avatar ghost")
	TEST_ASSERT_EQUAL(entity.get_persona().avatar, "ghost", "The process must be able to choose its own avatar from the terminal")
	console.cli("profile tagline \"A quiet signal\"")
	TEST_ASSERT_EQUAL(entity.get_persona().tagline, "A quiet signal", "A quoted profile field must preserve spaces")
	console.cli("profile avatar arbitrary-url")
	TEST_ASSERT_EQUAL(entity.get_persona().avatar, "ghost", "Invalid CLI cosmetics must retain the same curated validation as the graphical panel")

/datum/unit_test/netrun_cli_numeric_filename_collision/Run()
	var/obj/item/host = allocate(/obj/item)
	var/datum/netrun_console/console = allocate(/datum/netrun_console, host)
	var/datum/netrun_file/original = new("original.txt", NETRUN_FILE_TEXT, "original")
	var/datum/netrun_file/numeric = new("[original.uid]", NETRUN_FILE_TEXT, "numeric filename")
	console.store_file(original)
	console.store_file(numeric)
	TEST_ASSERT_EQUAL(console.cli_file(original.uid), numeric, "A numeric current filename must win over another file's legacy unprefixed UID")
	TEST_ASSERT_EQUAL(console.cli_file("#[original.uid]"), original, "The explicit UID namespace must still address the original file")
	console.cli("cat \"[original.uid]\"")
	TEST_ASSERT_EQUAL(console.inventory.selected_file_uid, numeric.uid, "Quoted numeric filenames must select the named disk file")
	console.inventory.selected_file_uid = null
	console.cli("cat [original.uid]")
	TEST_ASSERT_EQUAL(console.inventory.selected_file_uid, numeric.uid, "Quoted and unquoted numeric filenames must resolve identically")
	console.cli("rm \"[original.uid]\"")
	TEST_ASSERT(QDELETED(numeric) && !QDELETED(original), "Removing a numeric filename must not delete the different file whose UID happens to match")
	TEST_ASSERT_EQUAL(console.cli_file(original.uid), original, "Legacy bare UIDs remain usable only when no current filename matches")
