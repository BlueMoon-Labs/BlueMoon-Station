	TEST_ASSERT_EQUAL(owner.console.find_local_file(full.uid), full, "Failed launch restores the same original template UID")
	TEST_ASSERT_EQUAL(full.stored_files[1], cargo, "Preflight preserves the original packed file datums before restore can move them")
	TEST_ASSERT_EQUAL(full.size, original_size, "Failed launch preserves the source file's charged size")
	TEST_ASSERT(!QDELETED(cargo), "Capacity failure never destroys recalled cargo")

