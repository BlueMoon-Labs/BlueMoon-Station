	var/datum/netrun_file/acquired_key/removable = shard.file_store.insert(foreign.copy())
	sender.console.record_breach_grant("node", scene.node_b.address, NETRUN_ACCESS_ROOT)
	var/datum/netrun_file/acquired_key/legacy_duplicate = foreign.copy()
	// Simulate a legacy disk written before the aggregation contract existed.
	shard.file_store.files += legacy_duplicate
	owner.console.inventory.set_shard(shard)
	TEST_ASSERT(QDELETED(legacy_duplicate), "Mount consolidates legacy duplicates within the physical shard")
	TEST_ASSERT_EQUAL(length(shard.file_store.files), 1, "The mounted shard has one aggregate")
	TEST_ASSERT_EQUAL(shard.file_store.files[1], removable, "The shard preserves its own established canonical UID")
	TEST_ASSERT_EQUAL(owner.console.inventory.local_store.find_file(local.uid), local, "Mount does not move or consume the separate local key")
	TEST_ASSERT_EQUAL(local.node_level(scene.node_b), NETRUN_ACCESS_USER, "Mounted ROOT does not silently rewrite the local copy")
	TEST_ASSERT_EQUAL(removable.node_level(scene.node_b), NETRUN_ACCESS_ROOT, "The removable medium owns its independent merged scopes")
	var/mob/camera/netrun_entity/resident = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	TEST_ASSERT(resident.console.inventory.borrow_from(owner.console.inventory), "A neural-style second inventory may observe the same physical disk")
	var/revision_before = owner.console.inventory.local_store.revision
	var/datum/netrun_file/acquired_key/received = owner.console.store_file(foreign.copy())
	TEST_ASSERT_EQUAL(received, local, "A shared disk merges once into its existing local canonical")
	TEST_ASSERT_EQUAL(owner.console.inventory.local_store.revision, revision_before + 1, "One insertion publishes one finite physical storage fact")
	TEST_ASSERT_EQUAL(resident.console.inventory.find_file(local.uid), local, "The borrowed view follows the same surviving datum")
	TEST_ASSERT_EQUAL(local.node_level(scene.node_b), NETRUN_ACCESS_ROOT, "Both observers see the valid stronger imported scope")
	shard.file_store.capacity = shard.file_store.used()
	var/datum/netrun_file/acquired_key/copied = owner.console.inventory.local_store.transfer_to(shard.file_store, local)
	TEST_ASSERT_EQUAL(copied, removable, "Copy to an occupied shard returns that medium's aggregate")
	TEST_ASSERT_EQUAL(owner.console.inventory.local_store.find_file(local.uid), local, "Copy to shard leaves the source canonical intact")
	var/datum/netrun_file/acquired_key/imported = owner.console.inventory.import_from_shard(removable.uid, TRUE)
	TEST_ASSERT_EQUAL(imported, local, "Moving a shard key into existing local memory returns the surviving local aggregate")
	TEST_ASSERT_EQUAL(owner.console.inventory.selected_file_uid, local.uid, "Import selection follows the returned canonical UID")
	TEST_ASSERT(QDELETED(removable) && !length(shard.file_store.files), "The moved incoming source is consumed without a dangling disk entry")
	removable = owner.console.inventory.local_store.transfer_to(shard.file_store, local)
	TEST_ASSERT(removable && removable != local, "A fresh portable copy can be created on the now-empty shard")
	shard.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT_EQUAL(shard.file_store.find_file(removable.uid), removable, "The portable copy leaves with the real shard")
	TEST_ASSERT_NULL(owner.console.inventory.shard, "The owner immediately loses the detached media")
	TEST_ASSERT_NULL(resident.console.inventory.shard, "The borrowed view receives the same actual detach fact")
