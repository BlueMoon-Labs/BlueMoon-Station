	TEST_ASSERT_EQUAL(owner.console.node_level(scene.node_b), NETRUN_ACCESS_ROOT, "The master's independent original retains its own rights")
	var/datum/netrun_file/bot/full = netrun_bot_file(NETRUN_BOT_SENTINEL)
	var/datum/netrun_file/cargo = new("packed.txt", NETRUN_FILE_TEXT, "original packed cargo", SSnetrun.get_bot_program(NETRUN_BOT_SENTINEL).storage)
	full.stored_files = list(cargo)
	full.size += cargo.size
	var/original_size = full.size
	TEST_ASSERT(owner.console.store_file(full), "The owner has enough actual disk capacity for the packed template")
