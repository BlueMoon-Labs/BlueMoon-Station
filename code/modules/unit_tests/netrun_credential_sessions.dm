	entity.console.inventory.local_store.capacity = entity.console.inventory.local_store.used()
	TEST_ASSERT(!entity.console.start_breach("network", scene.node_b.network.id, TRUE), "A full disk rejects a new hack before starting a reward that cannot be stored")
	TEST_ASSERT_NULL(entity.console.intrusion.breach, "Failed metadata reservation creates no hidden work")
	TEST_ASSERT_NULL(entity.console.canonical_acquired_key(), "Reservation never overfills or preloads a free key")
	entity.console.inventory.local_store.capacity++
	TEST_ASSERT(entity.console.start_breach("network", scene.node_b.network.id, TRUE), "Exactly one metadata cell admits the first hack")
	var/datum/netrun_breach/automatic/breach = entity.console.intrusion.breach
	breach.deadline = world.time
	breach.finish()
	var/datum/netrun_file/acquired_key/key = entity.console.canonical_acquired_key()
	TEST_ASSERT_EQUAL(key.size, 1, "The accumulator is a fixed-size real metadata file")
	var/obj/item/netrun_shard/shard = allocate(/obj/item/netrun_shard)
	shard.forceMove(entity)
	entity.console.inventory.set_shard(shard)
	TEST_ASSERT(entity.console.inventory.local_store.transfer_to(shard.file_store, key, TRUE), "The same authority file can move onto the owner's actual attached shard")
	TEST_ASSERT_EQUAL(entity.console.canonical_acquired_key(), key, "Canonical lookup follows current owned shard membership")
	TEST_ASSERT(entity.console.start_breach("node", scene.node_b.address, TRUE), "The next hack reuses the mounted file without another metadata slot")
	breach = entity.console.intrusion.breach
	breach.deadline = world.time
	breach.finish()
	TEST_ASSERT_EQUAL(key.node_level(scene.node_b), NETRUN_ACCESS_USER, "New rewards update the same real file on its current disk")
	shard.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT_NULL(entity.console.canonical_acquired_key(), "An unmounted file is no longer this session's accumulator")
	TEST_ASSERT(entity.console.node_level(scene.node_b) < NETRUN_ACCESS_USER, "Removing the disk revokes the native reward without a shadow grant")
	TEST_ASSERT(!entity.console.access_session.node_access[scene.node_b.address], "Native node access was never copied into direct tables")
	TEST_ASSERT(entity.console.start_breach("node", scene.node_b.address, TRUE), "The freed local metadata cell may reserve a fresh accumulator")
	breach = entity.console.intrusion.breach
	var/datum/netrun_file/acquired_key/reserved = entity.console.canonical_acquired_key()
	entity.console.delete_local_file(reserved)
	TEST_ASSERT(entity.console.store_file(new /datum/netrun_file("occupied.txt", NETRUN_FILE_TEXT, "occupied", 1)), "Another file may consume the removed reservation before completion")
	breach.deadline = world.time
	breach.finish()
	TEST_ASSERT(entity.console.node_level(scene.node_b) < NETRUN_ACCESS_USER, "Completion reports storage failure instead of granting invisible access")
	TEST_ASSERT_NULL(entity.console.canonical_acquired_key(), "A full disk after source removal creates no preloaded fallback")
	TEST_ASSERT(entity.console.inventory.local_store.used() <= entity.console.inventory.local_store.capacity, "Every failure preserves the actual memory limit")

/// Launched agents receive one removable scoped snapshot; failed launch preserves packed cargo.
/datum/unit_test/netrun_acquired_key_agent_snapshot/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
