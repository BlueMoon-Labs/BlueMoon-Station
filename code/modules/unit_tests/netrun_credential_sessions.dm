/// Receiving into an occupied medium keeps its UID and consumes only the new copy.
/datum/unit_test/netrun_acquired_key_automatic_merge/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/receiver = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/sender = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	receiver.console.record_breach_grant("node", scene.node_b.address, NETRUN_ACCESS_USER)
	sender.console.record_breach_grant("node", scene.node_b.address, NETRUN_ACCESS_ROOT)
	sender.console.record_breach_grant("network", scene.node_b.network.id, NETRUN_ACCESS_GUEST)
	var/datum/netrun_file/acquired_key/canonical = receiver.console.canonical_acquired_key()
	var/datum/netrun_file/acquired_key/original = sender.console.canonical_acquired_key()
	canonical.name = "stable-name.grants"
	var/original_uid = canonical.uid
	receiver.console.inventory.local_store.capacity = receiver.console.inventory.local_store.used()
	var/datum/netrun_file/acquired_key/result = sender.console.inventory.local_store.transfer_to(receiver.console.inventory.local_store, original)
	TEST_ASSERT_EQUAL(result, canonical, "Copy transfer returns the surviving aggregate, not the consumed copy")
	TEST_ASSERT_EQUAL(canonical.uid, original_uid, "The destination preserves its stable canonical UID")
	TEST_ASSERT_EQUAL(canonical.name, "stable-name.grants", "Import does not rename the established destination")
	TEST_ASSERT_EQUAL(length(receiver.console.inventory.get_acquired_keys()), 1, "One medium owns exactly one aggregate")
	TEST_ASSERT_EQUAL(canonical.node_level(scene.node_b), NETRUN_ACCESS_ROOT, "The stronger valid node scope is merged")
	TEST_ASSERT_EQUAL(canonical.network_level(scene.node_b.network), NETRUN_ACCESS_GUEST, "A distinct gateway scope is merged into the same file")
	TEST_ASSERT_EQUAL(sender.console.find_local_file(original.uid), original, "Copying leaves the sender's real original intact")
	TEST_ASSERT_EQUAL(receiver.console.inventory.local_store.used(), receiver.console.inventory.local_store.capacity, "Merging needs no extra metadata slot on a full disk")
	var/datum/netrun_file/acquired_key/merge_probe/stale = new("stale.grants")
	stale.merge_from(original)
	scene.node_b.raise_firewall()
	receiver.console.access_session.process_events()
	receiver.console.record_breach_grant("node", scene.node_b.address, NETRUN_ACCESS_USER)
	TEST_ASSERT_EQUAL(receiver.console.store_file(stale), canonical, "Ordinary insertion also retargets to the existing aggregate")
	TEST_ASSERT(QDELETED(stale) && stale.destroy_count == 1, "Only the consumed incoming owned datum is destroyed exactly once")
	TEST_ASSERT_EQUAL(canonical.node_level(scene.node_b), NETRUN_ACCESS_USER, "An invalid old ROOT scope cannot overwrite a newly reacquired USER scope")
	var/datum/netrun_file/acquired_key/exported = receiver.console.snapshot_acquired_key("snapshot.grants")
	TEST_ASSERT_EQUAL(exported.node_level(scene.node_b), NETRUN_ACCESS_USER, "Explicit snapshots cannot renew a stale imported epoch")
	qdel(exported)
	var/datum/netrun_file_store/readonly = allocate(/datum/netrun_file_store, allocate(/obj/item), 0)
	TEST_ASSERT(readonly.insert(canonical.copy(), TRUE), "An authored read-only disk may explicitly preload one key")
	var/datum/netrun_file/acquired_key/rejected = canonical.copy()
	TEST_ASSERT(!readonly.can_fit(rejected), "An existing preloaded key does not make a zero-capacity disk writable")
	TEST_ASSERT_NULL(readonly.insert(rejected), "Automatic merging still respects the explicit read-only boundary")
	TEST_ASSERT(!QDELETED(rejected) && length(readonly.files) == 1, "Rejected insertion preserves caller ownership and the original preload")
	qdel(rejected)
	var/datum/netrun_file/access/first_id = new("medical.access", list(ACCESS_MEDICAL))
	var/datum/netrun_file/access/second_id = new("science.access", list(ACCESS_RD))
	receiver.console.inventory.local_store.capacity += first_id.size + second_id.size
	TEST_ASSERT_EQUAL(receiver.console.store_file(first_id), first_id, "Plain stolen ID files are not acquired-key merge candidates")
	TEST_ASSERT_EQUAL(receiver.console.store_file(second_id), second_id, "Another station ID source remains a separate ordinary file")

