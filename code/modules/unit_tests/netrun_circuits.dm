/// Native card-reader credentials authorize automation; a LAN key alone does not.
/datum/unit_test/netrun_circuit_native_id_access/Run()
	var/datum/netrun_route_scene/scene = netrun_connected_test_area()
	var/obj/machinery/power/apc/apc = locate() in scene.owned
	var/datum/component/netrun_node/node = apc.GetComponent(/datum/component/netrun_node)
	var/obj/item/electronic_assembly/assembly = allocate(/obj/item/electronic_assembly, run_loc_floor_bottom_left)
	var/obj/item/integrated_circuit/input/netrun_link/chip = allocate(/obj/item/integrated_circuit/input/netrun_link)
	var/obj/item/integrated_circuit/input/card_reader/reader = allocate(/obj/item/integrated_circuit/input/card_reader)
	assembly.add_component(chip)
	assembly.add_component(reader)
	SSnetrun.ensure_topology()
	TEST_ASSERT(chip.console.store_file(new /datum/netrun_file("local.key", NETRUN_FILE_KEY, node.network.passcode, 1, node.network.id)), "A real LAN key must fit in the circuit bridge")
	TEST_ASSERT(chip.console.can_route(node), "The installed bridge must have a physical route through the actual nearest APC")
	TEST_ASSERT_EQUAL(chip.console.legit_node_level(node), NETRUN_ACCESS_GUEST, "A key must grant only GUEST to circuit automation")
	var/initial_lighting = apc.lighting
	TEST_ASSERT(!chip.console.run_command(node, "apc_lighting"), "A key alone must not authorize the APC's USER command")
	TEST_ASSERT_EQUAL(apc.lighting, initial_lighting, "Rejected automation must leave the actual APC channel unchanged")
	var/obj/item/card/id/card = allocate(/obj/item/card/id)
	card.access = list(ACCESS_ENGINE_EQUIP)
	TEST_ASSERT(reader.attackby_react(card, null, INTENT_HELP), "The native ID reader must accept the real engineering ID")
	TEST_ASSERT(ACCESS_ENGINE_EQUIP in chip.console.user_access(TRUE), "Automation must read the assembly's native scanned ID accesses")
	var/list/access_copy = chip.console.user_access(TRUE)
	access_copy += ACCESS_NETWORK
	TEST_ASSERT(!(ACCESS_NETWORK in assembly.access_card.GetAccess()), "A caller must not mutate the assembly's native credentials through the returned list")
	TEST_ASSERT_EQUAL(chip.console.legit_node_level(node), NETRUN_ACCESS_USER, "The scanned matching access must authorize USER without granting ROOT")
	TEST_ASSERT(chip.console.run_command(node, "apc_lighting"), "The actual scanned ID must admit legal automation")
	var/datum/netrun_request/command/packet = netrun_operation_packet(chip.console, /datum/netrun_request/command)
	TEST_ASSERT(packet && packet.deliver(), "Admitted automation must execute through the budgeted packet boundary")
	TEST_ASSERT_NOTEQUAL(apc.lighting, initial_lighting, "Authorized automation must change the real APC channel")
	TEST_ASSERT_EQUAL(chip.console.intrusion.trace, 0, "Legal circuit automation must not accumulate intrusion trace")
	assembly.remove_component(chip)
	TEST_ASSERT_EQUAL(length(chip.console.user_access(TRUE)), 0, "Removing the bridge must revoke its access to assembly credentials")
	TEST_ASSERT(!chip.console.run_command(node, "apc_lighting"), "A detached bridge must not keep the previous assembly's USER authorization")
	assembly.add_component(chip)
	assembly.access_card.access.Cut()
	TEST_ASSERT_EQUAL(chip.console.legit_node_level(node), NETRUN_ACCESS_GUEST, "Clearing the native stored ID accesses must immediately leave only the LAN key's GUEST rights")
	TEST_ASSERT(!chip.console.run_command(node, "apc_lighting"), "Cleared native credentials must revoke machine commands without removing the LAN key")
