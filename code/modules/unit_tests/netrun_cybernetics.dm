/// Synthetic organs are not radios; only an installed uplink exposes their shared bus.
/datum/unit_test/netrun_cyber_uplink_lifecycle/Run()
	allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	var/obj/item/organ/heart/cybernetic/heart = allocate(/obj/item/organ/heart/cybernetic)
	heart.Insert(user)
	TEST_ASSERT_NULL(user.GetComponent(/datum/component/netrun_node), "A standalone artificial organ cannot expose a wireless endpoint")
	TEST_ASSERT(!user.netrun_network_enabled(), "An owner without a real uplink has no cybernetics connection")
	var/obj/item/organ/cyberimp/brain/netlink/uplink = allocate(/obj/item/organ/cyberimp/brain/netlink)
	uplink.Insert(user)
	var/datum/component/netrun_node/bus = user.GetComponent(/datum/component/netrun_node)
	TEST_ASSERT_NOTNULL(bus, "An installed uplink exposes its linked internal bus")
	TEST_ASSERT("heart_stop@heart" in bus.all_command_ids(), "Only connected organs contribute their actual addressed commands")
	TEST_ASSERT("probe_location" in bus.all_command_ids(), "The aggregate bus retains the ordinary probe command")
	var/datum/component/netrun_cyber_guard/defense = user.GetComponent(/datum/component/netrun_cyber_guard)
	TEST_ASSERT_NOTNULL(defense?.guard, "The addressable bus starts with its own local defender")
	TEST_ASSERT(!defense.guard.drops_loot, "Owner-reprovisioned cyber guards cannot farm combat loot through reconnect")
	var/datum/component/netrun_cyber_guard/uplink_defense = uplink.GetComponent(/datum/component/netrun_cyber_guard)
	TEST_ASSERT_NOTNULL(uplink_defense?.guard, "The separate uplink endpoint also owns its own defender")
	var/obj/effect/netrun_endpoint/neural/display = user.netrun_cyber_neural_endpoint()
	TEST_ASSERT_NOTNULL(display, "The real installed uplink exposes its native display binding")
	var/datum/component/netrun_node/display_node = display.GetComponent(/datum/component/netrun_node)
	var/datum/component/netrun_cyber_guard/display_defense = display.GetComponent(/datum/component/netrun_cyber_guard)
	TEST_ASSERT_NOTNULL(display_defense?.guard, "The associated neural display owns a third local defender")
	var/address = bus.address
	var/datum/netrun_ice/old_guard = defense.guard
	qdel(old_guard)
	user.netrun_refresh_cyber_node()
	SSnetrun.raise_defenses(null, bus)
	TEST_ASSERT(QDELETED(defense.guard), "Unrelated organ refresh and illegal activity must not resurrect a destroyed local defender")
	var/datum/netrun_ice/old_display_guard = display_defense.guard
	qdel(old_display_guard)
	user.netrun_next_intrusion_warn = world.time
	var/datum/netrun_incident/incident = SSnetrun.report_incident("breach", display_node, null, NETRUN_INCIDENT_MEDIUM, "Neural display breach")
	TEST_ASSERT(user.netrun_next_intrusion_warn > world.time, "A breach of the display forwards an immediate warning to its physical owner")
	SSnetrun.raise_defenses(null, display_node)
	user.netrun_refresh_cyber_node()
	TEST_ASSERT(QDELETED(display_defense.guard), "Display activity and refresh cannot regenerate its destroyed defender")
	TEST_ASSERT(user.set_netrun_cyber_connected(FALSE), "The physical owner can disconnect its own interface")
	TEST_ASSERT_EQUAL(user.GetComponent(/datum/component/netrun_node), bus, "Manual disconnect retains the address and memory")
	TEST_ASSERT(!bus.is_online() && !uplink.netrun_online(), "Both addresses reject remote network use while disconnected")
	TEST_ASSERT(!display_node.is_online(), "The associated display also disconnects from the same physical uplink")
	TEST_ASSERT(QDELETED(uplink_defense.guard), "Disconnect releases the uplink's active defender")
	TEST_ASSERT(user.set_netrun_cyber_connected(TRUE), "An explicit reconnect is accepted")
	TEST_ASSERT(!QDELETED(defense.guard) && defense.guard != old_guard, "Only explicit reconnect provisions a replacement defender")
	TEST_ASSERT(!QDELETED(display_defense.guard) && display_defense.guard != old_display_guard, "Explicit reconnect also rearms the display's owned defender")
	incident.close("fixture complete")
	uplink.Remove()
	TEST_ASSERT_NULL(user.GetComponent(/datum/component/netrun_node), "Removing the last physical uplink removes the shared bus")
	TEST_ASSERT_NULL(SSnetrun.find_node(address), "The removed bus leaves no address registry entry")
	TEST_ASSERT(QDELETED(defense) && QDELETED(uplink_defense), "Removing the physical uplink releases both guard lifecycles")
	TEST_ASSERT(QDELETED(display_defense), "Removing the display/uplink also releases its third guard lifecycle")
	TEST_ASSERT(!QDELETED(heart), "Disconnecting networking does not destroy a working synthetic organ")

/// Destructive organ control requires ROOT and rechecks physical connectivity at delivery.
/datum/unit_test/netrun_cyber_critical_authority/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	var/obj/item/organ/heart/cybernetic/heart = allocate(/obj/item/organ/heart/cybernetic)
	heart.Insert(user)
	var/obj/item/organ/cyberimp/brain/netlink/uplink = allocate(/obj/item/organ/cyberimp/brain/netlink)
	uplink.Insert(user)
	var/datum/component/netrun_node/bus = user.GetComponent(/datum/component/netrun_node)
	var/mob/camera/netrun_entity/attacker = allocate(/mob/camera/netrun_entity)
	attacker.enter_node(scene.node_a)
	attacker.console.access_session.node_access[bus.address] = NETRUN_ACCESS_USER
	TEST_ASSERT(!attacker.console.run_command(bus, "heart_stop@heart"), "USER cannot admit a critical organ shutdown")
	TEST_ASSERT(heart.beating, "A rejected ROOT operation cannot affect the actual heart")
	attacker.console.access_session.node_access[bus.address] = NETRUN_ACCESS_ROOT
	attacker.console.next_command = world.time
	TEST_ASSERT(attacker.console.run_command(bus, "heart_stop@heart"), "Acquired ROOT may admit the ordinary addressed command")
	var/datum/netrun_request/command/packet = netrun_operation_packet(attacker.console, /datum/netrun_request/command)
	TEST_ASSERT_NOTNULL(packet, "The shutdown must travel as an ordinary command packet")
	user.set_netrun_cyber_connected(FALSE)
	packet.deliver()
	TEST_ASSERT(heart.beating, "Disconnect before arrival prevents the native shutdown from executing")

/datum/unit_test/proc/netrun_security_packet(datum/netrun_machine_service/source, datum/netrun_machine_service/target, operation)
	for(var/datum/netrun_machine_packet/data/packet as anything in SSnetrun.get_machine_transport().packets)
		if(istype(packet) && packet.source == source && packet.recipient == target && packet.message.payload["operation"] == operation)
			return packet
	return null

/// Subscription and alerts are real routed deliveries; neither mutates its peer on admission.
/datum/unit_test/netrun_cyber_security_subscription/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	var/obj/item/organ/cyberimp/brain/netlink/uplink = allocate(/obj/item/organ/cyberimp/brain/netlink)
	uplink.Insert(user)
	var/mob/camera/netrun_entity/bot/police = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_a, NETRUN_BOT_POLICE)
	var/datum/netrun_machine_service/security_events/publisher = user.get_netrun_machine_service("security.events")
	var/datum/netrun_machine_service/security_monitor/monitor = police.get_netrun_machine_service("security.monitor")
	var/datum/netrun_machine_transport/transport = SSnetrun.get_machine_transport()
	var/deadline = world.time + 5 SECONDS
	while(!transport.is_ready() && world.time < deadline)
		sleep(world.tick_lag)
	TEST_ASSERT(transport.is_ready(), "Subscription requires the ordinary native routing readiness barrier")
	publisher.subscribers.Cut()
	// Quiet sources must admit replacements even when all32 old entries have
	// become stale or lost their native monitoring role since subscribing.
	for(var/index in 1 to 32)
		var/obj/item/retired_host = allocate(/obj/item)
		var/datum/netrun_machine_service/security_monitor/retired = allocate(/datum/netrun_machine_service/security_monitor, scene.node_a, retired_host)
		publisher.subscribers[retired.service_key()] = WEAKREF(retired)
		if(index <= 16)
			qdel(retired)
	TEST_ASSERT(monitor.send_to(publisher, new /datum/netrun_machine_message(list("operation" = "subscribe"))), "A real police monitor admits a subscription request")
	TEST_ASSERT_EQUAL(length(publisher.subscribers), 32, "Admission does not prune or subscribe before delivery")
	var/datum/netrun_machine_packet/data/subscribe = netrun_security_packet(monitor, publisher, "subscribe")
	TEST_ASSERT_NOTNULL(subscribe, "The subscribe control is an actual machine packet")
	subscribe.deliver()
	TEST_ASSERT_EQUAL(length(publisher.subscribers), 1, "Delivered subscribe prunes32 retired/unauthorized entries before enforcing the subscriber cap")
	var/datum/component/netrun_node/bus = user.GetComponent(/datum/component/netrun_node)
	var/received_before = length(monitor.alerts)
	var/datum/netrun_incident/incident = SSnetrun.report_incident("breach", bus, null, NETRUN_INCIDENT_MEDIUM, "Cybernetics test breach")
	TEST_ASSERT(user.netrun_next_intrusion_warn > world.time, "The physical owner receives an immediate local intrusion warning")
	TEST_ASSERT_EQUAL(length(monitor.alerts), received_before, "A global incident signal cannot deliver subscription data")
	publisher.publish_slice()
	var/datum/netrun_machine_packet/data/event = netrun_security_packet(publisher, monitor, "event")
	TEST_ASSERT_NOTNULL(event, "Publisher fanout admits an ordinary routed alert packet")
	TEST_ASSERT_EQUAL(length(monitor.alerts), received_before, "Sending an alert does not expose its body before arrival")
	event.deliver()
	TEST_ASSERT_EQUAL(length(monitor.alerts), received_before + 1, "The subscribed observer receives data only at native delivery")
	var/list/received = monitor.alerts[length(monitor.alerts)]
	TEST_ASSERT_EQUAL(received["id"], incident.id, "The delivered alert identifies its authoritative incident")
	TEST_ASSERT(monitor.send_to(publisher, new /datum/netrun_machine_message(list("operation" = "unsubscribe"))), "Unsubscribe travels over the same service contract")
	var/datum/netrun_machine_packet/data/unsubscribe = netrun_security_packet(monitor, publisher, "unsubscribe")
	unsubscribe.deliver()
	TEST_ASSERT_EQUAL(length(publisher.subscribers), 0, "A delivered unsubscribe releases its weak subscription")
	TEST_ASSERT(monitor.send_to(publisher, new /datum/netrun_machine_message(list("operation" = "subscribe"))), "The observer may try to subscribe again")
	subscribe = netrun_security_packet(monitor, publisher, "subscribe")
	user.set_netrun_cyber_connected(FALSE)
	subscribe.deliver()
	TEST_ASSERT_EQUAL(length(publisher.subscribers), 0, "An in-flight subscription cannot cross a disconnected implant")
	incident.close("fixture complete")
	var/monitor_key = monitor.service_key()
	var/monitor_tag = "[monitor.service_id]|[monitor.indexed_tag]"
	qdel(police)
	TEST_ASSERT(QDELETED(monitor), "Deleting a bot releases its service even though its route node belongs to another atom")
	TEST_ASSERT_NULL(transport.services[monitor_key], "The deleted monitor leaves no service-key registration")
	TEST_ASSERT(!(monitor in transport.by_id["security.monitor"]), "The deleted monitor leaves no discovery entry")
	TEST_ASSERT(!(monitor in transport.by_tag[monitor_tag]), "The deleted monitor leaves no stale address index")
