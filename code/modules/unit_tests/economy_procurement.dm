/// Каждый расходник - пак каталога станционного отдела, не СБ и не командования.
/datum/unit_test/economy_staple_packs/Run()
	for(var/pack_type in GLOB.econ_staple_packs)
		var/datum/supply_pack/pack = SSshuttle.supply_packs[pack_type]
		TEST_ASSERT_NOTNULL(pack, "Расходник [pack_type] есть среди паков снабжения")
		var/department_id = econ_pack_catalog_department(pack)
		TEST_ASSERT(department_id && department_id != ACCOUNT_SEC && department_id != ACCOUNT_CMD, "Расходник [pack_type] в каталоге отдела, не СБ: [department_id]")
		TEST_ASSERT(econ_pack_staple(pack), "[pack_type] считается расходником")
	var/datum/economy_department/security = SSeconomy.get_department(ACCOUNT_SEC)
	for(var/datum/supply_pack/pack as anything in security.catalog())
		TEST_ASSERT(!econ_pack_staple(pack), "Пак СБ [pack.type] не расходник")

/datum/unit_test/economy_catalog/proc/staple_of(datum/economy_department/department)
	for(var/datum/supply_pack/pack as anything in department.catalog())
		if(econ_pack_staple(pack) && !econ_pack_unavailable(pack) && econ_pack_price(pack) > SSeconomy.settings.auto_approve_limit)
			return pack

/datum/unit_test/economy_catalog/proc/cheap_staple_of(datum/economy_department/department)
	for(var/datum/supply_pack/pack as anything in department.catalog())
		if(econ_pack_staple(pack) && !econ_pack_unavailable(pack) && econ_pack_price(pack) <= SSeconomy.settings.auto_approve_limit)
			return pack

/// Недорогой расходник при исчерпанном часовом лимите (и при лимите 0) не одобряется ни сразу, ни на тике по сроку ожидания: решает глава, ИИ или снабжение.
/datum/unit_test/economy_catalog/staple_cap_blocks_auto_approve/Run()
	var/datum/economy_department/medical = SSeconomy.get_department(ACCOUNT_MED)
	var/datum/supply_pack/drip = cheap_staple_of(medical)
	TEST_ASSERT_NOTNULL(drip, "В каталоге медицины есть расходник дешевле лимита автоодобрения")
	var/mob/living/carbon/human/doctor = make_staff(ACCOUNT_MED)
	var/datum/bank_account/doctor_account = econ_account_of(doctor)
	var/price = round(econ_pack_price(drip))
	econ_test_set_balance(medical.account, price * 4)
	TEST_ASSERT(!medical.has_approver_on_shift(), "Начальства на смене нет")
	medical.staple_spent["[doctor_account.account_id]"] = list(world.time, SSeconomy.settings.staple_self_order_cap_hour)
	var/datum/econ_request/request = medical.submit_request(drip, doctor, "Капельницы")
	TEST_ASSERT_EQUAL(request.status, ECON_REQUEST_PENDING, "Расходник сверх лимита без начальства сразу не одобрен")
	request.created -= SSeconomy.settings.auto_approve_wait_minutes MINUTES
	medical.approve_stale_requests()
	TEST_ASSERT_EQUAL(request.status, ECON_REQUEST_PENDING, "Расходник сверх лимита не одобрен и по сроку ожидания")
	TEST_ASSERT(findtext(medical.pending_text(drip, doctor, 1), "лимит расходников"), "Подавшему сказано про лимит: [medical.pending_text(drip, doctor, 1)]")
	TEST_ASSERT(!findtext(medical.request_outlook(request), "одобрится сама"), "Окно не обещает автоодобрение: [medical.request_outlook(request)]")
	TEST_ASSERT_NULL(econ_request_department(doctor, drip), "Без решающих расходник сверх лимита с консоли - снабжению")
	var/saved_cap = SSeconomy.settings.staple_self_order_cap_hour
	SSeconomy.settings.staple_self_order_cap_hour = 0
	medical.staple_spent = list()
	var/datum/econ_request/zero = medical.submit_request(drip, doctor, "Ещё")
	medical.approve_stale_requests()
	SSeconomy.settings.staple_self_order_cap_hour = saved_cap
	TEST_ASSERT_EQUAL(zero.status, ECON_REQUEST_PENDING, "При лимите 0 расходник сам не одобряется")
	TEST_ASSERT_EQUAL(length(SSshuttle.shoppinglist), 0, "Заказов нет")

/// Окно бюджета отдела для user: программа без КПК, ответ на действие - из её сообщений.
/datum/unit_test/economy_catalog/proc/budget_press(datum/computer_file/program/department_budget/app, mob/living/user, action, list/params = list())
	app.budget_act(user, action, params)
	return app.messages[REF(user)]

/// Расходник дороже лимита автоодобрения сотрудник заказывает сам при главе на смене, пока хватает часового лимита; сверх лимита - обычная заявка; без денег ждёт и закажется сам на тике.
/datum/unit_test/economy_catalog/staple_self_order/Run()
	var/datum/economy_department/engineering = SSeconomy.get_department(ACCOUNT_ENG)
	var/datum/supply_pack/glass = staple_of(engineering)
	TEST_ASSERT_NOTNULL(glass, "В каталоге инженерии есть расходник дороже лимита автоодобрения")
	var/mob/living/carbon/human/engineer = make_staff(ACCOUNT_ENG)
	var/mob/living/carbon/human/chief = make_with_job(/datum/job/chief_engineer)
	on_shift(chief)
	TEST_ASSERT(engineering.has_approver_on_shift(), "Глава на смене")
	var/price = round(econ_pack_price(glass))
	econ_test_set_balance(engineering.account, price * 3)
	var/datum/bank_account/engineer_account = econ_account_of(engineer)
	var/cap = SSeconomy.settings.staple_self_order_cap_hour
	TEST_ASSERT(cap >= price, "Лимит расходников за час не меньше цены пака")
	var/datum/econ_request/first = engineering.submit_request(glass, engineer, "Окна")
	TEST_ASSERT_EQUAL(first.status, ECON_REQUEST_APPROVED, "Расходник заказан сразу, без главы")
	TEST_ASSERT_EQUAL(engineering.account.account_balance, price * 2, "Оплачен бюджетом инженерии")
	TEST_ASSERT_EQUAL(engineering.staple_left(engineer_account.account_id), cap - price, "Лимит часа уменьшился на цену")
	engineering.staple_spent["[engineer_account.account_id]"][2] = cap - price + 1
	var/datum/econ_request/over = engineering.submit_request(glass, engineer, "Ещё окна")
	TEST_ASSERT_EQUAL(over.status, ECON_REQUEST_PENDING, "Сверх часового лимита - заявка главе")
	TEST_ASSERT(findtext(engineering.pending_text(glass, engineer, 1), "решения главы"), "Ответ сверх лимита говорит о главе: [engineering.pending_text(glass, engineer, 1)]")
	engineering.staple_spent["[engineer_account.account_id]"][1] -= 1 HOURS
	TEST_ASSERT_EQUAL(engineering.staple_left(engineer_account.account_id), cap, "Через час лимит снова полный")
	engineering.approve_stale_requests()
	TEST_ASSERT_EQUAL(over.status, ECON_REQUEST_APPROVED, "С новым часом ждущий расходник заказан на тике")
	econ_test_set_balance(engineering.account, 0)
	// Цена пака плавает с рынком: после заказа на тике лимита может не хватить на второй
	engineering.staple_spent -= "[engineer_account.account_id]"
	var/datum/econ_request/poor = engineering.submit_request(glass, engineer, "Без денег")
	TEST_ASSERT_EQUAL(poor.status, ECON_REQUEST_PENDING, "Без денег расходник ждёт")
	TEST_ASSERT(findtext(engineering.request_outlook(poor), "закажется сам, когда хватит денег"), "Окно объясняет ожидание расходника: [engineering.request_outlook(poor)]")
	engineering.staple_spent["[engineer_account.account_id]"] = list(world.time, 0)
	econ_test_set_balance(engineering.account, price)
	engineering.approve_stale_requests()
	TEST_ASSERT_EQUAL(poor.status, ECON_REQUEST_APPROVED, "Деньги пришли - расходник заказан на тике")
	TEST_ASSERT_EQUAL(length(SSshuttle.shoppinglist), 3, "Три оплаченных заказа в очереди")

/// Дорогой расходник с консоли заявок без начальства на смене оплачивает отдел, а не снабжение; потратившего лимит консоль отправляет снабжению.
/datum/unit_test/economy_catalog/staple_window_route/Run()
	var/datum/economy_department/engineering = SSeconomy.get_department(ACCOUNT_ENG)
	var/datum/supply_pack/glass = staple_of(engineering)
	var/mob/living/carbon/human/engineer = make_staff(ACCOUNT_ENG)
	TEST_ASSERT(!engineering.has_decider_on_shift(), "Решить заявку инженерии некому")
	TEST_ASSERT_EQUAL(econ_request_department(engineer, glass), engineering, "Расходник в лимите - бюджету инженерии")
	var/list/budget = econ_budget_request_ui(engineer)
	TEST_ASSERT_EQUAL(budget["staple_left"], SSeconomy.settings.staple_self_order_cap_hour, "Окно знает остаток лимита расходников")
	var/datum/bank_account/engineer_account = econ_account_of(engineer)
	engineering.staple_spent["[engineer_account.account_id]"] = list(world.time, SSeconomy.settings.staple_self_order_cap_hour)
	TEST_ASSERT_NULL(econ_request_department(engineer, glass), "Лимит потрачен, решить некому - снабжению")

/// ИИ решает заявки отделов, кроме СБ: одобряет и отклоняет из окна бюджета любого отдела, не заказывает сам и не выписывает премий; с ИИ на смене дорогой пак остаётся заявкой отделу, а недорогой без начальства по-прежнему одобряется сразу.
/datum/unit_test/economy_catalog/ai_decides_requests/Run()
	var/datum/economy_department/medical = SSeconomy.get_department(ACCOUNT_MED)
	var/datum/economy_department/security = SSeconomy.get_department(ACCOUNT_SEC)
	var/mob/living/carbon/human/doctor = make_staff(ACCOUNT_MED)
	var/mob/living/carbon/human/officer = make_staff(ACCOUNT_SEC)
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/silicon/ai/ai = allocate(/mob/living/silicon/ai, run_loc_floor_bottom_left, null, donor)
	var/datum/supply_pack/expensive = window_pack(medical, FALSE)
	var/datum/supply_pack/cheap = window_pack(medical, TRUE)
	var/datum/supply_pack/arms = window_pack(security, FALSE)
	TEST_ASSERT(expensive && cheap && arms, "Паки медицины по обе стороны лимита и дорогой пак СБ")
	TEST_ASSERT_NULL(econ_request_department(doctor, expensive), "Без начальства и ИИ дорогой пак - снабжению")
	on_shift(ai)
	TEST_ASSERT(medical.has_decider_on_shift() && !medical.has_approver_on_shift(), "ИИ решает заявки, но начальством не считается")
	TEST_ASSERT(!security.has_decider_on_shift(), "Заявки СБ ИИ не решает")
	TEST_ASSERT_EQUAL(econ_request_department(doctor, expensive), medical, "С ИИ на смене дорогой пак - заявка медицине")
	TEST_ASSERT_NULL(econ_request_department(officer, arms), "Дорогой пак СБ без начальства - снабжению и при ИИ")
	econ_test_set_balance(medical.account, round(econ_pack_price(cheap)) + round(econ_pack_price(expensive)))
	var/datum/econ_request/small = medical.submit_request(cheap, doctor, "Бинты")
	TEST_ASSERT_EQUAL(small.status, ECON_REQUEST_APPROVED, "Недорогой пак без начальства одобрен сразу и при ИИ")
	var/datum/econ_request/big = medical.submit_request(expensive, doctor, "Операционная")
	TEST_ASSERT_EQUAL(big.status, ECON_REQUEST_PENDING, "Дорогой пак ждёт решения")
	TEST_ASSERT(findtext(medical.pending_text(expensive, doctor, 1), "решения ИИ"), "Подавшему сказано, что решит ИИ: [medical.pending_text(expensive, doctor, 1)]")
	TEST_ASSERT(findtext(medical.request_outlook(big), "решает ИИ"), "Окно: решает ИИ - [medical.request_outlook(big)]")
	var/datum/computer_file/program/department_budget/app = allocate(/datum/computer_file/program/department_budget)
	TEST_ASSERT(app.can_switch(ai), "ИИ выбирает отдел")
	budget_press(app, ai, "select_department", list("id" = ACCOUNT_MED))
	var/list/data = app.budget_data(ai)
	TEST_ASSERT(data["is_ai"] && !data["can_manage"], "Окно: ИИ, не глава")
	var/list/shown
	for(var/list/entry as anything in data["requests"])
		if(entry["uid"] == big.uid)
			shown = entry
	TEST_ASSERT(shown && shown["can_decide"], "Окно даёт ИИ решить ждущую заявку")
	TEST_ASSERT_EQUAL(data["deciders"], "ИИ", "Окно называет, кто решает")
	var/refusal = budget_press(app, ai, "order", list("pack" = "[expensive.type]"))
	TEST_ASSERT_EQUAL(refusal, "Это может только глава отдела, ГП или капитан.", "ИИ сам не заказывает")
	var/answer = budget_press(app, ai, "approve", list("uid" = big.uid))
	TEST_ASSERT_EQUAL(big.status, ECON_REQUEST_APPROVED, "ИИ одобрил заявку: [answer]")
	TEST_ASSERT_EQUAL(medical.account.account_balance, 0, "Оплатил бюджет медицины")
	var/datum/econ_request/third = medical.submit_request(expensive, doctor, "Ещё")
	budget_press(app, ai, "deny", list("uid" = third.uid))
	TEST_ASSERT_EQUAL(third.status, ECON_REQUEST_DENIED, "ИИ отклонил заявку")
	econ_test_set_balance(security.account, round(econ_pack_price(arms)))
	var/mob/living/carbon/human/hos = make_with_job(/datum/job/hos)
	on_shift(hos)
	var/datum/econ_request/guns = security.submit_request(arms, officer, "Арсенал")
	TEST_ASSERT_EQUAL(guns.status, ECON_REQUEST_PENDING, "Заявка СБ ждёт ГСБ")
	TEST_ASSERT(!security.approve(guns, ai), "ИИ не одобряет заявки СБ")
	TEST_ASSERT(!security.deny(guns, ai), "ИИ не отклоняет заявки СБ")
	GLOB.player_list -= list(hos, ai)
	TEST_ASSERT(!medical.has_decider_on_shift(), "ИИ без игрока заявки на смене не решает")

/// Заявку без решения дольше request_handoff_minutes может решить начальник снабжения за бюджет отдела: до срока нельзя, о передаче слышат подавший и канал снабжения; заявки СБ передаются так же.
/datum/unit_test/economy_catalog/request_handoff/Run()
	var/obj/item/radio/headset/econ_test_spy/spy = spy_announcer()
	var/datum/economy_department/medical = SSeconomy.get_department(ACCOUNT_MED)
	var/datum/economy_department/security = SSeconomy.get_department(ACCOUNT_SEC)
	var/mob/living/carbon/human/doctor = make_staff(ACCOUNT_MED, null, /datum/bank_account/econ_test_ear)
	var/mob/living/carbon/human/officer = make_staff(ACCOUNT_SEC)
	var/mob/living/carbon/human/qm = make_with_job(/datum/job/qm, /datum/bank_account/econ_test_ear)
	on_shift(qm)
	var/datum/supply_pack/expensive = pack_above_auto_limit(medical)
	var/datum/supply_pack/arms = pack_above_auto_limit(security)
	econ_test_set_balance(medical.account, round(econ_pack_price(expensive)))
	econ_test_set_balance(security.account, round(econ_pack_price(arms)))
	var/datum/econ_request/request = medical.submit_request(expensive, doctor, "Операционная")
	var/datum/econ_request/guns = security.submit_request(arms, officer, "Арсенал")
	TEST_ASSERT(request && guns, "Обе заявки поданы")
	TEST_ASSERT(!medical.can_decide(request, qm), "До срока начальник снабжения заявку медицины не решает")
	TEST_ASSERT(findtext(medical.request_outlook(request), "мин. без решения перейдёт и начальнику снабжения"), "Окно обещает передачу: [medical.request_outlook(request)]")
	medical.hand_off_stale_requests()
	TEST_ASSERT(!request.handed_off, "Свежая заявка не передана")
	request.created -= SSeconomy.settings.request_handoff_minutes MINUTES
	guns.created -= SSeconomy.settings.request_handoff_minutes MINUTES
	spy.heard.Cut()
	medical.hand_off_stale_requests()
	security.hand_off_stale_requests()
	TEST_ASSERT(request.handed_off, "Зависшая заявка медицины передана снабжению")
	TEST_ASSERT(guns.handed_off, "Зависшая заявка СБ передана снабжению")
	var/datum/bank_account/econ_test_ear/doctor_ear = econ_account_of(doctor)
	TEST_ASSERT(length(doctor_ear.heard) && findtext(doctor_ear.heard[length(doctor_ear.heard)], "начальник снабжения"), "Подавший узнал о передаче: [jointext(doctor_ear.heard, "; ")]")
	var/supply_line
	for(var/line in spy.heard)
		if(findtext(line, "[RADIO_CHANNEL_SUPPLY]: ") == 1 && findtext(line, "№[request.uid]"))
			supply_line = line
	TEST_ASSERT(supply_line && !findtext(supply_line, "Операционная"), "Канал снабжения слышит о заявке, без причины: [jointext(spy.heard, "; ")]")
	var/datum/bank_account/econ_test_ear/qm_ear = econ_account_of(qm)
	TEST_ASSERT(length(qm_ear.heard), "Карта начальника снабжения сообщила о переданной заявке")
	TEST_ASSERT(medical.can_decide(request, qm), "Переданную заявку начальник снабжения решает")
	TEST_ASSERT(findtext(medical.request_outlook(request), "начальник снабжения"), "Окно называет начальника снабжения: [medical.request_outlook(request)]")
	var/datum/computer_file/program/department_budget/app = allocate(/datum/computer_file/program/department_budget)
	var/list/data = app.budget_data(qm)
	TEST_ASSERT_EQUAL(length(data["handoff_requests"]), 2, "Начальнику снабжения окно показывает обе переданные заявки")
	var/list/entry
	for(var/list/handed as anything in data["handoff_requests"])
		if(handed["uid"] == request.uid && handed["department_id"] == ACCOUNT_MED)
			entry = handed
	TEST_ASSERT(entry && entry["can_decide"], "Переданная заявка медицины, её можно решить")
	var/answer = budget_press(app, qm, "approve", list("uid" = request.uid, "department" = ACCOUNT_MED))
	TEST_ASSERT_EQUAL(request.status, ECON_REQUEST_APPROVED, "Начальник снабжения одобрил заявку: [answer]")
	TEST_ASSERT(findtext(answer, "за бюджет отдела"), "Ответ называет бюджет отдела: [answer]")
	TEST_ASSERT_EQUAL(medical.account.account_balance, 0, "Оплатил бюджет медицины, не снабжения")
	TEST_ASSERT(findtext(doctor_ear.heard[length(doctor_ear.heard)], "одобрена снабжением"), "Подавший узнал, кто одобрил: [doctor_ear.heard[length(doctor_ear.heard)]]")
	TEST_ASSERT(security.can_decide(guns, qm), "Переданную заявку СБ начальник снабжения решает")
	var/guns_answer = budget_press(app, qm, "approve", list("uid" = guns.uid, "department" = ACCOUNT_SEC))
	TEST_ASSERT_EQUAL(guns.status, ECON_REQUEST_APPROVED, "Начальник снабжения одобрил заявку СБ: [guns_answer]")
	TEST_ASSERT_EQUAL(security.account.account_balance, 0, "Оплатил бюджет СБ, не снабжения")

/// Без начальства, ИИ и начальника снабжения окно честно говорит, что решить некому и что будет дальше.
/datum/unit_test/economy_catalog/request_outlook_nobody/Run()
	var/datum/economy_department/medical = SSeconomy.get_department(ACCOUNT_MED)
	var/mob/living/carbon/human/doctor = make_staff(ACCOUNT_MED)
	var/datum/supply_pack/expensive = pack_above_auto_limit(medical)
	econ_test_set_balance(medical.account, 0)
	var/datum/econ_request/request = medical.submit_request(expensive, doctor, "Операционная")
	var/outlook = medical.request_outlook(request)
	TEST_ASSERT(findtext(outlook, "в бюджете 0 кр. из [round(econ_pack_price(expensive))]"), "Окно показывает нехватку денег: [outlook]")
	TEST_ASSERT(findtext(outlook, "сейчас решить некому: на смене нет начальства отдела и ИИ"), "Окно говорит, что решить некому: [outlook]")
	TEST_ASSERT_NULL(medical.deciders_text(request), "Решающих на смене нет")
	var/text = medical.pending_text(expensive, doctor, 1)
	TEST_ASSERT(findtext(text, "либо ИИ") && findtext(text, "начальник снабжения"), "Подавшему сказано, кого ждать и что дальше: [text]")
