/// Поток чата: посекундные корзины за 30 с, старые выпадают, знаменатель не короче 10 с.
/datum/unit_test/ping_diag_chat_rate/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	TEST_ASSERT_NULL(diag.chat_rate(1000), "чат ещё ничего не слал - поток неизвестен")
	diag.note_chat(0, 1000)
	TEST_ASSERT_NULL(diag.chat_rate(1000), "пустая пачка не считается")
	diag.note_chat(50, 1000)
	TEST_ASSERT(abs(diag.chat_rate(1010) - 5) < 0.01, "50 сообщений за первую секунду делятся на 10 с, а не на 1: [diag.chat_rate(1010)]")
	for(var/time in 1005 to 1200 step 5)
		diag.note_chat(5, time)
	TEST_ASSERT(abs(diag.chat_rate(1200) - 12.5) < 0.01, "250 сообщений за 20 с наблюдения: [diag.chat_rate(1200)]")
	TEST_ASSERT(abs(diag.chat_rate(1400) - 95 / 30) < 0.01, "старше 30 с выпадает, знаменатель не длиннее окна: [diag.chat_rate(1400)]")
	diag.note_chat(7, 1405)
	TEST_ASSERT(abs(diag.chat_rate(1405) - 102 / 30) < 0.01, "корзина прошлого круга обнуляется, а не копится: [diag.chat_rate(1405)]")
	TEST_ASSERT_EQUAL(diag.chat_rate(1800), 0, "через 30 с тишины поток нулевой")
	qdel(diag)

/// Колебания 60 мс за 30 с, а SSchat шлёт chat_per_second сообщений каждую секунду.
/datum/unit_test/ping_diag_flood/proc/make(chat_per_second, jitter = TRUE)
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/i in 1 to 30)
		diag.record_sample(1000 + i * 10, (i == 1 || !jitter) ? 40 : 100, 0, 0, 0)
		if(chat_per_second)
			diag.note_chat(chat_per_second, 1000 + i * 10)
	diag.recompute(1300, 0, 0)
	return diag

/datum/unit_test/ping_diag_flood/Run()
	var/datum/ping_diagnostics/diag = make(40)
	TEST_ASSERT_EQUAL(diag.verdicts.Join(","), PING_VERDICT_FLOOD, "колебания при потоке чата - поток, а не сеть")
	TEST_ASSERT(abs(diag.summary["chat_rate"] - 1200 / 29) < 0.1, "поток в сводке: [diag.summary["chat_rate"]]")
	qdel(diag)
	diag = make(0)
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_JITTER, "без потока те же колебания - сеть игрока")
	TEST_ASSERT_NULL(diag.summary["chat_rate"], "чат не слал - поток неизвестен")
	qdel(diag)
	diag = make(40, FALSE)
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_OK, "большой поток без следов очереди - связь в порядке")
	qdel(diag)

/// Давние подвисания при свежем потоке без следов очереди остаются подвисаниями.
/datum/unit_test/ping_diag_flood_recent/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.note_sent(600, 1)
	diag.record_sample(650, 40, 0, 1, null)
	diag.note_sent(700, 2)
	diag.record_sample(750, 40, 0, 2, null)
	for(var/time in 768 to 3300 step 18)
		diag.record_sample(time, 40, 0, 0, 0)
	for(var/time in 3000 to 3300 step 10)
		diag.note_chat(12, time)
	diag.recompute(3300, 0, 0)
	TEST_ASSERT(diag.summary["chat_rate"] >= PING_DIAG_FLOOD_RATE, "поток призрака идёт: [diag.summary["chat_rate"]]")
	TEST_ASSERT_EQUAL(diag.summary["recent_freezes"], 0, "за последние 30 с подвисаний нет")
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_FREEZE, "подвисания 4 минуты назад поток не прячет")
	qdel(diag)

/// Пики и опоздания залива не судят сеть игрока и после того, как поток спал.
/datum/unit_test/ping_diag_flood_after/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/time in 600 to 3600 step 2)
		if(time >= 2000 && time <= 2500 && !(time % 10))
			diag.note_chat(40, time)
		if(time == 2200 || time == 2350)
			diag.note_sent(time, time)
		if(time == 2260 || time == 2410)
			diag.record_sample(time, 3000, 0, time - 60, null)
		if(!(time % 18))
			var/spike = time >= 2100 && time <= 2500 && !((time / 18) % 3)
			diag.record_sample(time, spike ? 400 : 40, 0, 0, 0)
	diag.recompute(3600, 0, 0)
	TEST_ASSERT_EQUAL(diag.summary["chat_rate"], 0, "поток спал")
	TEST_ASSERT_EQUAL(diag.summary["freezes"], 0, "опоздания в заливе - очередь, а не подвисания")
	TEST_ASSERT_EQUAL(diag.summary["loss_per_min"], 0, "пики залива не похожи на потери")
	TEST_ASSERT_EQUAL(diag.verdicts.Join(","), PING_VERDICT_OK, "после потока сеть игрока не винится")
	TEST_ASSERT(diag.summary["rtt_p95"] >= 400, "пики остаются в RTT: p95 [diag.summary["rtt_p95"]]")
	TEST_ASSERT(diag.summary["personal_mean"] > 0, "и в разложении пинга")
	qdel(diag)

/// Кольцо растёт при первом наблюдении: порядок и данные те же, места больше.
/datum/unit_test/ping_diag_ring_grow/proc/dump(datum/ping_diagnostics/diag, now)
	var/list/parts = list()
	for(var/slot in diag.window_slots(now))
		parts += "[diag.sample_time[slot]]/[diag.sample_rtt[slot]]/[diag.sample_flood[slot]]"
	return parts.Join(" ")

/datum/unit_test/ping_diag_ring_grow/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	TEST_ASSERT_EQUAL(length(diag.sample_time), PING_DIAG_BASE_SAMPLES, "без окна кольцо маленькое")
	var/total = PING_DIAG_BASE_SAMPLES + 37
	for(var/i in 1 to total)
		if(i > 100 && i < 150)
			diag.note_chat(50, i * 3)
		diag.record_sample(i * 3, 40 + i % 7, 0, 0, 0)
	var/before = dump(diag, total * 3)
	TEST_ASSERT(findtext(before, "/1 ") && findtext(before, "/0 "), "в кольце есть замеры и при потоке, и без: [before]")
	diag.grow_ring(PING_DIAG_MAX_SAMPLES)
	TEST_ASSERT_EQUAL(length(diag.sample_time), PING_DIAG_MAX_SAMPLES, "кольцо выросло")
	TEST_ASSERT_EQUAL(dump(diag, total * 3), before, "порядок и данные пережили рост")
	diag.grow_ring(PING_DIAG_MAX_SAMPLES)
	TEST_ASSERT_EQUAL(dump(diag, total * 3), before, "повторный рост ничего не трогает")
	var/added = PING_DIAG_MAX_SAMPLES - PING_DIAG_BASE_SAMPLES
	for(var/i in 1 to added)
		diag.record_sample((total + i) * 3, 40, 0, 0, 0)
	var/list/slots = diag.window_slots((total + added) * 3)
	TEST_ASSERT_EQUAL(length(slots), PING_DIAG_MAX_SAMPLES, "после роста места больше")
	TEST_ASSERT_EQUAL(diag.sample_time[slots[1]], (total - PING_DIAG_BASE_SAMPLES + 1) * 3, "старейший замер до роста цел")
	for(var/i in 2 to length(slots))
		TEST_ASSERT(diag.sample_time[slots[i]] > diag.sample_time[slots[i - 1]], "слоты идут по времени, шаг [i]")
	qdel(diag)

/// Замер приходит командной строкой от клиента: нечисла не пишутся, числа зажаты.
/datum/unit_test/ping_diag_forged_samples/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.record_sample(1, 40, 0, 1, 0)
	var/slot = diag.record_sample(2, 1e30, 5e29, 1, 0)
	TEST_ASSERT_EQUAL(diag.sample_rtt[slot], PING_DIAG_MAX_RTT_MS, "подделанный rtt зажат")
	TEST_ASSERT(diag.sample_stall[slot] <= diag.sample_rtt[slot], "простой не больше rtt")
	slot = diag.record_sample(3, 50, 900, 1, 0)
	TEST_ASSERT_EQUAL(diag.sample_stall[slot], 50, "простой зажат rtt")
	slot = diag.record_sample(4, 50, -20, 1, 0)
	TEST_ASSERT_EQUAL(diag.sample_stall[slot], 0, "отрицательный простой - 0")
	slot = diag.record_sample(5, -30, 0, 1, 0)
	TEST_ASSERT_EQUAL(diag.sample_rtt[slot], 0, "отрицательный rtt - 0")
	var/count = diag.sample_count
	TEST_ASSERT_NULL(diag.record_sample(6, "x", 0, 1, 0), "нечисло не пишется")
	TEST_ASSERT_NULL(diag.record_sample(6, null, 0, 1, 0), "пустое не пишется")
	TEST_ASSERT_EQUAL(diag.sample_count, count, "счётчик замеров не сдвинулся")
	diag.recompute(6, 0, 0)
	for(var/key in diag.summary)
		var/value = diag.summary[key]
		if(isnum(value))
			TEST_ASSERT(value == value && abs(value) < 1e9, "[key] конечно: [value]")
	qdel(diag)

/datum/unit_test/ping_diag_probe_expected/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	TEST_ASSERT_NULL(diag.record_probe(1, 40, 0, 0), "проба без отправки отброшена")
	TEST_ASSERT_EQUAL(diag.sample_count, 0, "в кольцо не попала")
	diag.expect_probe()
	TEST_ASSERT_NOTNULL(diag.record_probe(2, 40, 0, 0), "ушедшая проба принята")
	TEST_ASSERT_NULL(diag.record_probe(3, 40, 0, 0), "второй ответ на одну пробу отброшен")
	for(var/i in 1 to PING_DIAG_MAX_PROBES_IN_FLIGHT + 5)
		diag.expect_probe()
	var/accepted = 0
	for(var/i in 1 to PING_DIAG_MAX_PROBES_IN_FLIGHT + 5)
		if(diag.record_probe(10 + i, 40, 0, 0))
			accepted++
	TEST_ASSERT_EQUAL(accepted, PING_DIAG_MAX_PROBES_IN_FLIGHT, "висящих проб не больше предела")
	qdel(diag)

/// На монотонно растущем ряду очередь минимумов держит все значения: длина ограничена кольцом.
/datum/unit_test/ping_diag_base_queue_cap/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/i in 1 to length(diag.sample_time) + 50)
		diag.record_sample(100, 40 + i, 0, 0, 0)
	TEST_ASSERT(length(diag.base_value) <= length(diag.sample_time), "очередь базы не длиннее кольца: [length(diag.base_value)]")
	TEST_ASSERT_EQUAL(length(diag.base_time), length(diag.base_value), "времена и значения базы парные")
	qdel(diag)

/datum/unit_test/ping_diag_shared_known/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/i in 1 to PING_DIAG_MIN_SAMPLES)
		diag.record_sample(i * 18, 40, 0, 0, (i % 4) ? null : 0)
	diag.recompute(PING_DIAG_MIN_SAMPLES * 18, 0, 0)
	TEST_ASSERT_EQUAL(diag.summary["shared_known"], 0.25, "доля замеров с известной общей задержкой")
	diag.verdicts = list(PING_VERDICT_JITTER)
	diag.update_yours_since(100)
	TEST_ASSERT(!diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, FALSE, FALSE), "общая задержка неизвестна - в чат не подсказываем")
	diag.summary["shared_known"] = 1
	TEST_ASSERT(diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, FALSE, FALSE), "известна - подсказываем")
	qdel(diag)

/// Молчание, общее для всех, снимает подвисание этого эпизода и не даёт засчитать его снова.
/datum/unit_test/ping_diag_shared_silence/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.note_sent(0, 1)
	diag.note_sent(36, 2)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "до закрытия пачки подвисание уже засчитано")
	diag.note_shared_silence()
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 0, "общее молчание снимает подвисание")
	diag.note_sent(72, 3)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 0, "и не засчитывает его снова")
	diag.record_sample(80, 40, 0, 1, 0)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 0, "поздний ответ тоже")
	diag.note_sent(90, 4)
	diag.note_sent(126, 5)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "следующее своё молчание - снова подвисание")
	qdel(diag)
