/// База - минимум rtt - stall за окно: монотонная очередь обязана совпадать с наивным минимумом.
/datum/unit_test/ping_diag_base_window/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	var/list/times = list()
	var/list/values = list()
	for(var/i in 1 to 400)
		var/now = i * 18
		var/rtt = 40 + ((i * 37) % 23) + (i % 50 == 0 ? 200 : 0)
		diag.record_sample(now, rtt, 0, 0, 0)
		times += now
		values += rtt
		var/naive = INFINITY
		for(var/j in 1 to length(times))
			if(times[j] >= now - PING_DIAG_WINDOW_DS)
				naive = min(naive, values[j])
		TEST_ASSERT_EQUAL(diag.base_value[1], naive, "база на шаге [i]")
	qdel(diag)

/datum/unit_test/ping_diag_ring/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/i in 1 to PING_DIAG_BASE_SAMPLES + 10)
		diag.record_sample(i * 3, 40, 0, 0, 0)
	TEST_ASSERT_EQUAL(diag.sample_count, PING_DIAG_BASE_SAMPLES, "кольцо не растёт")
	var/list/slots = diag.window_slots((PING_DIAG_BASE_SAMPLES + 10) * 3)
	TEST_ASSERT_EQUAL(length(slots), PING_DIAG_BASE_SAMPLES, "всё кольцо в окне")
	for(var/i in 2 to length(slots))
		TEST_ASSERT(diag.sample_time[slots[i]] > diag.sample_time[slots[i - 1]], "слоты идут по времени, шаг [i]")
	TEST_ASSERT_EQUAL(diag.sample_time[slots[1]], 33, "самый старый пережил перезапись - 11-й")
	qdel(diag)

/datum/unit_test/ping_diag_sample_split/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.record_sample(10, 40, 0, 0, 0)
	var/probe = diag.record_sample(20, 140, 0, 0, 30)
	TEST_ASSERT_EQUAL(diag.sample_excess[probe], 100, "лишнее сверх базы")
	TEST_ASSERT_EQUAL(diag.sample_personal[probe], 70, "ускоренный замер сразу вычитает свежую общую долю")
	var/stalled = diag.record_sample(30, 200, 120, 7, 0)
	TEST_ASSERT_EQUAL(diag.sample_excess[stalled], 40, "простой не попадает в лишнее")
	TEST_ASSERT_EQUAL(diag.sample_personal[stalled], 40, "до закрытия пачки всё лишнее личное")
	TEST_ASSERT(isnull(diag.sample_shared[stalled]), "общая доля ещё неизвестна")
	diag.apply_batch_shared(stalled, 8, 25)
	TEST_ASSERT(isnull(diag.sample_shared[stalled]), "чужая пачка не трогает слот")
	diag.apply_batch_shared(stalled, 7, 25)
	TEST_ASSERT_EQUAL(diag.sample_personal[stalled], 15, "личное = лишнее - общее")
	diag.apply_batch_shared(stalled, 7, 90)
	TEST_ASSERT_EQUAL(diag.sample_personal[stalled], 0, "личное не уходит в минус")
	qdel(diag)

/datum/unit_test/ping_diag_freeze/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.note_sent(0, 1)
	diag.record_sample(10, 40, 0, 1, 0)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 0, "ответ вовремя")
	diag.note_sent(20, 2)
	diag.note_sent(38, 3)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 0, "18 дс без ответа - ещё не подвисание")
	diag.note_sent(56, 4)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "36 дс без ответа - подвисание")
	diag.note_sent(74, 5)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "тот же эпизод не считается дважды")
	diag.record_sample(80, 40, 0, 2, 0)
	diag.note_sent(90, 6)
	diag.record_sample(95, 40, 0, 6, 0)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "после ответа счёт новый")
	diag.note_sent(100, 7)
	diag.record_sample(140, 40, 0, 7, 0)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 2, "поздний ответ - тоже подвисание")
	qdel(diag)

/// Ответ на пачку пришёл через 50 дс с заданным простоем; checked - успел ли check_overdue до ответа.
/datum/unit_test/ping_diag_freeze_server_stall/proc/late_reply(stall, checked)
	var/datum/ping_diagnostics/diag = new("tester")
	diag.record_sample(1, 40, 0, 0, 0)
	diag.note_sent(100, 1)
	if(checked)
		diag.note_sent(140, 2)
	diag.record_sample(150, 40 + stall, stall, 1, 0)
	. = length(diag.freeze_times)
	qdel(diag)

/datum/unit_test/ping_diag_freeze_server_stall/Run()
	TEST_ASSERT_EQUAL(late_reply(4500, FALSE), 0, "опоздание объясняется простоем сервера")
	TEST_ASSERT_EQUAL(late_reply(4500, TRUE), 0, "засчитанное до ответа подвисание снято простоем")
	TEST_ASSERT_EQUAL(late_reply(0, FALSE), 1, "без простоя - подвисание")
	TEST_ASSERT_EQUAL(late_reply(0, TRUE), 1, "без простоя - одно подвисание")
	TEST_ASSERT_EQUAL(late_reply(1000, FALSE), 1, "простой 1 с не покрывает 5 с опоздания")
	TEST_ASSERT_EQUAL(late_reply(1000, TRUE), 1, "простой 1 с не снимает засчитанное подвисание")
	var/datum/ping_diagnostics/diag = new("tester")
	diag.note_sent(0, 1)
	diag.note_sent(36, 2)
	diag.record_sample(40, 40, 0, 1, 0)
	diag.note_sent(100, 3)
	diag.note_sent(140, 4)
	diag.record_sample(150, 4540, 4500, 3, 0)
	TEST_ASSERT_EQUAL(length(diag.freeze_times), 1, "снято только подвисание этого эпизода")
	TEST_ASSERT_EQUAL(diag.freeze_times[1], 0, "прошлое подвисание осталось")
	qdel(diag)

/// Без истории браузера или со скрытым окном отставание и кадры неизвестны, а не нули.
/datum/unit_test/ping_diag_browser_unknown/proc/summary_with(hidden, record)
	var/datum/ping_diagnostics/diag = new("tester")
	if(record)
		diag.record_browser(12, 50, hidden, null, null)
	for(var/i in 1 to PING_DIAG_MIN_SAMPLES)
		diag.record_sample(i * 18, 40, 0, 0, 0)
	diag.recompute(PING_DIAG_MIN_SAMPLES * 18, 0, 0)
	. = diag.summary
	qdel(diag)

/datum/unit_test/ping_diag_browser_unknown/Run()
	var/list/empty = summary_with(FALSE, FALSE)
	TEST_ASSERT_NULL(empty["loop_lag"], "без истории отставание неизвестно")
	TEST_ASSERT_NULL(empty["fps"], "без истории кадры неизвестны")
	var/list/hidden = summary_with(TRUE, TRUE)
	TEST_ASSERT_NULL(hidden["loop_lag"], "у скрытого окна отставание неизвестно")
	TEST_ASSERT_NULL(hidden["fps"], "у скрытого окна кадры неизвестны")
	var/list/shown = summary_with(FALSE, TRUE)
	TEST_ASSERT_EQUAL(shown["loop_lag"], 12, "отставание")
	TEST_ASSERT_EQUAL(shown["fps"], 50, "кадры")
	var/list/verdicts = ping_diag_pick_verdicts(empty)
	TEST_ASSERT_EQUAL(verdicts[1], PING_VERDICT_OK, "без данных браузера вердикт как раньше")
	var/list/cells = splittext(ping_diag_csv_row("12:00:00", 0, "somekey", empty, PING_VERDICT_OK, list()), ",")
	var/list/header = splittext(PING_DIAG_CSV_HEADER, ",")
	TEST_ASSERT_EQUAL(cells[header.Find("loop_lag")], "", "неизвестное отставание в CSV - пустая ячейка")
	TEST_ASSERT_EQUAL(cells[header.Find("fps")], "", "неизвестные кадры в CSV - пустая ячейка")
	cells = splittext(ping_diag_csv_row("12:00:00", 0, "somekey", shown, PING_VERDICT_OK, list()), ",")
	TEST_ASSERT_EQUAL(cells[header.Find("fps")], "50", "известные кадры в CSV")

/// Ряд на пять минут с шагом 1.8 с: база 40 мс, мелкий шум и спайки по правилу.
/datum/unit_test/ping_diag_scenarios/proc/run_series(rtt_extra_callback, stall = 0)
	var/datum/ping_diagnostics/diag = new("tester")
	var/now = 0
	for(var/i in 0 to 165)
		now = i * 18
		diag.record_sample(now, 40 + (i % 3) + call(src, rtt_extra_callback)(i) + stall, stall, 0, 0)
	diag.recompute(now, 0, 0)
	return diag

/datum/unit_test/ping_diag_scenarios/proc/flat(i)
	return 0

/datum/unit_test/ping_diag_scenarios/proc/wifi_scan(i)
	return (i && i % 33 == 0) ? 260 : 0

/datum/unit_test/ping_diag_scenarios/proc/far(i)
	return 160

/datum/unit_test/ping_diag_scenarios/Run()
	var/datum/ping_diagnostics/diag = run_series(PROC_REF(flat))
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_OK, "ровный ряд")
	TEST_ASSERT_EQUAL(diag.summary["rtt_min"], 40, "минимум RTT по списку")
	qdel(diag)

	diag = run_series(PROC_REF(wifi_scan))
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_PERIODIC, "скачок раз в 59.4 с - ритм")
	TEST_ASSERT_EQUAL(diag.summary["period"], 594, "период в дс")
	qdel(diag)

	diag = run_series(PROC_REF(flat), 120)
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_SERVER, "простой у сервера")
	TEST_ASSERT_EQUAL(diag.summary["base"], 40, "простой не поднимает базу")
	qdel(diag)

	diag = run_series(PROC_REF(far))
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_FAR, "база 200 мс")
	qdel(diag)

	diag = new("tester")
	for(var/i in 1 to 5)
		diag.record_sample(i * 18, 40, 0, 0, 0)
	diag.recompute(90, 0, 0)
	TEST_ASSERT_EQUAL(diag.verdicts[1], PING_VERDICT_COLLECTING, "мало данных")
	qdel(diag)

/// Общая доля пачки больше лишнего у клиента: в нашу долю идёт только фактическое лишнее.
/datum/unit_test/ping_diag_shared_capped/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	var/now = 0
	for(var/i in 1 to PING_DIAG_MIN_SAMPLES + 5)
		now = i * 18
		diag.record_sample(now, 40, 0, 0, 25)
	diag.recompute(now, 0, 0)
	TEST_ASSERT_EQUAL(diag.summary["shared_mean"], 0, "общей доли сверх лишнего нет")
	TEST_ASSERT_EQUAL(diag.summary["extra_mean"], 0, "лишнего нет")
	TEST_ASSERT_NOTEQUAL(diag.verdicts[1], PING_VERDICT_SERVER, "спокойного клиента сервером не пугаем")
	for(var/list/point as anything in diag.graph_points(now))
		TEST_ASSERT_EQUAL(point["shared"], 0, "на графике общая доля тоже не больше лишнего")
	qdel(diag)

/// record_sample с пачкой null пишет то же, что с пачкой 0.
/datum/unit_test/ping_diag_null_batch/Run()
	var/datum/ping_diagnostics/as_null = new("tester")
	var/datum/ping_diagnostics/as_zero = new("tester")
	as_null.record_sample(1, 40, 0, 0, 0)
	as_zero.record_sample(1, 40, 0, 0, 0)
	var/null_slot = as_null.record_sample(2, 70, 5, null, 10)
	var/zero_slot = as_zero.record_sample(2, 70, 5, 0, 10)
	TEST_ASSERT_EQUAL(as_null.sample_batch[null_slot], as_zero.sample_batch[zero_slot], "номер пачки")
	TEST_ASSERT_EQUAL(as_null.sample_shared[null_slot], as_zero.sample_shared[zero_slot], "общая доля из подсказки")
	TEST_ASSERT_EQUAL(as_null.sample_personal[null_slot], as_zero.sample_personal[zero_slot], "личное")
	TEST_ASSERT_EQUAL(as_null.sample_personal[null_slot], 15, "70 - 5 - 40 - 10")
	qdel(as_null)
	qdel(as_zero)

/datum/unit_test/ping_diag_hint_due/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.summary = list("shared_known" = 1)
	diag.verdicts = list(PING_VERDICT_JITTER)
	diag.update_yours_since(100)
	diag.update_yours_since(200)
	TEST_ASSERT_EQUAL(diag.yours_since, 100, "начало держится, пока вердикт тот же по стороне")
	TEST_ASSERT(!diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS - 1, FALSE, FALSE), "рано")
	TEST_ASSERT(diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, FALSE, FALSE), "держится три минуты - пора")
	TEST_ASSERT(!diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, TRUE, FALSE), "игрок отключил подсказку")
	TEST_ASSERT(!diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, FALSE, TRUE), "раз за раунд")
	diag.verdicts = list(PING_VERDICT_SERVER)
	diag.update_yours_since(300)
	TEST_ASSERT(!diag.hint_due(100 + PING_DIAG_HINT_HOLD_DS, FALSE, FALSE), "при вердикте сервер молчим")
	qdel(diag)

/datum/unit_test/ping_diag_graph/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	diag.grow_ring(PING_DIAG_MAX_SAMPLES)
	for(var/i in 1 to PING_DIAG_MAX_SAMPLES)
		diag.record_sample(i * 4, i == 333 ? 900 : 40, 0, 0, 0)
