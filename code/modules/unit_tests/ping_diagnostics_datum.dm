/datum/unit_test/ping_diag_browser/Run()
	var/datum/ping_diagnostics/diag = new("tester")
	for(var/i in 1 to PING_DIAG_BROWSER_HISTORY + 3)
		diag.record_browser(i, 60, 0, 50, null)
	TEST_ASSERT_EQUAL(length(diag.browser_loop_lag), PING_DIAG_BROWSER_HISTORY, "история браузера ограничена")
	diag.record_browser("x", -5, 1, 1e9, "y")
	TEST_ASSERT_EQUAL(length(diag.browser_loop_lag), PING_DIAG_BROWSER_HISTORY, "мусор не пишется")
	TEST_ASSERT_EQUAL(diag.browser_fps[length(diag.browser_fps)], 0, "отрицательные кадры зажаты в 0")
	TEST_ASSERT_EQUAL(diag.browser_rtt, 60000, "rtt зажат сверху")
	diag.record_sample(10, 40, 0, 0, 0)
	diag.recompute(10, 0, 0)
	TEST_ASSERT_NULL(diag.summary["chat_messages"], "нечисло сообщений - null")
	diag.record_browser(1, 60, 0, 50, 1e9)
	diag.recompute(10, 0, 0)
	TEST_ASSERT_EQUAL(diag.summary["chat_messages"], PING_DIAG_CHAT_MAX_MESSAGES, "сообщений зажато сверху")
	diag.record_browser(1, 60, 0, 50, -5)
	diag.recompute(10, 0, 0)
	TEST_ASSERT_EQUAL(diag.summary["chat_messages"], 0, "отрицательное число сообщений - 0")
