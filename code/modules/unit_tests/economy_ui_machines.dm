/datum/unit_test/proc/econ_ui_press(mob/user, datum/host, interface, action, list/params = list())
	var/datum/tgui/window = allocate(/datum/tgui, user, host, interface)
	window.status = UI_INTERACTIVE
	usr = user
	. = host.ui_act(action, params, window)
	usr = null

/// Делает человека предателем для проверок назначения инструментов, без снаряжения и целей.
/datum/unit_test/proc/econ_test_traitor(mob/living/carbon/human/person)
	person.mind_initialize()
	var/datum/antagonist/traitor/antag = new
	antag.owner = person.mind
	LAZYADD(person.mind.antag_datums, antag)
	allocated += antag

/datum/unit_test/proc/econ_ui_menu_id(obj/machinery/cash_register/register, item_name)
	for(var/list/item as anything in register.menu)
		if(item["name"] == item_name)
			return item["id"]

/// Касса из окна: меню и счёт правит только кассир, позиции по постоянному id, оплата и чаевые проходят только тому кассиру и тому счёту, что видел клиент.
/datum/unit_test/economy_register/ui/Run()
	setup_register()
	swipe(cashier)
	TEST_ASSERT(register.is_cashier(cashier), "Кассир встал за кассу")
	econ_ui_press(cashier, register, "CashRegister", "add_item", list("name" = "Пиво", "price" = "100"))
	econ_ui_press(cashier, register, "CashRegister", "add_item", list("name" = "Сок", "price" = 30))
	econ_ui_press(customer, register, "CashRegister", "add_item", list("name" = "Чужое", "price" = 10))
	econ_ui_press(cashier, register, "CashRegister", "add_item", list("name" = "Даром", "price" = "мусор"))
	TEST_ASSERT_EQUAL(length(register.menu), 2, "Меню из окна правит только кассир и только с ценой")
	var/beer_id = econ_ui_menu_id(register, "Пиво")
	var/juice_id = econ_ui_menu_id(register, "Сок")
	econ_ui_press(cashier, register, "CashRegister", "order", list("id" = "[juice_id]", "delta" = "1"))
	econ_ui_press(cashier, register, "CashRegister", "order", list("id" = juice_id, "delta" = 1))
	econ_ui_press(customer, register, "CashRegister", "order", list("id" = juice_id, "delta" = 1))
	econ_ui_press(cashier, register, "CashRegister", "remove_item", list("id" = beer_id))
	TEST_ASSERT_EQUAL(length(register.menu), 1, "Позиция убрана")
	TEST_ASSERT_EQUAL(econ_ui_menu_id(register, "Сок"), juice_id, "Id позиции не сдвинулся")
	var/datum/register_cashier/seller = till()
	var/list/data = register.ui_data(customer)
	var/list/rows = data["cashiers"]
	var/list/row = rows[1]
	TEST_ASSERT_EQUAL(row["total"], 60, "Два сока в счёте, клиент счёт не правит")
	TEST_ASSERT(!data["is_cashier"] && row["name"] == seller.name, "Клиент видит кассира")
	TEST_ASSERT_NULL(row["pay_problem"], "Оплата возможна")
	TEST_ASSERT_NULL(data["total_sales"], "Выручку видит только кассир")
	TEST_ASSERT(data["can_join"], "Второе место за кассой свободно")
	var/rev = row["rev"]
	var/cashier_id = row["id"]
	econ_ui_press(customer, register, "CashRegister", "pay", list("cashier" = cashier_id, "rev" = rev + 1, "total" = 60))
	econ_ui_press(customer, register, "CashRegister", "pay", list("cashier" = cashier_id, "rev" = rev, "total" = 30))
	econ_ui_press(customer, register, "CashRegister", "pay", list("cashier" = customer_account.account_id, "rev" = rev, "total" = 60))
	TEST_ASSERT_EQUAL(customer_account.account_balance, 1000, "Чужой кассир, чужая сумма или правленый счёт не платят")
	econ_ui_press(customer, register, "CashRegister", "pay", list("cashier" = "[cashier_id]", "rev" = "[rev]", "total" = "60"))
	TEST_ASSERT_EQUAL(customer_account.account_balance, 940, "Клиент оплатил счёт своей картой")
	TEST_ASSERT_EQUAL(register.total_sales, 60, "Продажа учтена")
	econ_ui_press(customer, register, "CashRegister", "tip", list("amount" = "15", "cashier" = cashier_id))
	TEST_ASSERT_EQUAL(customer_account.account_balance, 925, "Чаевые прошли")
	data = register.ui_data(customer)
	TEST_ASSERT(data["cooldown_left"] > 0, "Окно показывает общий кулдаун чаевых и переводов")
	econ_ui_press(customer, register, "CashRegister", "tip", list("amount" = "15", "cashier" = cashier_id))
	TEST_ASSERT_EQUAL(customer_account.account_balance, 925, "Вторые чаевые упираются в кулдаун")
	data = register.ui_data(cashier)
	TEST_ASSERT(data["is_cashier"] && data["total_sales"] == 60, "Кассир видит выручку")
	econ_ui_press(customer, register, "CashRegister", "logout")
	TEST_ASSERT(register.is_cashier(cashier), "Клиент не снимает кассира")
	econ_ui_press(customer, register, "CashRegister", "join")
	TEST_ASSERT(register.is_cashier(customer), "Из окна встают вторым кассиром")
	econ_ui_press(customer, register, "CashRegister", "logout")
	econ_ui_press(cashier, register, "CashRegister", "logout")
	TEST_ASSERT(!length(register.cashiers), "Оба отошли из окна")

/// Узел экспорта из окна: мощность обрезается потолком, мусор не принимается, окно показывает излишек сети без узла и цену по рынку энергии и цене работы.
/datum/unit_test/economy_engineering/node_ui/Run()
	save_state()
	var/obj/machinery/power/export_node/node = allocate(/obj/machinery/power/export_node/econ_test_station)
	var/datum/powernet/grid = test_grid(node)
	var/mob/living/carbon/human/engineer = allocate(/mob/living/carbon/human)
	var/datum/economy_settings/settings = SSeconomy.settings
	var/datum/commodity/energy = SSmarket.get_commodity(COMMODITY_ENERGY)
	energy.price_factor = 1.5
	settings.work_prices[WORK_ENG_POWER_EXPORT] = 2
	econ_ui_press(engineer, node, "PowerExportNode", "set_draw", list("kw" = "999999"))
	TEST_ASSERT_EQUAL(node.target_kw, settings.power_export_max_kw, "Потолок мощности")
	econ_ui_press(engineer, node, "PowerExportNode", "set_draw", list("kw" = "мусор"))
	TEST_ASSERT_EQUAL(node.target_kw, settings.power_export_max_kw, "Мусор не меняет мощность")
	econ_ui_press(engineer, node, "PowerExportNode", "set_draw", list("kw" = 1000))
	TEST_ASSERT_EQUAL(node.target_kw, 1000, "Мощность задана")
	econ_ui_press(engineer, node, "PowerExportNode", "toggle")
	TEST_ASSERT(node.active, "Узел включён")
	power_cycle(grid, 400000)
	node.process(1)
	power_cycle(grid, 400000)
	var/list/data = node.ui_data(engineer)
	TEST_ASSERT_EQUAL(data["export_w"], 400000, "Продаётся то, что осталось в сети")
	TEST_ASSERT_EQUAL(data["surplus_w"], 400000, "Излишек сети без учёта самого узла")
	TEST_ASSERT_EQUAL(data["market_percent"], 150, "Рыночный фактор энергии")
	TEST_ASSERT_EQUAL(data["price_per_mj"], round(settings.power_export_credits_per_mj * 2 * 1.5, 0.01), "Цена без рынка или цены работы")
	TEST_ASSERT_EQUAL(data["income_per_minute"], round(0.4 * 60 * settings.power_export_credits_per_mj * 2 * 1.5), "Доход в минуту без цены работы")
	TEST_ASSERT(findtext(jointext(node.examine(engineer), " "), "[round(settings.power_export_credits_per_mj * 2 * 1.5, 0.01)] кр. за МДж"), "Осмотр называет цену без цены работы")
	node.process(1)
	power_cycle(grid, 400000)
	data = node.ui_data(engineer)
	TEST_ASSERT_EQUAL(data["export_w"], 0, "Перегруженная прошлым недобором сеть не продаёт")
	TEST_ASSERT_EQUAL(data["surplus_w"], 400000, "Излишек без прошлого недобора узла")
	econ_ui_press(engineer, node, "PowerExportNode", "toggle")
	TEST_ASSERT(!node.active, "Узел выключен")

/// Хранилище улик из окна: улики и оплату видит СБ, выдача NT и возврат в руки по ref только с доступом.
/datum/unit_test/economy_work/security/locker_ui/Run()
	TEST_ASSERT_NOTNULL(setup_officer(), "ID офицера надета")
	var/turf/station_turf = find_walkable_station_turf()
	TEST_ASSERT_NOTNULL(station_turf, "Есть станционный турф")
	var/obj/machinery/evidence_locker/locker = allocate(/obj/machinery/evidence_locker, station_turf)
	var/obj/item/card/id/syndicate/agent_card = allocate(/obj/item/card/id/syndicate)
	var/obj/item/card/emag/emag = allocate(/obj/item/card/emag)
	TEST_ASSERT(locker.store(hold(agent_card), performer), "Карта в хранилище")
	TEST_ASSERT(locker.store(hold(emag), performer), "Емаг в хранилище")
	var/list/data = locker.ui_data(performer)
	var/list/items = data["items"]
	TEST_ASSERT(data["can_use"] && length(items) == 2, "СБ видит улики")
	TEST_ASSERT_EQUAL(data["cap_left"], SSeconomy.settings.contraband_cap_hour, "Остаток часового лимита")
	var/list/card_entry
	for(var/list/entry as anything in items)
		if(entry["ref"] == REF(agent_card))
			card_entry = entry
	TEST_ASSERT_NOTNULL(card_entry, "Улика по ref")
	TEST_ASSERT_EQUAL(card_entry["value"], econ_contraband_value(agent_card), "Оценка улики")
	var/mob/living/carbon/human/stranger = allocate(/mob/living/carbon/human, station_turf)
	data = locker.ui_data(stranger)
	items = data["items"]
	TEST_ASSERT(!data["can_use"] && !length(items) && data["count"] == 2, "Без доступа видно только число улик")
	econ_ui_press(stranger, locker, "EvidenceLocker", "hand_over", list("ref" = REF(agent_card)))
	econ_ui_press(stranger, locker, "EvidenceLocker", "eject", list("ref" = REF(emag)))
	TEST_ASSERT((agent_card in locker.stored) && (emag in locker.stored), "Без доступа улики не трогаются")
	econ_ui_press(performer, locker, "EvidenceLocker", "eject", list("ref" = REF(emag)))
	TEST_ASSERT(!(emag in locker.stored) && performer.is_holding(emag), "Улика вернулась в руки")
	var/before = budget.account_balance
	var/value = econ_contraband_value(agent_card)
	econ_ui_press(performer, locker, "EvidenceLocker", "hand_over", list("ref" = REF(agent_card)))
	TEST_ASSERT(QDELETED(agent_card), "Передано NT")
	TEST_ASSERT_EQUAL(budget.account_balance - before, value, "Бюджет СБ получил оценку")
	data = locker.ui_data(performer)
	TEST_ASSERT_EQUAL(data["cap_left"], SSeconomy.settings.contraband_cap_hour - value, "Лимит уменьшился")

/// Скиммер из окна: счета по ссылке слота, лимит в минуту, стирание слота; постороннему окно ничего не показывает и не переводит.
/datum/unit_test/economy_skimmer/ui/Run()
	var/mob/living/carbon/human/thief = allocate(/mob/living/carbon/human)
	econ_test_traitor(thief)
	var/obj/item/card_skimmer/skimmer = allocate(/obj/item/card_skimmer)
	thief.put_in_active_hand(skimmer)
	var/datum/bank_account/first = make_account("econ_test_first", 5000)
	var/datum/bank_account/second = make_account("econ_test_second", 5000)
	var/datum/bank_account/drop = make_account("econ_test_drop")
	for(var/datum/bank_account/account as anything in list(first, second))
		var/obj/item/card/id/card = allocate(/obj/item/card/id, get_step(thief, EAST))
		card.registered_account = account
		skimmer.melee_attack_chain(thief, card)
	TEST_ASSERT_EQUAL(length(skimmer.stolen), 2, "Скопированы два счёта")
	var/list/data = skimmer.ui_data(thief)
	var/list/stolen = data["stolen"]
	var/list/first_entry = stolen[1]
	var/list/second_entry = stolen[2]
	TEST_ASSERT(data["knows"] && first_entry["number"] == first.account_id && first_entry["left"] == data["rate"], "Предатель видит счета и лимит")
	econ_ui_press(thief, skimmer, "Skimmer", "forget", list("ref" = first_entry["ref"]))
	TEST_ASSERT_EQUAL(length(skimmer.stolen), 1, "Слот стёрт")
	var/rate = SSeconomy.settings.skim_rate
	econ_ui_press(thief, skimmer, "Skimmer", "siphon", list("ref" = second_entry["ref"], "target" = "[drop.account_id]", "amount" = "[rate]"))
	TEST_ASSERT_EQUAL(second.account_balance, 5000 - rate, "Списано со второго счёта после сдвига слотов")
	TEST_ASSERT_EQUAL(drop.account_balance, rate, "Получатель")
	TEST_ASSERT_EQUAL(skimmer.message, "Переведено [rate] кр. на счёт №[drop.account_id].", "Ответ окна")
	econ_ui_press(thief, skimmer, "Skimmer", "siphon", list("ref" = second_entry["ref"], "target" = drop.account_id, "amount" = 1))
	TEST_ASSERT_EQUAL(skimmer.message, "Не больше [rate] кр. в минуту с одного счёта: сейчас можно ещё 0 кр.", "Лимит в минуту")
	econ_ui_press(thief, skimmer, "Skimmer", "siphon", list("ref" = first_entry["ref"], "target" = drop.account_id, "amount" = 1))
	TEST_ASSERT_EQUAL(skimmer.message, "Этого счёта уже нет в памяти скиммера.", "Стёртый слот")
	TEST_ASSERT_EQUAL(first.account_balance, 5000, "Стёртый счёт не тронут")
	var/mob/living/carbon/human/finder = allocate(/mob/living/carbon/human)
	finder.mind_initialize()
	data = skimmer.ui_data(finder)
	TEST_ASSERT(length(data) == 1 && !data["knows"], "Постороннему окно ничего не раскрывает")
	econ_ui_press(finder, skimmer, "Skimmer", "forget", list("ref" = second_entry["ref"]))
	TEST_ASSERT_EQUAL(length(skimmer.stolen), 1, "Посторонний не стирает слот")
	thief.dropItemToGround(skimmer)
	finder.put_in_active_hand(skimmer)
	var/datum/bank_account/third = make_account("econ_test_third", 5000)
	var/obj/item/card/id/third_card = allocate(/obj/item/card/id, get_step(finder, EAST))
	third_card.registered_account = third
	skimmer.melee_attack_chain(finder, third_card)
	var/mob/living/carbon/human/victim = make_victim(third, get_step(finder, EAST))
	skimmer.melee_attack_chain(finder, victim)
	TEST_ASSERT(!LAZYFIND(finder.do_afters, victim), "У постороннего скиммер не считывает человека")
	TEST_ASSERT_EQUAL(length(skimmer.stolen), 1, "У постороннего скиммер не копирует карту")
	TEST_ASSERT(!findtext(jointext(skimmer.examine(finder), "\n"), "скиммер"), "Осмотр не выдаёт назначение")

/// Пейджер из окна: предателю настоящие события очереди со сроком, без фальшивок; постороннему пусто.
/datum/unit_test/economy_trading/insider/pager_ui/Run()
	var/obj/item/insider_pager/pager = allocate(/obj/item/insider_pager)
	var/mob/living/carbon/human/reader = allocate(/mob/living/carbon/human)
	econ_test_traitor(reader)
	reader.put_in_hands(pager)
	SSmarket.schedule_company_event(company, "contract_won", "Настоящее событие", -0.2, STOCK_EVENT_ETA_MIN)
	TEST_ASSERT(SSmarket.fake_press_release(SSmarket.get_company("NKMR"), TRUE), "Релиз не вышел")
	var/list/data = pager.ui_data(reader)
	var/list/events = data["events"]
	TEST_ASSERT(data["knows"] && length(events) == 1, "Пейджер показывает только настоящее событие: [json_encode(events)]")
	var/list/entry = events[1]
	TEST_ASSERT(entry["ticker"] == "AGRO" && entry["effect"] == -20 && !entry["positive"], "Событие: [json_encode(entry)]")
	TEST_ASSERT(abs(entry["eta"] - STOCK_EVENT_ETA_MIN / (1 SECONDS)) <= 1, "Срок выхода: [entry["eta"]]")
	var/mob/living/carbon/human/finder = allocate(/mob/living/carbon/human)
	finder.mind_initialize()
	data = pager.ui_data(finder)
	events = data["events"]
	TEST_ASSERT(!data["knows"] && !length(events) && isnull(data["eta_min"]), "Постороннему пейджер ничего не показывает")
	var/threshold_text = "[SSeconomy.settings.audit_insider_threshold] кр."
	TEST_ASSERT(!findtext(jointext(pager.examine(reader), "\n"), threshold_text), "Осмотр пейджера называет порог аудита")
	var/obj/item/press_release_kit/kit = allocate(/obj/item/press_release_kit)
	TEST_ASSERT(!findtext(jointext(kit.examine(reader), "\n"), threshold_text), "Осмотр релиза называет порог аудита")
