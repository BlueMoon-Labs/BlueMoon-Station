/// Complete one actual queue rotation without editing AP, initiative or counters.
/datum/unit_test/proc/netrun_finish_quiet_round(datum/netrun_combat_encounter/encounter)
	if(QDELETED(encounter) || !encounter.active)
		return FALSE
	var/initial_round = encounter.round
	for(var/attempt in 1 to 16)
		if(QDELETED(encounter) || encounter.round != initial_round)
			return TRUE
		if(!encounter.pass(encounter.current()?.actor()))
			return FALSE
	return QDELETED(encounter) || encounter.round != initial_round

/// Three complete quiet rounds end a fight, not three individual decisions.
/datum/unit_test/netrun_turn_quiet_round_limit/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "Two resident actors start a real native queue")
	var/old_id = encounter.decision_id()
	for(var/decision in 1 to 5)
		TEST_ASSERT(encounter.pass(encounter.current()?.actor()), "A quiet participant may pass its ordinary decision")
		TEST_ASSERT(!QDELETED(encounter), "Fewer than three complete quiet rounds retain the encounter")
	TEST_ASSERT_EQUAL(encounter.round, 3, "Five decisions with two actors have not completed the third round")
	SSnetrun.get_task_scheduler().enqueue("combat_turn", encounter, NETRUN_TASK_CRITICAL)
	var/task_key = "combat_turn:[REF(encounter)]"
	TEST_ASSERT(encounter.pass(second), "The final ordinary pass completes the third quiet round")
	TEST_ASSERT(QDELETED(encounter), "Three complete quiet rounds release the encounter")
	TEST_ASSERT_NULL(encounter.timer_id, "Quiet termination cancels the old decision timer")
	TEST_ASSERT(!SSnetrun.task_scheduler.by_key[task_key], "Quiet termination removes already queued timeout work")
	TEST_ASSERT_NULL(scene.node_a.combat_encounter, "The node no longer advertises the completed fight")
	TEST_ASSERT(!first.console.get_combat_encounter() && !second.console.get_combat_encounter(), "All participants are unbound from the completed initiative")
	TEST_ASSERT(!first.console.pass_combat_turn(old_id), "A browser token from the ended fight cannot pass another turn")
	var/datum/netrun_combat_encounter/restarted = scene.node_a.get_combat_encounter()
	TEST_ASSERT(restarted != encounter && restarted.admit(first, 1, second), "The same live actors can start a fresh encounter later")
	TEST_ASSERT_EQUAL(restarted.remaining_ap(first), NETRUN_COMBAT_AP, "A genuinely ended encounter leaves no inherited turn budget")
	TEST_ASSERT(restarted.decision_id() != old_id, "The new fight has an independent input identity")

/// Letting decisions expire counts the same whole quiet rotations as explicit passes.
/datum/unit_test/netrun_turn_quiet_timeout_limit/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "The timeout fixture starts a native pair")
	for(var/decision in 1 to 6)
		encounter.deadline = world.time
		encounter.expire_turn()
		if(decision < 6)
			TEST_ASSERT(!QDELETED(encounter), "One expired decision cannot count an entire round")
	TEST_ASSERT(QDELETED(encounter), "Six expired decisions complete three quiet two-person rounds")
	TEST_ASSERT(!first.console.get_combat_encounter() && !second.console.get_combat_encounter(), "Timeout termination releases both resident sessions")

/// A successful hostile action restarts the quiet-round count; the active round is excluded.
/datum/unit_test/netrun_turn_quiet_hostile_reset/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "The quiet fixture starts a native pair")
	TEST_ASSERT(netrun_finish_quiet_round(encounter) && netrun_finish_quiet_round(encounter), "The pair completes two quiet rounds")
	TEST_ASSERT_EQUAL(encounter.round, 3, "The next opportunity belongs to the third round")
	var/before = second.integrity
	TEST_ASSERT(first.console.program_use("builtin:sting", REF(second)), "A real owned action is accepted before the third round ends")
	TEST_ASSERT(second.integrity < before, "The resetting hostile action actually delivers its effect")
	TEST_ASSERT(netrun_finish_quiet_round(encounter), "The round containing the attack can finish normally")
	TEST_ASSERT(!QDELETED(encounter) && encounter.round == 4, "The action-containing round does not count as a quiet round")
	TEST_ASSERT(netrun_finish_quiet_round(encounter) && netrun_finish_quiet_round(encounter), "Two later complete quiet rounds remain below the limit")
	TEST_ASSERT(!QDELETED(encounter) && encounter.round == 6, "Earlier quiet history was discarded by genuine hostility")
	TEST_ASSERT(netrun_finish_quiet_round(encounter), "The third later quiet round completes")
	TEST_ASSERT(QDELETED(encounter), "A resumed fight still ends after three subsequent quiet rounds")

/// Self repair and shields spend real AP but cannot hold an otherwise peaceful node in combat.
/datum/unit_test/netrun_turn_quiet_support_and_cleanup/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	first.integrity = 40
	second.integrity = 40
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "The support fixture starts a native pair")
	for(var/quiet_round in 1 to 3)
		for(var/mob/camera/netrun_entity/actor as anything in list(first, second))
			TEST_ASSERT(encounter.has_turn(actor), "Each actor receives an ordinary support turn")
			TEST_ASSERT(actor.console.program_use("builtin:shell", null), "The ordinary shield spends its own action point")
			TEST_ASSERT_EQUAL(actor.combat_shield_until, INFINITY, "The shield is genuinely owned by the combat turn")
			TEST_ASSERT(actor.console.program_use("builtin:mend", null), "The ordinary repair spends its own action point")
			TEST_ASSERT(encounter.pass(actor), "The actor ends its remaining support decision")
		if(quiet_round < 3)
			TEST_ASSERT(!QDELETED(encounter), "Support does not shorten the configured whole-round grace period")
	TEST_ASSERT(QDELETED(encounter), "Shield and repair spam cannot keep a quiet encounter alive forever")
	TEST_ASSERT(first.integrity > 40 && second.integrity > 40, "Both parties actually completed their harmless repairs")
	TEST_ASSERT(first.combat_shield_until <= world.time && second.combat_shield_until <= world.time, "Ending a quiet encounter releases both turn-owned shield sentinels")
	TEST_ASSERT(!first.console.get_combat_encounter() && !second.console.get_combat_encounter(), "Support effects leave no stale initiative binding")

/// Joining, rejected attacks and a native retreat do not reset the quiet history.
/datum/unit_test/netrun_turn_quiet_join_reject_and_retreat/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/observer = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	observer.console.access_session.grant_node(scene.apc_node, NETRUN_ACCESS_USER)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "The quiet fixture starts without enrolling its observer")
	TEST_ASSERT(netrun_finish_quiet_round(encounter) && netrun_finish_quiet_round(encounter), "Two complete quiet rounds elapse before the observer intervenes")
	TEST_ASSERT(observer.console.join_combat_turn(encounter.decision_id()), "The local observer joins initiative without needing to be attacked")
	TEST_ASSERT(!observer.console.join_combat_turn(encounter.decision_id()), "A duplicate join is rejected rather than extending the fight")
	TEST_ASSERT(!first.console.program_use("builtin:unknown", REF(second)), "A rejected executable cannot fabricate hostile activity")
	TEST_ASSERT(encounter.spend(first, 1), "An ordinary non-program action may still spend AP")
	TEST_ASSERT(!first.console.program_use("builtin:surge", REF(second)), "An unaffordable hostile launch cannot reset the quiet rounds")
	TEST_ASSERT(encounter.pass(first), "The first peaceful resident yields its remaining budget")
	TEST_ASSERT(!encounter.commit_program(first, SSnetrun.get_program("sting")), "An off-turn native hostile commit is rejected without activity")
	TEST_ASSERT(encounter.pass(second), "The second peaceful resident yields to the newly joined observer")
	TEST_ASSERT(encounter.has_turn(observer), "The observer gets an ordinary turn at the queue tail")
	TEST_ASSERT(observer.hop(scene.apc_node), "The observer leaves through the same authorized one-point hop as a player")
	TEST_ASSERT_EQUAL(observer.host_node, scene.apc_node, "The movement really leaves the combat node")
	TEST_ASSERT(QDELETED(encounter), "Joining, failed actions, AP spending and retreat do not replace actual hostility")
	TEST_ASSERT(!first.console.get_combat_encounter() && !second.console.get_combat_encounter(), "The remaining residents are released after their third quiet round")

/// An admitted hostile telegraph is combat activity even when cancelled before damage.
/datum/unit_test/netrun_turn_quiet_hostile_telegraph/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_ice/ice = allocate(/datum/netrun_ice, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(entity, 1, ice), "The native actor pair starts without an executed attack")
	TEST_ASSERT(netrun_finish_quiet_round(encounter) && netrun_finish_quiet_round(encounter), "The first two rotations are peaceful")
	TEST_ASSERT(encounter.pass(entity), "The resident gives the guard its next real turn")
	TEST_ASSERT(ice.register_enemy(entity.console), "The resident provokes legal native ICE targeting")
	var/before = entity.integrity
	TEST_ASSERT(ice.begin_program(SSnetrun.get_program("strike"), entity), "The guard commits an owned hostile program through native admission")
	TEST_ASSERT(ice.pending_program && encounter.deferred, "The accepted hostile program really owns its telegraph and turn lock")
	ice.cancel_program()
	TEST_ASSERT_EQUAL(entity.integrity, before, "Cancelling the accepted program still prevents its damage")
	TEST_ASSERT(encounter.pass(ice), "The cancelled telegraph's action-containing round can finish")
	TEST_ASSERT(!QDELETED(encounter) && encounter.round == 4, "An accepted hostile cast resets earlier quiet history even after cancellation")
	TEST_ASSERT(netrun_finish_quiet_round(encounter) && netrun_finish_quiet_round(encounter), "Two subsequent quiet rounds are permitted")
	TEST_ASSERT(!QDELETED(encounter), "The accepted hostile telegraph was not treated as a rejected launch")
	TEST_ASSERT(netrun_finish_quiet_round(encounter), "The third later quiet round completes")
	TEST_ASSERT(QDELETED(encounter) && !ice.pending_program && !ice.get_combat_encounter(), "Quiet termination also releases a lightweight actor and its cast binding")
