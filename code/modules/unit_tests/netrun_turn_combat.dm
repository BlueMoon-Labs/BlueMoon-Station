/// Physical source changes and native firewall revocation cannot leave a stale remote lease.
/datum/unit_test/netrun_turn_remote_resident_revocation/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	TEST_ASSERT(entity.console.store_file(scene.key_file()), "The fixture has a real route for a remote breach")
	var/datum/netrun_ice/ice = allocate(/datum/netrun_ice, scene.node_b, NETRUN_ICE_SENTRY)
	ice.program_ids = list("trace")
	TEST_ASSERT(entity.console.start_breach("node", scene.node_b.address), "The remote attempt is admitted through the native protocol")
	TEST_ASSERT(ice.begin_program(SSnetrun.get_program("trace"), entity.console), "The guard starts a real prepared countertrace")
	var/datum/netrun_combat_encounter/encounter = ice.get_combat_encounter()
	entity.enter_node(scene.apc_node)
