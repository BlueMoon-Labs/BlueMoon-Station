	first.apply_shield(shield.power, 5 SECONDS)
	encounter.apply_program_status(shield, first)
	TEST_ASSERT_EQUAL(first.combat_shield_until, INFINITY, "A turn-owned shield cannot expire during a decision countdown")
	encounter.pass(first)
	TEST_ASSERT_EQUAL(first.combat_shield_until, INFINITY, "The shield protects throughout the opponent's turn")
	encounter.pass(second)
	TEST_ASSERT(first.combat_shield_until <= world.time, "The shield expires at the next own turn")
	var/datum/netrun_program/stun = SSnetrun.get_program("blackout")
