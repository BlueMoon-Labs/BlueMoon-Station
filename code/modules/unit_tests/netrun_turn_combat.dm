	encounter.pass(first)
	TEST_ASSERT(encounter.has_turn(second) && !encounter.can_apply_program_status(stun, second), "Stun resistance lasts through a real opportunity to act")
	encounter.pass(second)
	TEST_ASSERT(encounter.can_apply_program_status(stun, second), "Finishing a real turn releases temporary stun resistance")

