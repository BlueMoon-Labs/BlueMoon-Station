	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "Two real participants start the local queue")
	var/id = encounter.decision_id()
	var/list/payload = encounter.payload(observer.console)
	TEST_ASSERT(!payload["participating"] && payload["can_join"], "A local spectator receives an explicit join affordance")
	TEST_ASSERT(!remote.console.join_combat_turn(id), "Knowing another encounter token grants no remote combat contact")
	encounter.pass(first)
	TEST_ASSERT(!observer.console.join_combat_turn("[encounter.serial + 1]:1"), "A token from another encounter cannot enroll a spectator")
	var/access_before = observer.console.node_level(scene.node_a)
	TEST_ASSERT(observer.console.join_combat_turn(id), "A delayed spectator click survives a turn rotation in the same encounter")
	TEST_ASSERT(encounter.has_turn(second) && encounter.is_waiting(observer), "Joining preserves the current actor and waits at the queue tail")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(second), NETRUN_COMBAT_AP, "Joining spends none of the current actor's AP")
	TEST_ASSERT_EQUAL(observer.console.node_level(scene.node_a), access_before, "Joining grants no machine access")
	TEST_ASSERT_EQUAL(length(encounter.participants), 3, "Only the requesting native actor is enrolled")
	TEST_ASSERT(!observer.console.join_combat_turn(encounter.decision_id()), "Repeated joins cannot duplicate queue entries")
	encounter.pass(second)
	TEST_ASSERT(encounter.has_turn(observer), "The third party receives its first actionable turn in queue order")
	qdel(second)
	TEST_ASSERT(encounter.has_turn(observer), "Deleting an earlier noncurrent participant cannot skip the current actor")
	first.leave_node()
	TEST_ASSERT(QDELETED(encounter) && !observer.console.get_combat_encounter(), "The last remaining actor leaves no singleton combat lock")

/// The sole decision deadline admits bounded worker work; movement/deletion release it.
/datum/unit_test/netrun_turn_deadline_and_departure/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	encounter.admit(first, 1, second)
	TEST_ASSERT(encounter.timer_id, "An active encounter owns one decision timer")
	deltimer(encounter.timer_id)
	encounter.deadline = world.time
	encounter.on_timeout(encounter.generation)
	TEST_ASSERT_EQUAL(encounter.current(), encounter.member(first), "The timer callback cannot execute combat or advance the queue inline")
	TEST_ASSERT(!encounter.has_turn(first), "The old actor's authority already expires before the worker advances the queue")
	SSnetrun.get_task_scheduler().cancel("combat_turn", encounter)
	var/datum/controller/subsystem/netrun/netrun_execution_test/worker = allocate(/datum/controller/subsystem/netrun/netrun_execution_test)
	worker.next_task_population = INFINITY
	worker.get_task_scheduler().enqueue("combat_turn", encounter, NETRUN_TASK_CRITICAL)
	worker.run_pass()
	TEST_ASSERT(encounter.has_turn(second), "The worker applies one expired decision")
	first.enter_node(scene.node_b)
	TEST_ASSERT(QDELETED(encounter) && !encounter.timer_id, "Leaving the last opponent ends the encounter and cancels its timer")
	TEST_ASSERT_NULL(second.console.get_combat_encounter(), "The remaining actor has no stale encounter binding")
	first.enter_node(scene.node_a)
	encounter = scene.node_a.get_combat_encounter()
	encounter.admit(first, 1, second)
	qdel(scene.node_a.parent)
	TEST_ASSERT(QDELETED(encounter) && !encounter.timer_id, "Host destruction releases the encounter before occupants migrate")

/// Shields survive thinking time; stun skips a turn and cannot chain-lock a victim forever.
