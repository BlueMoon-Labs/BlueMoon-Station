	TEST_ASSERT_EQUAL(encounter.remaining_ap(ice), ap_after_launch, "Checking an unresolved cast does not spend AP again")
	ice.attack_at = world.time
	ice.resolve_program()
	TEST_ASSERT(entity.integrity < health_before && !encounter.deferred, "The accepted native cast resolves before its turn unlocks")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(ice), ap_after_launch, "Resolution itself consumes no additional AP")
	SSnetrun.get_task_scheduler().cancel("ice", ice)
	ice.process_ai(0)
	TEST_ASSERT(encounter.has_turn(entity), "ICE with no affordable program passes instead of polling")

