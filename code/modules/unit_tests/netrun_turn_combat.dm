	encounter = ice.get_combat_encounter()
	var/datum/netrun_turn_participant/participant = encounter.member(entity)
	scene.node_b.raise_firewall()
	TEST_ASSERT(!participant.valid(), "The next authority read processes native firewall revocation and rejects the old lease")
	TEST_ASSERT(QDELETED(encounter) && !entity.console.intrusion.breach && !ice.pending_program, "Firewall cancellation releases the exact breach, controller and prepared countertrace")

/// Entering initiative is bound to the battle, not to a fast NPC's current decision.
/datum/unit_test/netrun_turn_spectator_join_identity/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/observer = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "The native local battle starts")
	var/list/payload = encounter.payload(observer.console)
	var/join_id = payload["join_id"]
	var/decision_id = payload["id"]
	TEST_ASSERT(istext(join_id) && length(join_id), "The UI receives a stable battle admission token")
	TEST_ASSERT(encounter.pass(first) && encounter.pass(second), "A complete round can rotate before the observer clicks")
	TEST_ASSERT_EQUAL(encounter.payload(observer.console)["join_id"], join_id, "Queue rotations preserve the battle admission identity")
	encounter.deadline = world.time
	TEST_ASSERT(observer.console.join_combat_turn(join_id), "A queued decision timeout rotates but does not reject admission to the surviving battle")
	TEST_ASSERT(encounter.has_turn(second) && encounter.is_waiting(observer), "The new participant waits without stealing the expired actor's successor turn")
	qdel(encounter)
	encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "A new independent battle starts on the same node")
	TEST_ASSERT(!observer.console.join_combat_turn(join_id), "A previous battle's stable token cannot enroll in its replacement")
	TEST_ASSERT(!observer.console.join_combat_turn(decision_id), "A previous battle's decision token cannot enroll in its replacement")
	TEST_ASSERT(observer.console.join_combat_turn(encounter.join_id()), "A current battle token admits the same local observer")
