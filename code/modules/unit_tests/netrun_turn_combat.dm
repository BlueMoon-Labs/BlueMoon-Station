/// Validation never consumes AP, and program cooldowns count the actor's own turns.
/datum/unit_test/netrun_turn_queue_and_costs/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first.console, 2, second), "A validated pair starts a local encounter")
	TEST_ASSERT(encounter.has_turn(first) && encounter.is_waiting(second), "The initiator acts first and the opponent waits")
	TEST_ASSERT(!encounter.admit(second, 1, first), "An off-turn participant cannot admit an action")
	TEST_ASSERT(!encounter.admit(first, -1, second), "A negative cost cannot mint AP")
	TEST_ASSERT(!encounter.spend(first, 0.5), "Fractional AP is not accepted")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(first), NETRUN_COMBAT_AP, "Rejected actions leave the full budget")
	var/datum/netrun_program/program = allocate(/datum/netrun_program)
	program.id = "turn-test"
	program.ap_cost = 2
	program.cooldown_turns = 2
	var/decision_deadline = encounter.deadline
	TEST_ASSERT(encounter.commit_program(first, program, TRUE), "A real accepted program reserves its AP once")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(first), 1, "A two-point program consumes two of three AP")
	TEST_ASSERT(encounter.is_waiting(first) && !encounter.pass(first), "An unresolved action locks its own turn")
	encounter.resolve(first)
	TEST_ASSERT(encounter.has_turn(first) && !encounter.is_waiting(first), "Resolution retains a turn with AP left")
	TEST_ASSERT_EQUAL(encounter.deadline, decision_deadline, "Taking actions does not extend the decision deadline")
	TEST_ASSERT(!encounter.admit(first, 2, second), "An unaffordable action rejects before a second commit")
	TEST_ASSERT(encounter.pass(first) && encounter.has_turn(second), "An explicit pass advances one queue entry")
	encounter.pass(second)
	TEST_ASSERT_EQUAL(encounter.cooldown_remaining(first, program), 1, "One own turn advances one cooldown step")
	encounter.pass(first)
	encounter.pass(second)
	TEST_ASSERT_EQUAL(encounter.cooldown_remaining(first, program), 0, "A later own turn makes the executable ready")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(first), NETRUN_COMBAT_AP, "Each new turn replenishes exactly one actor")

/// Old browser messages cannot pass or attack on a later decision, even after recreation.
/datum/unit_test/netrun_turn_input_identity/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/datum/netrun_combat_encounter/encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "A native pair starts the decision")
	var/old_id = encounter.decision_id()
	TEST_ASSERT(first.console.pass_combat_turn(old_id), "The exact current decision can be passed")
	TEST_ASSERT(second.console.pass_combat_turn(encounter.decision_id()), "The opponent passes its own exact decision")
	var/new_id = encounter.decision_id()
	var/health = second.integrity
	var/trace = first.console.intrusion.trace
	TEST_ASSERT(new_id != old_id && encounter.has_turn(first), "The same actor's next decision has a different identity")
	TEST_ASSERT(!first.console.pass_combat_turn(old_id), "An old pass cannot end the later own turn")
	TEST_ASSERT(!first.console.program_use("builtin:sting", REF(second), old_id), "An old launch cannot consume a later own turn")
	TEST_ASSERT(!first.console.program_use("builtin:sting", REF(second), 42), "A malformed non-text token is not an omitted native argument")
	TEST_ASSERT_EQUAL(second.integrity, health, "Stale messages cause no damage")
	TEST_ASSERT_EQUAL(first.console.intrusion.trace, trace, "Stale messages add no trace")
	TEST_ASSERT_EQUAL(encounter.remaining_ap(first), NETRUN_COMBAT_AP, "Stale messages spend no current AP")
	TEST_ASSERT_NULL(first.console.combat_context.program_cd["sting"], "A rejected old launch spends no native cooldown")
	TEST_ASSERT(first.console.program_use("builtin:sting", REF(second), new_id), "The live browser decision still executes the native program")
	TEST_ASSERT_EQUAL(encounter.decision_id(), new_id, "AP updates retain the same deadline identity")
	qdel(encounter)
	first.console.combat_context.next_program = 0
	TEST_ASSERT(!first.console.program_use("builtin:sting", REF(second), new_id), "An old encounter token cannot create a new fight")
	TEST_ASSERT_NULL(scene.node_a.combat_encounter, "Rejected stale input creates no controller or participant")
	encounter = scene.node_a.get_combat_encounter()
	TEST_ASSERT(encounter.admit(first, 1, second), "An ordinary fresh encounter still starts")
	TEST_ASSERT(encounter.decision_id() != old_id, "Recreated encounters never reuse the first decision identity")

/// Joining is explicit, native-contact scoped, and never steals the current budget.
/datum/unit_test/netrun_turn_spectator_join/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
