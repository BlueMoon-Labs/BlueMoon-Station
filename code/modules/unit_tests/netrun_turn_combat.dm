	TEST_ASSERT(!ice.combat_encounter_ref && !entity.console.combat_encounter_ref, "Destruction clears exact weak bindings even though resolve hides the dying controller")
	qdel(ice)
	entity.enter_node(scene.node_a)
	ice = allocate(/datum/netrun_ice, scene.node_b, NETRUN_ICE_SENTRY)
	ice.program_ids = list("trace")
