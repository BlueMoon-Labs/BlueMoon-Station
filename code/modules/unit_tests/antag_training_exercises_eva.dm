/datum/unit_test/proc/drill_suit_up(mob/living/carbon/human/user, obj/item/tank/jetpack/jetpack)
	if(user.back)
		user.dropItemToGround(user.back)
	var/obj/item/clothing/suit/space/suit = allocate(/obj/item/clothing/suit/space, get_turf(user))
	var/obj/item/clothing/head/helmet/space/helmet = allocate(/obj/item/clothing/head/helmet/space, get_turf(user))
	user.equip_to_slot_if_possible(suit, ITEM_SLOT_OCLOTHING, FALSE, TRUE, TRUE, TRUE)
	user.equip_to_slot_if_possible(helmet, ITEM_SLOT_HEAD, FALSE, TRUE, TRUE, TRUE)
	user.equip_to_slot_if_possible(jetpack, ITEM_SLOT_BACK, FALSE, TRUE, TRUE, TRUE)
	var/datum/action/item_action/set_internals/valve = locate() in jetpack.actions
	valve?.Trigger()
	return user.wear_suit == suit && user.head == helmet && user.back == jetpack && user.internal == jetpack

/datum/unit_test/proc/drill_wear_jetpack(mob/living/carbon/human/user, obj/item/tank/jetpack/jetpack)
	user.equip_to_slot_if_possible(jetpack, ITEM_SLOT_BACK, FALSE, TRUE, TRUE, TRUE)
	var/datum/action/item_action/set_internals/valve = locate() in jetpack.actions
	if(user.internal != jetpack)
		valve?.Trigger()
	return user.back == jetpack && user.internal == jetpack

/datum/unit_test/proc/drill_open_space(datum/antag_training_sector/sector)
	for(var/turf/open/space/tile in sector.turfs)
		if(!(locate(/obj) in tile))
			return tile

/// «До форпоста»: маяк в точке цели сектора EVA, скафандр с джетпаком, выход в космос и маяк завершают упражнение; включённые магнитные ботинки проваливают повтор.
/datum/unit_test/antag_training_exercise_eva_outpost/Run()
	var/datum/antag_training_session/session = allocate_training_session(/datum/antag_training_program/free)
	TEST_ASSERT(session.prepare(), "Полигон должен подготовиться.")
	var/mob/living/carbon/human/user = session.current_body
	var/datum/tgui/ui = allocate(/datum/tgui, user, session, "AntagTraining")
	var/datum/antag_training_sector/sector = enter_training_sector(session, ui, "eva")
	TEST_ASSERT_EQUAL(session.arena.match_zone(user), "eva", "Участник в секторе EVA.")
	var/datum/antag_training_exercise_run/run = start_training_drill(session, ui, "eva_outpost")
	TEST_ASSERT_NOTNULL(run, "Упражнение стартует в секторе EVA.")
	var/obj/effect/antag_training_beacon/beacon = run.find_prop(/obj/effect/antag_training_beacon)
	TEST_ASSERT_EQUAL(get_turf(beacon), sector.target_turf(), "Маяк стоит в точке цели форпоста.")

	var/obj/item/tank/jetpack/oxygen/jetpack = allocate(/obj/item/tank/jetpack/oxygen, get_turf(user))
	TEST_ASSERT(drill_suit_up(user, jetpack), "Участник в скафандре, шлеме и с джетпаком, подача воздуха открыта.")
	user.forceMove(antag_training_free_step(user))
	TEST_ASSERT_EQUAL(run.step_index, 2, "Снаряжение засчитано.")
	var/turf/open/space/outside = drill_open_space(sector)
	TEST_ASSERT_NOTNULL(outside, "В секторе есть открытый космос.")
	user.forceMove(outside)
	TEST_ASSERT_EQUAL(run.step_index, 3, "Выход в космос засчитан.")
	user.forceMove(get_turf(beacon))
	TEST_ASSERT(run.ended && run.success, "Маяк в форпосте завершает упражнение: [run.result_text]")

	user.forceMove(sector.spawn_turf())
	run = start_training_drill(session, ui, "eva_outpost")
	TEST_ASSERT_NOTNULL(run, "Повтор стартует.")
	var/obj/item/clothing/shoes/magboots/magboots = allocate(/obj/item/clothing/shoes/magboots, get_turf(user))
	if(user.shoes)
		user.dropItemToGround(user.shoes)
	user.equip_to_slot_if_possible(magboots, ITEM_SLOT_FEET, FALSE, TRUE, TRUE, TRUE)
	magboots.attack_self(user)
	TEST_ASSERT(user.shoes == magboots && magboots.magpulse, "Магнитные ботинки включены.")
	user.forceMove(antag_training_free_step(user))
	TEST_ASSERT(run.ended && !run.success && findtext(run.result_text, "магнитные ботинки"), "Включённые магнитные ботинки проваливают упражнение.")

/// «Возврат на остатке»: выданный джетпак с малым запасом, маяк в космосе и шлюзовая камера; камера завершает упражнение, остановка в космосе переносит к входу, из космоса упражнение не начинается, пустой баллон проваливает повтор.
/datum/unit_test/antag_training_exercise_eva_reserve/Run()
	var/datum/antag_training_session/session = allocate_training_session(/datum/antag_training_program/free)
	TEST_ASSERT(session.prepare(), "Полигон должен подготовиться.")
	var/mob/living/carbon/human/user = session.current_body
	var/datum/tgui/ui = allocate(/datum/tgui, user, session, "AntagTraining")
	var/datum/antag_training_sector/sector = enter_training_sector(session, ui, "eva")
	var/datum/antag_training_exercise_run/run = start_training_drill(session, ui, "eva_reserve")
	TEST_ASSERT_NOTNULL(run, "Упражнение стартует в секторе EVA.")
	var/obj/item/tank/jetpack/oxygen/antag_training_reserve/jetpack = run.find_prop(/obj/item/tank/jetpack/oxygen/antag_training_reserve)
	TEST_ASSERT_NOTNULL(jetpack, "Выдан джетпак с малым запасом.")
	TEST_ASSERT_EQUAL(get_turf(jetpack), get_turf(user), "Джетпак лежит у ног участника.")
	var/obj/item/tank/jetpack/oxygen/full = allocate(/obj/item/tank/jetpack/oxygen)
	TEST_ASSERT(jetpack.air_contents.total_moles() < full.air_contents.total_moles() / 10, "Запас выданного джетпака мал.")
	var/obj/effect/antag_training_beacon/beacon = run.find_prop(/obj/effect/antag_training_beacon)
	TEST_ASSERT(isspaceturf(get_turf(beacon)), "Маяк висит в открытом космосе.")
	var/datum/antag_training_exercise_step/drill/eva/chamber/return_step = run.steps[3]
	TEST_ASSERT(length(return_step.chamber), "Шлюзовая камера у входа найдена.")
	for(var/turf/tile as anything in return_step.chamber)
		TEST_ASSERT(isopenturf(tile) && !(locate(/obj/machinery/door) in tile), "Камера шлюза - клетки между дверями.")

	TEST_ASSERT(drill_suit_up(user, jetpack), "Участник надел выданный джетпак и дышит из него.")
	user.forceMove(antag_training_free_step(user))
	TEST_ASSERT_EQUAL(run.step_index, 2, "Снаряжение засчитано.")
	user.forceMove(get_turf(beacon))
	TEST_ASSERT_EQUAL(run.step_index, 3, "Маяк засчитан.")
	user.forceMove(return_step.chamber[1])
	TEST_ASSERT(run.ended && run.success, "Шлюзовая камера завершает упражнение: [run.result_text]")

	user.forceMove(sector.spawn_turf())
	run = start_training_drill(session, ui, "eva_reserve")
	TEST_ASSERT_NOTNULL(run, "Повтор стартует.")
	TEST_ASSERT(QDELETED(jetpack) && !user.back, "Повтор забирает прежний учебный джетпак.")
	jetpack = run.find_prop(/obj/item/tank/jetpack/oxygen/antag_training_reserve)
	beacon = run.find_prop(/obj/effect/antag_training_beacon)
	TEST_ASSERT(drill_wear_jetpack(user, jetpack), "Участник надел новый учебный джетпак.")
	user.forceMove(get_turf(beacon))
	TEST_ASSERT(isspaceturf(get_turf(user)), "Участник в космосе на выданном джетпаке.")
	antag_training_console_act(session, ui, "exercise_stop", list())
	TEST_ASSERT(QDELETED(run) && QDELETED(jetpack), "«Прекратить» убирает прогон и джетпак.")
	TEST_ASSERT_EQUAL(get_turf(user), sector.spawn_turf(), "Без выданного джетпака участника переносит из космоса к входу.")

	var/turf/open/space/outside = drill_open_space(sector)
	TEST_ASSERT_NOTNULL(outside, "В секторе есть открытый космос.")
	user.forceMove(outside)
	TEST_ASSERT_NULL(start_training_drill(session, ui, "eva_reserve"), "Из космоса упражнение не начинается.")
	TEST_ASSERT(findtext(session.last_feedback, "воздух"), "Пульт объясняет отказ: [session.last_feedback]")

	user.forceMove(sector.spawn_turf())
	run = start_training_drill(session, ui, "eva_reserve")
	TEST_ASSERT_NOTNULL(run, "Повтор у входа стартует.")
	jetpack = run.find_prop(/obj/item/tank/jetpack/oxygen/antag_training_reserve)
	beacon = run.find_prop(/obj/effect/antag_training_beacon)
	TEST_ASSERT(drill_wear_jetpack(user, jetpack), "Участник надел учебный джетпак повтора.")
	user.forceMove(antag_training_free_step(user))
	TEST_ASSERT_EQUAL(run.step_index, 2, "Снаряжение повтора засчитано.")
	jetpack.air_contents.remove(jetpack.air_contents.total_moles())
	user.forceMove(get_turf(beacon))
	TEST_ASSERT(run.ended && !run.success && findtext(run.result_text, "газ"), "Пустой джетпак проваливает упражнение.")
