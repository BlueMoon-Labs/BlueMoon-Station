/// A real inserted ID is copied independently; machine requirements and empty slots are not credentials.
/datum/unit_test/netrun_credentials_native_slot_snapshot/Run()
	var/obj/item/modular_computer/laptop/computer = allocate(/obj/item/modular_computer/laptop)
	computer.enabled = TRUE
	var/obj/item/computer_hardware/card_slot/slot = computer.get_modular_computer_part(MC_CARD)
	if(!slot)
		slot = allocate(/obj/item/computer_hardware/card_slot)
		// Native installation returns no success value; verify the resulting ownership.
		computer.install_component(slot)
	TEST_ASSERT_EQUAL(computer.get_modular_computer_part(MC_CARD), slot, "The native card slot must be installed in the actual primary bay")
	TEST_ASSERT_EQUAL(slot.holder, computer, "The native card slot must belong to its actual host computer")
	var/obj/item/card/id/card = allocate(/obj/item/card/id)
	card.access = list(ACCESS_MEDICAL, ACCESS_RD)
	TEST_ASSERT(slot.try_insert(card), "A real ID must enter the native RFID slot")
	var/datum/component/netrun_node/node = computer.GetComponent(/datum/component/netrun_node)
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity)
	entity.enter_node(node)
	entity.console.operator = entity
	var/datum/netrun_command/command = SSnetrun.get_command("extract_credentials")
	TEST_ASSERT_NOTNULL(command, "The credential extraction command must be registered")
	TEST_ASSERT("extract_credentials" in node.all_command_ids(), "An occupied native slot must publish credential extraction")
	TEST_ASSERT(!entity.console.do_command(node, command, command.id, TRUE, node.network, entity, "none"), "A traversal connection alone must not satisfy ROOT extraction")
	entity.console.access_session.node_access[node.address] = NETRUN_ACCESS_ROOT
	TEST_ASSERT(entity.console.do_command(node, command, command.id, TRUE, node.network, entity, "none"), "A ROOT request must copy actual inserted ID credentials")
	var/datum/netrun_file/access/file = entity.console.selected_local_file(NETRUN_FILE_ACCESS)
	TEST_ASSERT(istype(file), "Extraction must save a real access file with independent ownership")
	TEST_ASSERT(ACCESS_MEDICAL in entity.console.user_access(TRUE), "A resident process must use its saved native ID access")
	card.access += ACCESS_SECURITY
	TEST_ASSERT(!(ACCESS_SECURITY in file.accesses), "Changing the original ID must not mutate an already stolen credential snapshot")
	var/datum/netrun_file/access/copied = file.copy()
	allocated += copied
	copied.accesses += ACCESS_CARGO
	TEST_ASSERT(!(ACCESS_CARGO in file.accesses), "Copying a credential file must not share its access list")
	TEST_ASSERT(slot.try_eject(forced = TRUE), "The actual ID must leave the native slot")
	TEST_ASSERT(!("extract_credentials" in node.all_command_ids()), "An empty card slot must stop advertising stored credentials")
	var/files_before = length(entity.console.inventory.local_store.files)
	command.execute(node, entity.console)
	TEST_ASSERT_EQUAL(length(entity.console.inventory.local_store.files), files_before, "An ID removed before execution must not generate phantom credentials")
	var/obj/item/protected = allocate(/obj/item)
	var/datum/component/netrun_node/protected_node = protected.AddComponent(/datum/component/netrun_node, NETRUN_NODE_TERMINAL, list(), 2, list(ACCESS_RD))
	TEST_ASSERT_NULL(protected.netrun_credential_access(), "A machine's required access must not be treated as stored credentials")
	entity.enter_node(protected_node)
	TEST_ASSERT_EQUAL(entity.console.node_level(protected_node), NETRUN_ACCESS_USER, "Copied RD credentials must satisfy a real matching node requirement")
	protected.req_access = list(ACCESS_RD)
	TEST_ASSERT(protected.allowed(entity), "Native allowed() must accept actual saved credentials without a fake ID or blanket silicon rights")
	entity.console.delete_local_file(file)
	TEST_ASSERT(!(ACCESS_RD in entity.console.user_access(TRUE)), "Deleting the only credential file must revoke its active ID accesses immediately")
	TEST_ASSERT_EQUAL(entity.console.node_level(protected_node), NETRUN_ACCESS_GUEST, "A removed credential must no longer authorize USER machine actions")
	TEST_ASSERT(!protected.allowed(entity), "Deleting credentials must also revoke native machine ID authorization")

/// Wearable IDs and neural display carriers expose real card data, with no blanket silicon rights.
/datum/unit_test/netrun_credentials_carbon_and_neural/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	TEST_ASSERT(user.equip_to_slot_if_possible(uniform, ITEM_SLOT_ICLOTHING, disable_warning = TRUE), "The native ID slot requires a real worn uniform")
	var/obj/item/card/id/card = allocate(/obj/item/card/id)
	card.access = list(ACCESS_MEDICAL)
	TEST_ASSERT(user.equip_to_slot_if_possible(card, ITEM_SLOT_ID, disable_warning = TRUE), "The ID must be worn through the actual equipment system")
	var/datum/component/neural_interface/interface = user.LoadComponent(/datum/component/neural_interface)
	interface.AddSource("NETRUN_CREDENTIAL_TEST")
	var/datum/component/netrun_neural_adapter/adapter = interface.GetComponent(/datum/component/netrun_neural_adapter)
	var/list/carbon_access = user.netrun_credential_access()
	var/list/neural_access = adapter.endpoint.netrun_credential_access()
	TEST_ASSERT(ACCESS_MEDICAL in carbon_access, "The carbon source must expose its actual worn ID")
	TEST_ASSERT_EQUAL(json_encode(carbon_access), json_encode(neural_access), "The neural endpoint must expose the same actual carrier credentials")
	TEST_ASSERT(!(ACCESS_NETWORK in neural_access), "A neural display must not invent station administrator credentials")
	TEST_ASSERT(user.dropItemToGround(card), "The ID must be removed from its worn slot")
	TEST_ASSERT_EQUAL(length(adapter.endpoint.netrun_credential_access()), 0, "Removing the actual ID must empty the live neural source")

/// Species teardown can recreate a neural endpoint after the mob's inventory was disposed.
/datum/unit_test/netrun_credentials_neural_owner_teardown/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	user.set_species(/datum/species/ipc/hk/hk47)
	var/datum/component/neural_interface/interface = user.LoadComponent(/datum/component/neural_interface)
	interface.AddSource("NETRUN_TEARDOWN_TEST")
	var/datum/component/netrun_neural_adapter/adapter = interface.GetComponent(/datum/component/netrun_neural_adapter)
	TEST_ASSERT_NOTNULL(adapter?.endpoint, "The live wearer must have a real neural endpoint before deletion")
	qdel(user)
	TEST_ASSERT(QDELETED(user), "Deleting the wearer with a neural interface must complete without an inventory runtime")

/// Credentials consume actual memory and survive shard transfer through an independent copy.
/datum/unit_test/netrun_credentials_memory_and_copy/Run()
	var/mob/camera/netrun_entity/entity = allocate(/mob/camera/netrun_entity)
	var/list/accesses = list(ACCESS_MEDICAL, ACCESS_RD, ACCESS_SECURITY, ACCESS_CARGO, ACCESS_ENGINE, ACCESS_ENGINE_EQUIP, ACCESS_MAINT_TUNNELS, ACCESS_HEADS, ACCESS_CHEMISTRY, ACCESS_TOX, ACCESS_ROBOTICS)
	var/datum/netrun_file/access/file = new("crew.access", accesses)
	TEST_ASSERT_EQUAL(file.size, 2, "Eleven real access IDs must occupy two memory cells")
	entity.console.inventory.local_store.capacity = 1
	TEST_ASSERT(!entity.console.store_file(file), "Credentials must obey the same capacity checks as other files")
	entity.console.inventory.local_store.capacity = 2
	TEST_ASSERT(entity.console.store_file(file), "A credential file must fit exactly in its required memory")
	var/obj/item/netrun_shard/shard = allocate(/obj/item/netrun_shard)
	entity.console.inventory.shard = shard
	TEST_ASSERT(entity.console.transfer_local_file(file, TRUE, TRUE), "Moving credentials to an attached shard must preserve access availability")
	TEST_ASSERT(ACCESS_ROBOTICS in entity.console.user_access(TRUE), "A resident process must also read credentials from its attached shard")
	entity.console.inventory.shard = null
	TEST_ASSERT_EQUAL(length(entity.console.user_access(TRUE)), 0, "Detaching the only credential shard must immediately remove its authorizations")

/// A LAN key permits adjacent movement, while USER machine actions still require separate credentials.
/datum/unit_test/netrun_key_traversal_without_machine_access/Run()
	var/turf/origin = run_loc_floor_bottom_left
	var/datum/netrun_route_scene/scene = allocate(/datum/netrun_route_scene, origin.z)
	var/area/room = scene.room(/area/engineering/netrun_route_test)
	scene.take(origin, room)
	var/turf/apc_spot = scene.take(get_step(origin, NORTH), room)
	var/turf/target_spot = scene.take(get_step(origin, EAST), room)
	var/obj/machinery/power/apc/apc = scene.machine(/obj/machinery/power/apc, apc_spot)
	var/obj/machinery/computer/netrun_terminal/source = scene.machine(/obj/machinery/computer/netrun_terminal, origin)
	var/obj/item/target = allocate(/obj/item, target_spot)
	target.req_access = list(ACCESS_RD)
	var/datum/component/netrun_node/target_node = target.AddComponent(/datum/component/netrun_node, NETRUN_NODE_TERMINAL, list(), 2, list(ACCESS_RD))
	target.AddComponent(/datum/component/techweb_holder)
	SSnetrun.ensure_topology()
	var/datum/component/netrun_node/source_node = source.GetComponent(/datum/component/netrun_node)
	var/datum/component/netrun_node/apc_node = apc.GetComponent(/datum/component/netrun_node)
	var/mob/camera/netrun_entity/entity = new(origin, source_node)
	scene.owned.Insert(1, entity)
	entity.console.operator = entity
	TEST_ASSERT(entity.console.store_file(new /datum/netrun_file("local.key", NETRUN_FILE_KEY, apc_node.network.passcode, 1, apc_node.network.id)), "The LAN traversal key must fit in memory")
	TEST_ASSERT_EQUAL(entity.console.node_level(target_node), NETRUN_ACCESS_GUEST, "A LAN key must not grant USER on an arbitrary machine")
	TEST_ASSERT(entity.can_enter(apc_node), "A LAN key must allow entering an adjacent APC in the same LAN")
	TEST_ASSERT(entity.hop(apc_node), "The entity must traverse the first actual graph edge")
	entity.next_hop = 0
	TEST_ASSERT(entity.hop(target_node), "The same key must permit entering the adjacent endpoint behind the APC")
	TEST_ASSERT_EQUAL(entity.console.node_level(target_node), NETRUN_ACCESS_GUEST, "Entering a node with a key must not grant implicit USER action rights")
	var/list/entry = netrun_command_entry(target_node.command_entries(entity.console), "web_copy")
	TEST_ASSERT(!entry["allowed"], "A traversal key must not enable the machine's USER command")
	TEST_ASSERT(!target.allowed(entity), "A LAN traversal key must not satisfy the native machine's ID authorization")
