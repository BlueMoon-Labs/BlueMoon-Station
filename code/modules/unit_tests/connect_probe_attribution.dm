/**
 * client/New() спит по нескольку секунд в acquire_dpi() (winget - round-trip к клиенту), и
 * всё, что за это окно сделала асинхронная работа, прибор записывал на счёт входящего
 * игрока. В раунде 10119 так набежало 368 "МБ dpi" на десяти входах, пока рядом строился
 * свет z-уровней: сумма окон входов 1-80 дала 2322 МБ при реальном приросте 1193 МБ.
 *
 * Фоновая работа теперь сама записывает свою цену в GLOB.memory_attributed_elsewhere_mb, а
 * прибор вычитает прирост этого счётчика из своего этапа. Арифметика вычета живёт в
 * probe_stage_line() - без клиента её иначе не проверить.
 */

/// Чистое окно: счётчик фона не двигался, весь прирост принадлежит подключению.
/datum/unit_test/connect_probe_clean_window/Run()
	var/line = probe_stage_line("dpi", 3.9, 12, 0)

	TEST_ASSERT_EQUAL(line, "dpi 3.9с +12 МБ", "Без фоновой работы строка этапа обязана остаться прежней")

/// Грязное окно: фон вычтен из этапа И назван в строке. Молчаливый вычет прячет от
/// читателя, что окно было не его.
/datum/unit_test/connect_probe_subtracts_background/Run()
	var/line = probe_stage_line("dpi", 4.2, 160, 151)

	TEST_ASSERT(findtext(line, "+9 МБ"), "Из 160 МБ этапа обязаны остаться 9 своих: [line]")
	TEST_ASSERT(findtext(line, "+151 МБ фоновой работы"), "Вычтенный фон обязан быть назван в строке: [line]")

/// Счётчик фона монотонный, но между отметками мир мог его и не двигать: отрицательная
/// разница не имеет смысла и не должна ДОБАВЛЯТЬ подключению мегабайт.
/datum/unit_test/connect_probe_ignores_negative_background/Run()
	var/line = probe_stage_line("хвост", 1.1, 20, -5)

	TEST_ASSERT_EQUAL(line, "хвост 1.1с +20 МБ", "Отрицательный фон обязан игнорироваться, а не прибавляться")

/// Своя дельта законно бывает отрицательной (за окно ушёл другой клиент) - знак обязан
/// сохраниться, иначе строка читается как рост.
/datum/unit_test/connect_probe_keeps_negative_own_delta/Run()
	var/line = probe_stage_line("Login", 0, 2, 5)

	TEST_ASSERT(findtext(line, "-3 МБ"), "Своя дельта после вычета обязана уйти в минус со знаком: [line]")

/// На Windows /proc нет и get_process_memory_mb() отдаёт null: этап обязан остаться
/// полезным - секунды ожидания клиента и есть ответ на вопрос, сколько сервер его ждал.
/datum/unit_test/connect_probe_line_without_memory/Run()
	var/line = probe_stage_line("prefs", 0.4, 0, 0, measured = FALSE)

	TEST_ASSERT_EQUAL(line, "prefs 0.4с", "Без замера памяти в этапе остаются только секунды")
