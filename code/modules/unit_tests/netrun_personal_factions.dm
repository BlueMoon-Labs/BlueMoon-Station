/// Actual owners have distinct memberships, while family policy still recognizes intruders.
/datum/unit_test/netrun_personal_faction_membership/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_b)
	var/first_id = first.netrun_faction()
	var/second_id = second.netrun_faction()
	TEST_ASSERT(first_id != second_id && first_id != NETRUN_FACTION_OWNER, "Independent owners have separate personal IDs")
	TEST_ASSERT_EQUAL(first.console.get_personal_faction_id(), first_id, "The owner reuses its cached ID")
	var/mob/camera/netrun_entity/bot/first_agent = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_a, NETRUN_BOT_SENTINEL, first.console)
	var/mob/camera/netrun_entity/bot/second_agent = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_b, NETRUN_BOT_SENTINEL, second.console)
	TEST_ASSERT_EQUAL(first_agent.netrun_faction(), first_id, "An owned bot belongs to its actual owner's personal faction")
	TEST_ASSERT_EQUAL(second_agent.netrun_faction(), second_id, "Another owner's bot receives another ID")
	TEST_ASSERT_EQUAL(first_agent.program.faction, NETRUN_FACTION_OWNER, "The authored profile remains in the private template family")
	TEST_ASSERT_EQUAL(SSnetrun.get_netrun_faction(first_id).family, NETRUN_FACTION_OWNER, "A personal ID retains its static policy family")
	TEST_ASSERT(!netrun_bot_factions_hostile(first_id, second_id), "Different private owners are neutral by default")
	TEST_ASSERT(!netrun_bot_factions_hostile(first_id, first_agent.net_faction), "An owner's agents are allies")
	TEST_ASSERT(netrun_bot_factions_hostile(NETRUN_FACTION_ROGUE, first_id) && netrun_bot_factions_hostile(first_id, "redshift"), "Declared owner-family enemies recognize dynamic IDs symmetrically")
	var/mob/camera/netrun_entity/bot/raider = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_a, NETRUN_BOT_RAIDER)
	TEST_ASSERT(raider.program.is_enemy(raider.brain, first), "Rogue policy recognizes a resident player as well as an owned bot")
	TEST_ASSERT(raider.program.is_enemy(raider.brain, first_agent), "A dynamic owned bot cannot evade the same faction policy")
	TEST_ASSERT(!SSnetrun.get_netrun_faction("collective").hostile_to(first_id), "A faction without owner-family hostility remains neutral")

/// Borrowed implant memory shares the real source identity across dives and owns its registry life.
/datum/unit_test/netrun_personal_faction_borrowed_lifetime/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/datum/netrun_console/physical = allocate(/datum/netrun_console, allocate(/obj/item))
	var/personal_id = physical.get_personal_faction_id()
	var/datum/netrun_faction/faction = SSnetrun.get_netrun_faction(personal_id)
	var/mob/camera/netrun_entity/first = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	var/mob/camera/netrun_entity/second = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_a)
	TEST_ASSERT(first.console.inventory.borrow_from(physical.inventory), "The first resident borrows the actual implant disk")
	TEST_ASSERT(second.console.inventory.borrow_from(physical.inventory), "Another resident uses the same actual source")
	TEST_ASSERT_EQUAL(first.netrun_faction(), personal_id, "The diver inherits the physical owner identity")
	TEST_ASSERT_EQUAL(second.netrun_faction(), personal_id, "A later/shared dive keeps that identity")
	var/mob/camera/netrun_entity/bot/guard = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_b, NETRUN_BOT_SENTINEL, physical)
	TEST_ASSERT(!guard.program.is_enemy(guard.brain, first), "A physical owner's guard recognizes its diver without copying machine USER")
	TEST_ASSERT(first.console.node_level(scene.node_b) < NETRUN_ACCESS_USER, "Faction friendship did not grant node access")
	qdel(first)
	TEST_ASSERT(!QDELETED(faction) && SSnetrun.get_netrun_faction(personal_id) == faction, "Destroying a borrowed console does not release the physical owner's faction")
	qdel(physical)
	TEST_ASSERT(QDELETED(faction) && !SSnetrun.get_netrun_faction(personal_id), "Destroying the actual owner removes the dynamic registry datum")
	TEST_ASSERT(netrun_bot_factions_hostile(NETRUN_FACTION_ROGUE, personal_id), "Orphan cleanup cannot briefly make the old personal ID immune")
	TEST_ASSERT(second.netrun_faction() != personal_id, "A detached resident does not retain a deleted physical identity")

/// Private works trust their builder's exact membership while preserving native ACLs and vaults.
/datum/unit_test/netrun_personal_faction_fortress/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/camera/netrun_entity/owner = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_b)
	var/mob/camera/netrun_entity/other = allocate(/mob/camera/netrun_entity, run_loc_floor_bottom_left, scene.node_b)
	owner.console.access_session.node_access[scene.node_b.address] = NETRUN_ACCESS_ROOT
	TEST_ASSERT(owner.console.store_file(netrun_daemon_file("forge")), "The actual builder owns the required native tool")
	var/datum/netrun_fortress_module/wall = SSnetrun.build_fortress_module(scene.node_b, NETRUN_FORT_WALL, owner.console)
	TEST_ASSERT_NOTNULL(wall, "A native authorized build founds the fortress")
	wall.complete_build()
	var/datum/netrun_fortress/fortress = scene.node_b.fortress
	fortress.add_module(NETRUN_FORT_GATE, TRUE)
	fortress.add_module(NETRUN_FORT_VAULT, TRUE)
	var/mob/camera/netrun_entity/bot/agent = allocate(/mob/camera/netrun_entity/bot, run_loc_floor_bottom_left, scene.node_a, NETRUN_BOT_SENTINEL, owner.console)
	TEST_ASSERT_EQUAL(fortress.faction, owner.netrun_faction(), "A private build stores the builder's exact faction ID")
	TEST_ASSERT(fortress.is_friendly(owner.console) && fortress.is_friendly(agent.console), "The owner and its real agents share fortress friendship")
	var/legit_before = other.console.compute_legit_node_level(scene.node_b, TRUE)
	TEST_ASSERT(!fortress.is_friendly(other.console), "An unrelated private owner is not a faction friend")
	TEST_ASSERT(fortress.gate_blocks(other.console), "A different owner's existing USER cannot bypass a private gate")
	TEST_ASSERT_EQUAL(fortress.file_access_level(other.console), NETRUN_ACCESS_ROOT, "The private vault still requires ROOT from outsiders")
	TEST_ASSERT_EQUAL(other.console.node_level(scene.node_b), NETRUN_ACCESS_USER, "Existing residency USER is preserved")
	TEST_ASSERT_EQUAL(other.console.compute_legit_node_level(scene.node_b, TRUE), legit_before, "Faction lookup never changes legitimate native authority")
	TEST_ASSERT_NULL(netrun_agent_template(netrun_bot_file(NETRUN_BOT_CUSTODIAN)), "Station profiles remain excluded from private template construction")

/// Reusing a terminal changes the caller, not the allegiance or control of its previous agents.
/datum/unit_test/netrun_personal_faction_shared_console/Run()
	var/datum/netrun_fortress_scene/scene = allocate(/datum/netrun_fortress_scene, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/first = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/second = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left)
	first.mind_initialize()
	second.mind_initialize()
	var/datum/netrun_console/shared = allocate(/datum/netrun_console, scene.node_a.parent)
	shared.operator = first
	shared.set_jack(scene.node_a)
	shared.access_session.node_access[scene.node_a.address] = NETRUN_ACCESS_USER
	var/first_id = shared.get_personal_faction_id()
	var/datum/netrun_faction/first_faction = SSnetrun.get_netrun_faction(first_id)
	var/datum/netrun_file/template = netrun_bot_file(NETRUN_BOT_SENTINEL)
	TEST_ASSERT(shared.store_file(template) && shared.launch_bot_file(template.uid, scene.node_a.address), "The first real operator launches an ordinary owned agent")
	var/list/agents = shared.agents()
	var/mob/camera/netrun_entity/bot/agent = agents[1]
	TEST_ASSERT_EQUAL(agent.net_faction, first_id, "Launch snapshots the issuing player's faction")
	TEST_ASSERT(shared.agent_order(REF(agent), "patrol"), "The original operator may send a native control packet")
	var/datum/netrun_request/agent_control/old_control = netrun_operation_packet(shared, /datum/netrun_request/agent_control)
	TEST_ASSERT_NOTNULL(old_control, "Agent control retains the normal delivery boundary")
	var/datum/netrun_fortress/fortress = new(scene.node_a, "First player's works", NETRUN_FACTION_OWNER, shared)
	scene.node_a.fortress = fortress
	fortress.add_module(NETRUN_FORT_VAULT, TRUE)
	shared.operator = second
	var/second_id = shared.get_personal_faction_id()
	TEST_ASSERT(second_id != first_id, "Two people at the same console receive different personal factions")
	TEST_ASSERT(SSnetrun.get_netrun_faction(second_id).color != first_faction.color, "Consecutive personal factions receive distinct stable palette colors")
	TEST_ASSERT(!QDELETED(first_faction), "Switching operators does not delete the first living mind's faction")
	TEST_ASSERT_EQUAL(agent.net_faction, first_id, "A changed operator cannot retarget an already launched agent's allegiance")
	TEST_ASSERT_EQUAL(length(shared.agents()), 0, "The next operator cannot list the first player's agents")
	TEST_ASSERT(!shared.agent_order(REF(agent), "terminate"), "A forged old-agent reference cannot admit a new control packet")
	TEST_ASSERT(!old_control.deliver(), "An in-flight control packet rechecks its original caller at delivery")
	TEST_ASSERT_NULL(agent.netrun_owner_console(), "The next operator cannot receive the former owner's private agent reports")
	TEST_ASSERT(!agent.return_to_owner(), "The process cannot deposit its package into another operator's session")
	TEST_ASSERT(!fortress.is_owner(shared) && !fortress.is_friendly(shared), "A shared console pointer grants no ownership of the prior player's fortress")
	TEST_ASSERT_EQUAL(fortress.file_access_level(shared), NETRUN_ACCESS_ROOT, "The unrelated operator does not bypass the private vault")
	TEST_ASSERT_EQUAL(shared.node_level(scene.node_a), NETRUN_ACCESS_USER, "Principal changes do not manufacture ROOT authority")
	shared.operator = first
	TEST_ASSERT_EQUAL(shared.get_personal_faction_id(), first_id, "The original player recovers the same identity on returning")
	TEST_ASSERT(shared.owns_agent(agent) && (agent in shared.agents()), "The original player regains its agent list and control")
	TEST_ASSERT(shared.agent_order(REF(agent), "patrol"), "Returning to the terminal permits an ordinary new order")
	var/datum/netrun_request/agent_control/current_control = netrun_operation_packet(shared, /datum/netrun_request/agent_control)
	TEST_ASSERT(current_control.deliver(), "The authenticated order succeeds through normal delivery")
	TEST_ASSERT(agent.return_to_owner(), "The original player can request a real recall")
	var/datum/netrun_request/agent_recall/recall = netrun_operation_packet(shared, /datum/netrun_request/agent_recall)
	shared.operator = second
	TEST_ASSERT(!recall.deliver() && !QDELETED(agent) && agent.agent_file == template, "An operator switch in flight rejects recall without losing the live agent or file")
	shared.operator = first
	TEST_ASSERT(shared.owns_agent(agent), "The issuing player's control remains recoverable after rejection")

/// A mind is shared across real devices and remains the same principal inside a native dive.
/datum/unit_test/netrun_personal_faction_mind_across_devices/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	var/obj/item/netrun_deck/deck = allocate(/obj/item/netrun_deck, scene.user)
	deck.console.operator = scene.user
	var/datum/mind/principal = scene.user.mind
	var/principal_key = REF(principal)
	var/personal_id = deck.console.get_personal_faction_id()
	TEST_ASSERT_EQUAL(scene.implant.console.get_personal_faction_id(), personal_id, "The same player has one faction on a deck and an implanted client")
	var/datum/netrun_faction/faction = SSnetrun.get_netrun_faction(personal_id)
	scene.authorize()
	TEST_ASSERT(scene.implant.complete_dive(scene.target_node, scene.user), "The real implanted client establishes a native body link")
	var/mob/camera/netrun_entity/resident = scene.implant.console.dive_ref.resolve()
	TEST_ASSERT_EQUAL(resident.netrun_faction(), personal_id, "The resident keeps the original body/mind's identity")
	TEST_ASSERT_EQUAL(deck.console.get_personal_faction_id(), personal_id, "The original body backref preserves its mind identity while the mind is resident")
	TEST_ASSERT_EQUAL(scene.implant.console.get_personal_faction_id(), personal_id, "The physical client also keeps that identity while the body has no mind")
	TEST_ASSERT(resident.return_to_body(), "The native dive returns its original mind to the body")
	TEST_ASSERT_EQUAL(scene.implant.console.get_personal_faction_id(), personal_id, "Returning does not mint another personal faction")
	qdel(deck)
	TEST_ASSERT(!QDELETED(faction), "Deleting a device does not delete a living player's faction")
	qdel(principal)
	TEST_ASSERT(QDELETED(faction) && !SSnetrun.get_netrun_faction(personal_id), "Deleting the actual principal removes the registry entry")
	TEST_ASSERT_NULL(SSnetrun.personal_factions_by_principal[principal_key], "Principal destruction also releases its reverse lookup index")

/// Ownership crosses real clients; an explicit accepted command chooses its reporting client.
/datum/unit_test/netrun_personal_agent_cross_client/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	scene.authorize()
	var/obj/item/netrun_deck/deck = allocate(/obj/item/netrun_deck, scene.user)
	deck.console.operator = scene.user
	deck.console.set_jack(scene.target_node)
	deck.console.access_session.node_access[scene.target_node.address] = NETRUN_ACCESS_USER
	var/datum/netrun_file/template = netrun_bot_file(NETRUN_BOT_SENTINEL)
	TEST_ASSERT(deck.console.store_file(template) && deck.console.launch_bot_file(template.uid, scene.target_node.address), "The real deck launches the issuing person's file")
	var/list/launched = deck.console.agents()
	var/mob/camera/netrun_entity/bot/agent = launched[1]
	var/datum/netrun_console/implant/client = scene.implant.console
	TEST_ASSERT(client.owns_agent(agent) && (agent in client.agents()), "The same mind can list and authorize its agent from its implanted client")
	TEST_ASSERT_EQUAL(agent.netrun_owner_console(), deck.console, "Listing from another client does not redirect private reports")
	TEST_ASSERT(!client.apply_agent_order(agent, list("order" = "unknown")), "A rejected control action cannot choose a reporting destination")
	TEST_ASSERT_EQUAL(agent.netrun_owner_console(), deck.console, "Rejected delivery restores the original reporting client")
	TEST_ASSERT(client.agent_order(REF(agent), "patrol"), "A second owned client sends the ordinary control packet")
	var/datum/netrun_request/agent_control/control = netrun_operation_packet(client, /datum/netrun_request/agent_control)
	TEST_ASSERT(control.deliver(), "Cross-client control passes normal route and live-owner delivery checks")
	TEST_ASSERT_EQUAL(agent.netrun_owner_console(), client, "An accepted action explicitly chooses the current reporting client")
	TEST_ASSERT(client.agent_order(REF(agent), "recall"), "The current client requests an ordinary delivered recall order")
	control = netrun_operation_packet(client, /datum/netrun_request/agent_control)
	TEST_ASSERT(control.deliver(), "The recall order is authenticated at its ordinary delivery boundary")
	var/datum/netrun_bot_goal/goal = agent.brain.current_goal()
	goal.advance()
	var/datum/netrun_request/agent_recall/recall = netrun_operation_packet(client, /datum/netrun_request/agent_recall)
	TEST_ASSERT_NOTNULL(recall, "The recall goal creates a real file delivery back to the explicitly requesting client")
	var/original_capacity = client.inventory.local_store.capacity
	client.inventory.local_store.capacity = 0
	TEST_ASSERT(!recall.deliver() && !QDELETED(agent) && agent.agent_file == template, "A full destination rejects delivery without losing the live agent or owned memory")
	client.inventory.local_store.capacity = original_capacity
	agent.brain.clear_goals()
	TEST_ASSERT(agent.return_to_owner(client), "The same authorized client can retry a real recall after capacity is restored")
	recall = netrun_operation_packet(client, /datum/netrun_request/agent_recall)
	TEST_ASSERT(recall.deliver(), "The retried file delivery reaches the current physical implanted disk")
	TEST_ASSERT(QDELETED(agent) && (template in client.inventory.local_store.files), "Only successful acceptance consumes the agent into the selected client")
	TEST_ASSERT(!(template in deck.console.inventory.local_store.files), "Recall never silently targets the original deck")

/// A temporary resident is an interface to the person, never the agent's lifetime owner.
/datum/unit_test/netrun_personal_agent_dive_survival/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	scene.authorize()
	TEST_ASSERT(scene.implant.complete_dive(scene.target_node, scene.user), "The real implanted dive establishes its native return client")
	var/mob/camera/netrun_entity/resident = scene.implant.console.dive_ref.resolve()
	var/datum/netrun_file/template = netrun_bot_file(NETRUN_BOT_SENTINEL)
	TEST_ASSERT(resident.console.store_file(template) && resident.console.launch_bot_file(template.uid), "The resident launches an actual owned agent file")
	var/list/launched = resident.console.agents()
	var/mob/camera/netrun_entity/bot/agent = launched[1]
	var/personal_id = agent.net_faction
	TEST_ASSERT_EQUAL(agent.netrun_owner_console(), resident.console, "The live resident initially receives its own agent reports")
	TEST_ASSERT(resident.return_to_body(), "Returning destroys the temporary resident through the native body link")
	agent.brain.think()
	TEST_ASSERT(!QDELETED(agent) && !agent.agent_orphaned(), "Destroying the temporary interface cannot kill the living mind's agent")
	TEST_ASSERT_EQUAL(agent.net_faction, personal_id, "The stable membership survives the mind's return to its body")
	TEST_ASSERT(scene.implant.console.owns_agent(agent), "The returned owner can control the surviving agent through its physical client")
	TEST_ASSERT_EQUAL(agent.netrun_owner_console(), scene.implant.console, "The recorded native return client is the bounded reporting fallback")
	TEST_ASSERT(scene.implant.console.agent_order(REF(agent), "recall"), "The returned owner sends a real recall command")
	var/datum/netrun_request/agent_control/control = netrun_operation_packet(scene.implant.console, /datum/netrun_request/agent_control)
	TEST_ASSERT(control.deliver(), "The returned mind passes the ordinary control delivery check")
	var/datum/netrun_bot_goal/goal = agent.brain.current_goal()
	goal.advance()
	var/datum/netrun_request/agent_recall/recall = netrun_operation_packet(scene.implant.console, /datum/netrun_request/agent_recall)
	TEST_ASSERT(recall.deliver(), "The surviving agent returns its real packed memory over the current route")
	TEST_ASSERT(QDELETED(agent) && scene.implant.console.find_local_file(template.uid) == template, "The original agent file reaches the current owner's memory")

/// Real principal or membership loss wakes the lifecycle even while the old device survives.
/datum/unit_test/netrun_personal_agent_owner_deletion/Run()
	var/datum/netrun_client_scene/scene = allocate(/datum/netrun_client_scene, run_loc_floor_bottom_left)
	scene.authorize()
	var/datum/netrun_console/implant/client = scene.implant.console
	var/datum/netrun_file/template = netrun_bot_file(NETRUN_BOT_SENTINEL)
	TEST_ASSERT(client.store_file(template) && client.launch_bot_file(template.uid, scene.target_node.address), "The real principal launches an owned process")
	var/list/launched = client.agents()
	var/mob/camera/netrun_entity/bot/agent = launched[1]
	var/datum/netrun_bot_brain/brain = agent.brain
	brain.clear_timer()
	SSnetrun.get_task_scheduler().cancel("bot", brain)
	var/datum/mind/principal = scene.user.mind
	qdel(principal)
	TEST_ASSERT(!QDELETED(client) && agent.agent_orphaned(), "Principal deletion invalidates ownership even with a surviving device")
	TEST_ASSERT(SSnetrun.task_scheduler.by_key["bot:[REF(brain)]"], "Principal/faction deletion reactively admits one lifecycle task without polling")
	brain.think()
	TEST_ASSERT(QDELETED(agent) && (template in scene.target_node.salvage), "The lifecycle releases the orphan and preserves its actual file as salvage")
	var/datum/netrun_file/other_template = netrun_bot_file(NETRUN_BOT_SENTINEL)
	TEST_ASSERT(client.store_file(other_template) && client.launch_bot_file(other_template.uid, scene.target_node.address), "The surviving body can establish a new independent fallback identity")
	launched = client.agents()
	agent = launched[1]
	brain = agent.brain
	brain.clear_timer()
	SSnetrun.get_task_scheduler().cancel("bot", brain)
	var/datum/netrun_faction/faction = SSnetrun.get_netrun_faction(agent.net_faction)
	qdel(faction)
	TEST_ASSERT(agent.agent_orphaned() && SSnetrun.task_scheduler.by_key["bot:[REF(brain)]"], "Explicit membership deletion also wakes orphan cleanup without deleting its body")
	brain.think()
	TEST_ASSERT(QDELETED(agent) && (other_template in scene.target_node.salvage), "A deleted membership cannot leave an immortal unowned process")
