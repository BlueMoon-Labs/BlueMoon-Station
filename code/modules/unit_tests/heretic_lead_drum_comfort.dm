/proc/heretic_lead_test_heard(mob/listener, marker)
	for(var/list/entry as anything in GLOB.unit_test_chat_capture)
		var/target = entry[1]
		if((target == listener || (islist(target) && (listener in target))) && findtext(entry[2], marker))
			return TRUE
	return FALSE

/proc/heretic_lead_test_holding(mob/living/user, obj/item/item)
	return user.is_holding(item)

/// Последний патрон только по выбору: полный барабан и попадания Шестую не взводят, взведённая держится до выстрела или отмены, по нечеловеку уходит обычная пуля.
/datum/unit_test/heretic_lead_sixth_explicit/Run()
	var/datum/antagonist/heretic/heretic = allocate_deed_heretic(PATH_LEAD)
	var/mob/living/carbon/human/user = heretic.owner.current
	user.forceMove(heretic_lead_test_spot(0, 2))
	var/datum/eldritch_knowledge/base_lead/lead = heretic.get_knowledge(/datum/eldritch_knowledge/base_lead)
	var/obj/item/heretic_path_relic/lead_revolver/revolver = heretic_lead_test_revolver(heretic, user)
	heretic.gain_knowledge(/datum/eldritch_knowledge/lead_ear)
	var/mob/living/carbon/human/victim = heretic_lead_test_crew(heretic_lead_test_spot(3, 2))
	lead.combat_resource = HERETIC_LEAD_CAPACITY - 1
	lead.gain_combat_resource()
	TEST_ASSERT(lead.last_round_ready() && !lead.sixth_cocked(), "Полный барабан сам Шестую камору не взводит.")
	TEST_ASSERT(findtext(lead.drum_state(), "Alt-клик"), "Барабан подсказывает, как взвести Шестую: [lead.drum_state()]")
	var/obj/item/projectile/plain = revolver.fire_at(victim, user)
	TEST_ASSERT(plain?.type == /obj/item/projectile/bullet/heretic_lead && !revolver.aim_timer, "Без выбора выстрел в человека - пуля из каморы под курком, а не весь Свинец.")
	heretic_lead_test_fly(plain)
	TEST_ASSERT(lead.combat_resource == HERETIC_LEAD_CAPACITY && !lead.sixth_cocked(), "Попадание снова наполнило барабан, но Шестую не взвело: [lead.combat_resource].")
	TEST_ASSERT(heretic_lead_test_arm_sixth(revolver, user), "Alt-клик взводит Шестую камору.")
	TEST_ASSERT(lead.spend_combat_resource(), "Способность тратит Свинец.")
	TEST_ASSERT(lead.sixth_armed && !lead.sixth_cocked(), "Неполный барабан Последний патрон не даёт, но выбор держится.")
	TEST_ASSERT(findtext(lead.drum_state(), "ждёт полного барабана"), "Барабан говорит, что Шестая ждёт: [lead.drum_state()]")
	var/obj/item/projectile/between = revolver.fire_at(victim, user)
	TEST_ASSERT(istype(between, /obj/item/projectile/bullet/heretic_lead) && !istype(between, /obj/item/projectile/bullet/heretic_lead/last_round) && !revolver.aim_timer, "Пока барабан неполон, стреляет камора кольца.")
	heretic_lead_test_fly(between)
	lead.gain_combat_resource(HERETIC_LEAD_CAPACITY)
	TEST_ASSERT(lead.sixth_cocked(), "Барабан снова полон - взведённая Шестая на месте.")
	var/mob/living/carbon/monkey/beast = allocate(/mob/living/carbon/monkey, heretic_lead_test_spot(3, 4))
	COOLDOWN_RESET(revolver, shot_cooldown)
	var/obj/item/projectile/at_beast = revolver.fire_at(beast, user)
	TEST_ASSERT(istype(at_beast, /obj/item/projectile/bullet/heretic_lead) && !istype(at_beast, /obj/item/projectile/bullet/heretic_lead/last_round) && !revolver.aim_timer, "По обезьяне Последний патрон не уходит.")
	heretic_lead_test_fly(at_beast)
	TEST_ASSERT(lead.sixth_armed, "Выстрел по зверю Шестую с курка не снимает.")
	lead.gain_combat_resource(HERETIC_LEAD_CAPACITY)
	COOLDOWN_RESET(revolver, shot_cooldown)
	TEST_ASSERT(revolver.fire_at(victim, user) == TRUE && revolver.aim_timer, "Взведённая Шестая по человеку - Последний патрон.")
	TEST_ASSERT(wait_for_var(lead, NAMEOF(lead, combat_resource), 0, 3 SECONDS), "Последний патрон ушёл.")
	TEST_ASSERT(!lead.sixth_armed, "Ушедший Последний патрон снимает Шестую с курка.")
	heretic_lead_test_fly(locate(/obj/item/projectile/bullet/heretic_lead/last_round) in range(7, user), 2)
	lead.gain_combat_resource(HERETIC_LEAD_CAPACITY)
	TEST_ASSERT(!lead.sixth_cocked(), "Новый полный барабан после Последнего патрона Шестую не взводит.")
	TEST_ASSERT(heretic_lead_test_arm_sixth(revolver, user), "Шестая взводится снова.")
	COOLDOWN_RESET(revolver, drum_spin)
	revolver.CtrlClick(user)
	TEST_ASSERT(!lead.sixth_armed, "Прокрутка барабана снимает Шестую с курка.")

/// Мгновение Стрелка идёт раньше Шестой каморы: мгновенный прицельный выстрел уходит сразу и не съедает барабан.
/datum/unit_test/heretic_lead_standoff_before_sixth/Run()
	var/datum/eldritch_knowledge/base_lead/lead = heretic_lead_test_school(HERETIC_LEAD_SCHOOL_GUNSLINGER, heretic_lead_test_spot(0, 2))
	var/mob/living/carbon/human/user = lead.lead_body
	var/datum/antagonist/heretic/heretic = lead.owner_heretic()
	var/obj/item/heretic_path_relic/lead_revolver/revolver = heretic_lead_test_revolver(heretic, user)
	heretic.gain_knowledge(/datum/eldritch_knowledge/lead_ear)
	var/mob/living/carbon/human/victim = heretic_lead_test_crew(heretic_lead_test_spot(3, 2))
	lead.combat_resource = HERETIC_LEAD_CAPACITY
	TEST_ASSERT(heretic_lead_test_arm_sixth(revolver, user), "Шестая камора взведена.")
	TEST_ASSERT(lead.start_standoff(user, FALSE), "Мгновение начинается: [lead.lead_failure]")
	var/obj/item/projectile/bullet/heretic_lead/fast = revolver.fire_at(victim, user)
	TEST_ASSERT(istype(fast) && !istype(fast, /obj/item/projectile/bullet/heretic_lead/last_round) && !revolver.aim_timer, "В Мгновение выстрел уходит сразу, а не полторы секунды Последним патроном.")
	TEST_ASSERT(abs(fast?.damage - initial(fast.damage) * (100 + HERETIC_LEAD_AIM_BONUS) / 100) < 0.1, "Мгновенный выстрел бьёт как прицельный: [fast?.damage].")
	TEST_ASSERT_EQUAL(lead.standoff_shots, HERETIC_LEAD_STANDOFF_SHOTS - 1, "Мгновенный выстрел потрачен.")
	TEST_ASSERT_EQUAL(lead.combat_resource, HERETIC_LEAD_CAPACITY - 1, "Барабан потерял одну камору, а не весь Свинец.")
	TEST_ASSERT(lead.sixth_armed, "Шестая ждёт своего часа.")
	heretic_lead_test_fly(fast)

/// Потерянный Шестизарядник возвращается кнопкой: из своих вещей - сразу и даром, из шкафа и из чужой руки - через секунду за единицу Свинца; отказ называет причину.
/datum/unit_test/heretic_lead_revolver_recall/Run()
	var/datum/antagonist/heretic/heretic = allocate_deed_heretic(PATH_LEAD)
	var/mob/living/carbon/human/user = heretic.owner.current
	user.forceMove(heretic_lead_test_spot(0, 2))
	var/datum/eldritch_knowledge/base_lead/lead = heretic.get_knowledge(/datum/eldritch_knowledge/base_lead)
	var/obj/item/heretic_path_relic/lead_revolver/revolver = heretic_lead_test_revolver(heretic, user)
	var/datum/eldritch_knowledge/lead_relic/recipe = heretic.get_knowledge(/datum/eldritch_knowledge/lead_relic)
	var/obj/effect/proc_holder/spell/self/heretic_lead/recall/recall = recipe.recall_power
	TEST_ASSERT(recall && (recall in user.mind.spell_list), "Реликвия даёт кнопку «Призвать Шестизарядник».")
	TEST_ASSERT(!recall.can_cast(user, FALSE, TRUE) && findtext(recall.heretic_failure_reason, "уже у вас в руке"), "Револьвер в руке призывать незачем: [recall.heretic_failure_reason]")
	var/obj/item/storage/box/box = allocate(/obj/item/storage/box, get_turf(user))
	user.dropItemToGround(revolver)
	revolver.forceMove(box)
	user.put_in_hands(box)
	lead.combat_resource = 0
	TEST_ASSERT(recall.cast_check(FALSE, user), "Из своей сумки призыв доступен без Свинца: [recall.heretic_failure_reason]")
	recall.choose_targets(user)
	TEST_ASSERT(user.is_holding(revolver) && !(revolver in box), "Револьвер из своих вещей сразу в руке.")
	TEST_ASSERT_NULL(lead.recall_timer, "Из своих вещей без ожидания.")
	var/obj/structure/closet/closet = allocate(/obj/structure/closet, heretic_lead_test_spot(5, 5))
	user.dropItemToGround(revolver)
	revolver.forceMove(closet)
	recall.charge_counter = recall.charge_max
	TEST_ASSERT(!recall.can_cast(user, FALSE, TRUE) && findtext(recall.heretic_failure_reason, "нужен Свинец"), "Без Свинца призыв издалека называет цену: [recall.heretic_failure_reason]")
	lead.combat_resource = 2
	lead.mark_combat()
	TEST_ASSERT(recall.cast_check(FALSE, user), "Призыв из шкафа доступен: [recall.heretic_failure_reason]")
	recall.choose_targets(user)
	TEST_ASSERT(lead.recall_timer && (revolver in closet), "Секунду револьвер дрожит на месте.")
	TEST_ASSERT(heretic_lead_test_wait(CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(heretic_lead_test_holding), user, revolver), 3 SECONDS, "призыв из шкафа"), "Револьвер прилетел из шкафа в руку.")
	TEST_ASSERT_EQUAL(lead.combat_resource, 1, "Призыв издалека стоит единицу Свинца.")
	var/mob/living/carbon/human/thief = heretic_lead_test_crew(heretic_lead_test_spot(5, 3))
	user.dropItemToGround(revolver)
	thief.put_in_hands(revolver)
	recall.charge_counter = recall.charge_max
	TEST_ASSERT(recall.cast_check(FALSE, user), "Призыв из чужой руки доступен: [recall.heretic_failure_reason]")
	recall.choose_targets(user)
	TEST_ASSERT(heretic_lead_test_wait(CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(heretic_lead_test_holding), user, revolver), 3 SECONDS, "призыв из чужой руки"), "Револьвер вырвался из чужой руки.")
	TEST_ASSERT(!thief.is_holding(revolver) && revolver.loc != thief, "У вора револьвера не осталось.")
	user.dropItemToGround(revolver)
	var/obj/item/stack/rods/rods = allocate(/obj/item/stack/rods, get_turf(user))
	user.put_in_hands(rods)
	recall.charge_counter = recall.charge_max
	TEST_ASSERT(!recall.can_cast(user, FALSE, TRUE) && findtext(recall.heretic_failure_reason, "руки заняты"), "С занятыми руками призыв называет причину: [recall.heretic_failure_reason]")
	qdel(revolver)
	TEST_ASSERT(!recall.can_cast(user, FALSE, TRUE) && findtext(recall.heretic_failure_reason, "соберите новый"), "Уничтоженный револьвер кнопка предлагает собрать заново: [recall.heretic_failure_reason]")
	TEST_ASSERT(recipe.new_path_relic_available(), "Обряд Шестизарядника снова доступен.")

/// Палец-ствол стреляет только по живой цели: пол, стена и труп оставляют Хватку с зарядом, а дробина ставит точку Рикошета.
/datum/unit_test/heretic_lead_finger_living_only/Run()
	var/datum/antagonist/heretic/heretic = allocate_deed_heretic(PATH_LEAD)
	var/mob/living/carbon/human/user = heretic.owner.current
	user.forceMove(heretic_lead_test_spot(0, 2))
	user.a_intent = INTENT_HARM
	var/datum/eldritch_knowledge/base_lead/lead = heretic.get_knowledge(/datum/eldritch_knowledge/base_lead)
	var/obj/item/melee/touch_attack/mansus_fist/fist = allocate(/obj/item/melee/touch_attack/mansus_fist)
	var/obj/structure/falsewall/wall = allocate(/obj/structure/falsewall, heretic_lead_test_spot(3, 4))
	var/mob/living/carbon/human/corpse = heretic_lead_test_crew(heretic_lead_test_spot(3, 0))
	corpse.death()
	for(var/atom/miss as anything in list(heretic_lead_test_spot(4, 2), wall, corpse))
		fist.afterattack(miss, user, FALSE)
		TEST_ASSERT(!QDELETED(fist) && fist.charges == 1, "Клик по [miss] заряд Хватки не тратит.")
		TEST_ASSERT_NULL(locate(/obj/item/projectile/bullet/heretic_lead_pellet) in range(HERETIC_LEAD_FINGER_RANGE, user), "Клик по [miss] дробину не выпускает.")
	var/mob/living/carbon/human/victim = heretic_lead_test_crew(heretic_lead_test_spot(4, 2))
	fist.afterattack(get_turf(victim), user, FALSE)
	var/obj/item/projectile/bullet/heretic_lead_pellet/pellet = locate() in range(HERETIC_LEAD_FINGER_RANGE, user)
	TEST_ASSERT_NOTNULL(pellet, "Клик по клетке с живым стреляет в него.")
	TEST_ASSERT(QDELETED(fist), "Выстрел тратит заряд Хватки.")
	heretic_lead_test_fly(pellet)
	TEST_ASSERT(victim.getBruteLoss() > 0, "Дробина попала.")
	TEST_ASSERT(lead.impact_fresh() && get_dist(lead.impact_turf, victim) <= 1, "Дробина ставит точку Рикошета.")

/// Отказы называют настоящую причину: захват и шкаф, а не чужой разум; Alt-, Ctrl-клик и «Использовать в руке» не молчат; конец веера и прибавка в патронташ заметны.
/datum/unit_test/heretic_lead_honest_refusals/Run()
	var/datum/antagonist/heretic/heretic = allocate_deed_heretic(PATH_LEAD)
	var/mob/living/carbon/human/user = heretic.owner.current
	user.forceMove(heretic_lead_test_spot(0, 2))
	var/datum/eldritch_knowledge/base_lead/lead = heretic.get_knowledge(/datum/eldritch_knowledge/base_lead)
	var/obj/item/heretic_path_relic/lead_revolver/revolver = heretic_lead_test_revolver(heretic, user)
	var/mob/living/carbon/human/victim = heretic_lead_test_crew(get_step(user, EAST))
	var/mob/living/carbon/human/grabber = heretic_lead_test_crew(get_step(user, NORTH))
	lead.combat_resource = 3
	GLOB.unit_test_chat_capture = list()
	grabber.start_pulling(user)
	grabber.setGrabState(GRAB_AGGRESSIVE)
	TEST_ASSERT(!revolver.fire_at(victim, user), "В захвате выстрела нет.")
	TEST_ASSERT(heretic_lead_test_heard(user, "в захвате") && !heretic_lead_test_heard(user, "чужой разум"), "В захвате револьвер называет захват, а не чужой разум.")
	var/style = lead.drum_style
	for(var/action in list("alt", "ctrl", "self"))
		GLOB.unit_test_chat_capture = list()
		switch(action)
			if("alt")
				revolver.AltClick(user)
			if("ctrl")
				revolver.CtrlClick(user)
			if("self")
				revolver.attack_self(user)
		TEST_ASSERT(heretic_lead_test_heard(user, "в захвате"), "[action]: в захвате револьвер объясняет отказ.")
	TEST_ASSERT_EQUAL(lead.drum_style, style, "В захвате стиль не меняется.")
	grabber.stop_pulling()
	var/obj/structure/closet/closet = allocate(/obj/structure/closet, get_turf(user))
	user.forceMove(closet)
	GLOB.unit_test_chat_capture = list()
	COOLDOWN_RESET(revolver, shot_cooldown)
	TEST_ASSERT(!revolver.fire_at(victim, user), "Из шкафа выстрела нет.")
	TEST_ASSERT(heretic_lead_test_heard(user, "выберитесь наружу") && !heretic_lead_test_heard(user, "чужой разум"), "Из шкафа револьвер просит выбраться наружу.")
	user.forceMove(heretic_lead_test_spot(0, 2))
	revolver.attack_self(user)
	revolver.attack_self(user)
	TEST_ASSERT_EQUAL(lead.drum_style, HERETIC_LEAD_STYLE_FAN, "Веер включён.")
	GLOB.unit_test_chat_capture = list()
	COOLDOWN_RESET(revolver, shot_cooldown)
	TEST_ASSERT(revolver.fire_at(victim, user), "Веер начат.")
	TEST_ASSERT(heretic_lead_test_wait(CALLBACK(GLOBAL_PROC, GLOBAL_PROC_REF(heretic_lead_test_var_null), revolver, NAMEOF(revolver, fan_timer)), 3 SECONDS, "веер"), "Веер закончился.")
	TEST_ASSERT(lead.drum_style == HERETIC_LEAD_STYLE_PLAIN && heretic_lead_test_heard(user, "стиль снова"), "Конец веера говорит, что стиль снова обычный.")
	lead.combat_resource = lead.combat_resource_max
	lead.notify_resource_changed()
	var/flashes = lead.gain_flashes
	var/belt = lead.bandolier
	lead.gain_combat_resource()
	TEST_ASSERT(lead.bandolier == belt + 1 && lead.gain_flashes == flashes + 1, "Прибавка в патронташ вспыхивает на значке: [lead.bandolier], вспышек [lead.gain_flashes - flashes].")

/datum/unit_test/heretic_lead_honest_refusals/Destroy()
	GLOB.unit_test_chat_capture = null
	return ..()
