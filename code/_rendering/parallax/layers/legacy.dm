/**
 * Досовременный фон SS13 из tgstation (`old_parallax.dmi`).
 *
 * Пятнадцать стейтов, у каждого четыре кадра, и delay у каждого равен его же
 * имени: стейт "19" мигает с периодом 19, "43" - с периодом 43. Из-за этого
 * мерцание никогда не синхронизируется, и получается тот самый живой звёздный
 * шум, каким космос выглядел до параллакса.
 *
 * Все пятнадцать сразу мы не берём. Мигалки лежат ОВЕРЛЕЯМИ на базовом стейте, а
 * не отдельными слоями: они обязаны двигаться синхронно с базой (это один
 * рисунок, разложенный по фазам мерцания), и как оверлеи они достаются даром -
 * тайловые клоны самотайлинга наследуют их вместе с базой, а горячий прок
 * позиции по-прежнему обрабатывает ОДИН слой вместо пяти.
 */
/atom/movable/screen/parallax_layer/legacy
	icon = 'icons/effects/parallax/legacy_tg.dmi'
	icon_state = "1"
	speed = 1
	layer = 1
	parallax_intensity = PARALLAX_LOW
	/// Стейты-мигалки. Имя стейта - это его же период мерцания в децисекундах.
	var/static/list/blink_states = list("19", "26", "31", "37", "46")

/atom/movable/screen/parallax_layer/legacy/GetOverlays()
	. = list()
	for(var/blink_state in blink_states)
		. += mutable_appearance(icon, blink_state)
