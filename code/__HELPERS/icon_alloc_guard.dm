/**
 * Страж иконочных аллокаций: рантайм в `/icon/New()` не должен убивать раунд молча.
 *
 * ЧТО СЛУЧИЛОСЬ. 23.08.2026, раунды 10084-10090 - семь падений за тридцать пять минут
 * на Box Station при сотне игроков. В каждом раунде, чей лог успел долететь, ПОСЛЕДНЯЯ
 * запись в dd.log - это рантайм `proc name: New (/icon/New)` и его стек, после которых
 * мир не пишет больше ни строки:
 *
 * * 10086 - `generate_alpha_masked_clothing` из экипировки аутфита, умер при 2968 МБ;
 * * 10087 - `get_cached_flat_icon` -> `getFlatIcon` на examine ID-карты, при 2823 МБ;
 * * 10088 - очередь фото манифеста -> `build_flat_multidir_icon`, при 2923 МБ.
 *
 * Потолок адресного пространства у этого процесса - 4088 МБ. То есть умирали с запасом
 * больше гигабайта, и лестница предупреждений (она считает от потолка) не сработала ни
 * разу. Причина не в исчерпании памяти как таковом: `icon()` просит крупный НЕПРЕРЫВНЫЙ
 * блок, и в 32-битной куче, разодранной трёхгигабайтным рабочим набором, такой запрос
 * не находит места задолго до конца адресного пространства. Иконочная генерация -
 * самый крупный одиночный аллокатор кодовой базы, поэтому она и канарейка, и убийца.
 *
 * ПОЧЕМУ ЗДЕСЬ, А НЕ В `/world/Error`. Обработчик из error_handler.dm умеет ловить
 * "Out of resources!" и уводить мир на штатный ребут - но в этих семи падениях он не
 * сработал: в логах нет ни одной его строки, а заголовок рантайма отсутствует вовсе.
 * До DM-обработчика дело просто не дошло. Единственное, что ловит такой отказ, - это
 * try/catch прямо на месте вызова.
 *
 * ЧТО ДАЁТ. Во-первых, раунд переживает неудачную сборку иконки: вместо обрыва всего
 * стека вызовов место подстановки получает пустую иконку. Во-вторых, отказ становится
 * ВИДЕН - строкой в dd.log с полным контекстом памяти, сообщением админам и колонкой
 * `icon_alloc_failures` в perf-логе. Прежде первым и единственным признаком была
 * оборванная запись в логе.
 */

/// Сколько сборок иконок провалилось за раунд. Колонка perf-лога и повод для тревоги.
GLOBAL_VAR_INIT(icon_alloc_failures, 0)
/// TRUE после первого сообщения админам: тревога за раунд ровно одна, как и у лестницы памяти.
GLOBAL_VAR_INIT(icon_alloc_admins_warned, FALSE)
/// Пустая иконка на подмену провалившейся.
///
/// Заводится ЗАРАНЕЕ, на инициализации глобалок, а не по месту отказа. Собирать иконку в
/// обработчике неудавшейся сборки иконки - это ровно тот же запрос к ровно той же куче в
/// ровно тот же момент; она мала, но проверять это на живом сервере незачем.
GLOBAL_DATUM_INIT(icon_alloc_placeholder, /icon, icon('icons/effects/effects.dmi', "nothing"))

/**
 * Записать провалившуюся сборку иконки.
 *
 * Аргументы:
 * * context - что именно строилось, человеческими словами; попадёт в лог и админам
 * * error - пойманное исключение, если оно есть
 *
 * Возвращает пустую иконку, чтобы вызывающий мог написать `return note_icon_alloc_failure(...)`.
 * Иконка ОБЩАЯ на всех вызывающих - подмешивать в неё что-либо (Blend, Insert, Crop) нельзя.
 */
/proc/note_icon_alloc_failure(context, exception/error)
	GLOB.icon_alloc_failures++

	// Контекст памяти снимается прямо здесь, а не берётся из последней пробы подсистемы:
	// проба ходит раз в десять секунд, а на глазах у нас событие масштаба одного тика.
	var/list/memory = get_process_memory_mb()
	var/memory_note = "замер памяти недоступен"
	if(memory)
		var/ceiling = SStime_track?.process_address_ceiling_mb
		memory_note = "VmSize [memory["vsz"]] МБ[ceiling ? " из [ceiling]" : ""]"
		if(!isnull(memory["rss"]))
			memory_note += ", RSS [memory["rss"]] МБ"
		if(!isnull(memory["data"]))
			memory_note += ", куча VmData [memory["data"]] МБ"

	var/report = "не собралась иконка ([context])[error ? ": [error]" : ""]; [memory_note]; \
		провалов за раунд [GLOB.icon_alloc_failures]"
	log_world("## MEMORY: [report]")

	// Отметка в чёрный ящик МК. Мир после такого отказа живёт секунды, а буфер логов гибнет
	// вместе с процессом - в каскаде 23.08 из всей строки рантайма до диска доезжал один
	// голый стек без причины. Отметка лежит на диске и уходит в лог СЛЕДУЮЩЕГО раунда,
	// то есть переживает смерть. mc_state_note_death() тут не годится: он замораживает
	// дальнейшие записи сводки, а мир этот отказ вполне может и пережить.
	if(Master && !Master.state_snapshot_note)
		Master.state_snapshot_note = "ПРОВАЛ АЛЛОКАЦИИ: [report]"

	// Сообщение админам - одно за раунд, и только на ПЕРВОМ провале. Провалы идут пачками
	// (одна и та же генерация повторяется на каждом кадре), а сообщение, приходящее пачкой,
	// админы перестают читать ровно так же, как приходящее каждый раунд.
	if(!GLOB.icon_alloc_admins_warned)
		GLOB.icon_alloc_admins_warned = TRUE
		message_admins("<span class='boldannounce'>ПАМЯТЬ: [report]. Это отказ КРУПНОЙ НЕПРЕРЫВНОЙ \
			аллокации, а не исчерпание адресного пространства - до потолка обычно остаётся больше \
			гигабайта. Следующий такой отказ мир может не пережить: раунд имеет смысл увести на \
			рестарт. Повторных сообщений не будет, дальше смотреть колонку icon_alloc_failures \
			в perf-логе.</span>")

	return GLOB.icon_alloc_placeholder
