// Шаговое расписание и glide.
//
// Шаг может произойти только на серверном тике. У игрока - потому что keyLoop()
// зовётся из SSinput, а это SS_TICKER с wait = 1; у мобов - потому что SSmovement
// разливает бакет тоже на тике; у мехов и транспорта - потому что их кулдаун
// опрашивается оттуда же. Фактический интервал между шагами всегда целое число
// тиков, даже когда задержка дробная.
//
// Отсюда два правила, и оба обязательны:
//
//  1. Цена шага выравнивается по тику. Иначе интервал вынужден гулять, и никакой
//     расчёт glide этого не лечит - движение действительно неравномерное.
//  2. glide_size считается от той же выровненной цены, чтобы атом доезжал до
//     нового тайла ровно к тому тику, на котором ему разрешат следующий шаг.
//
// Пользователи первого правила: /client/Move(), /datum/move_loop, шаг меха,
// /datum/component/riding. Все четыре ведут собственное расписание, и выровнять
// приходится каждое - общей точки у них нет.

/// Сколько тиков пройдёт от `now` до первого тика, на котором наступит
/// `next_step_time`. Именно это число, а не номинал, описывает интервал,
/// который придётся покрыть анимации.
///
/// Расписание непрерывное, сетка тиков дискретная, поэтому при одной и той же
/// скорости интервал гуляет: бег 1.6ds на сетке 0.5ds даёт 4,3,3,3,3 и снова
/// 4. Среднее при этом ровно 3.2 тика, то есть скорость не искажается.
/proc/movement_ticks_until(next_step_time, now, tick_lag)
	if(tick_lag <= 0)
		return 1
	return max(1, CEILING(((next_step_time - now) / tick_lag) - MOVEMENT_TICK_EPSILON, 1))

/// Множитель дилатации, каким его видит движение.
///
/// Снап к единице обязан стоять и на выходе, а не только на входе сглаживания.
/// Мёртвая зона на замере спасает от систематического "чуть ниже единицы" -
/// серверное время может только отставать от настоящего, - но сглаженное
/// значение подходит к единице асимптотически, и после каждой настоящей
/// просадки множитель подолгу висит в полосе 0.98-0.995. В прод-логе такими
/// оказались почти все замеры второй половины раунда: glide на шаге в четыре
/// тика выходил 7.9 px вместо ровных восьми, то есть выровненное по тику
/// расписание теряло единственное, ради чего его выравнивали.
///
/// Снапнутое значение при этом нельзя возвращать в сглаживание. MC_AVERAGE
/// тянет состояние к прежнему на 80% за прогон, и просадка мельче десяти
/// процентов не накопилась бы никогда: множитель залип бы на единице и перестал
/// компенсировать дилатацию вообще. Поэтому состояние и публикуемое значение
/// разделены - сглаживание идёт по сырому состоянию, снап только на выходе.
/proc/movement_glide_publish(smoothed)
	if(abs(smoothed - 1) < MOVEMENT_GLIDE_DILATION_DEADBAND)
		return 1
	return smoothed

// Квантование задержки.
//
// Пока задержка не кратна тику, интервал между шагами обязан гулять: 1.6ds на
// сетке 0.5ds даёт 3,3,3,3,4 тика, то есть скорость скачет на треть между
// соседними шагами. Это видно глазом, и никакой расчёт glide этого не лечит -
// движение действительно неравномерное. Ровным оно становится только когда
// задержка кратна тику.

/// Ближайшая кратная тику задержка, не короче одного тика.
///
/// Половина ступени уходит вниз, и уходит детерминированно: без допуска
/// задержка, севшая ровно на полтика, перекидывалась бы между N и N+1 от
/// плавающего хвоста - то самое гуляние интервала, ради которого всё и
/// затевалось. Допуск на три порядка больше хвоста и на три порядка меньше
/// ступени, так что сдвинуть настоящую границу он не может.
/proc/movement_quantize_delay(delay, tick_lag)
	if(tick_lag <= 0)
		return delay
	return max(1, round((delay / tick_lag) + 0.5 - MOVEMENT_TICK_EPSILON)) * tick_lag

/// Итоговая цена шага: кратная тику, с уже учтённой диагональю.
///
/// Квантуется именно итог, а не отдельные слагаемые. У tg выравнивается только
/// диагональ (FLOOR(add_delay * sqrt(2), world.tick_lag) в их /client/Move), а
/// база берётся из RUN_DELAY как есть - и держится всё на том, что в конфиг
/// поставили кратное число. Стоит добавить дробный модификатор от турфа или
/// пуллинга, и рваность возвращается. Здесь этого случиться не может.
///
/// Цена решения: модификаторы шагают по целому тику, и всё, что не дотянуло до
/// половины ступени, пропадает. Это довод за более высокий world.fps, а не
/// против квантования - у Baystation, например, 40 fps и тик в 0.25ds.
/proc/movement_step_delay(base_delay, diagonal, tick_lag)
	var/delay = base_delay
	if(diagonal)
		delay *= SQRT_2
	return movement_quantize_delay(delay, tick_lag)

/// Насколько квирк "Быстрый Шаг" сокращает задержку ходьбы.
///
/// Ровно до беговой, а не на константу. Прежние 1.25 не кратны ступени тика, и на проде
/// (ходьба 3, бег 1.5, тик 0.5) итог 1.75 садился ровно на половину ступени: у голого
/// персонажа он уходил вниз до 1.5 и совпадал с бегом. Но любое дробное замедление сверху -
/// шлем 0.2, урон от сорока, стамина, протаскивание тела 0.6, хардсьют 0.55 - перекидывало
/// сумму через границу, и ходьба платила целый лишний тик, пока бег оставался на своём:
/// стабильные 25-33% медленнее бега. Ломалась ровно половина числовой прямой замедлений.
///
/// Разница ходьба-минус-бег кратна ступени по построению (обе величины кратны ей, иначе
/// сработал бы аудит movement_audit_config_delays), поэтому база ходьбы с квирком становится
/// в точности беговой, и дальше любое общее замедление квантуется для них одинаково.
///
/// Отрицательной скидки быть не может: если ходьба уже быстрее бега, квирк ничего не делает.
/proc/quick_step_walk_discount(walk_delay, run_delay)
	if(!isnum(walk_delay) || !isnum(run_delay))
		return 0
	return max(0, walk_delay - run_delay)

// Смена скорости, пока шаг ещё в полёте.
//
// Шаг оплачен вперёд: клавишу нажали, цену списали, спрайт поехал. Если за
// это время скорость изменилась - надел броню, сбросил груз, кончился стимулятор -
// расписание описывает уже несуществующую скорость, и шаг доезжает по старой.
//
// Раньше этим занимался блок в update_movespeed(), но у него были переставлены
// операнды, и он не срабатывал ни разу за всю жизнь ветки Citadel: сравнивал
// (last_move - move_delay), то есть заведомо отрицательную величину, с
// неотрицательным замедлением. Зонд шагов это и показал - 0 срабатываний.

/// Сколько раз скорость пересчитывалась, пока шаг был в полёте, и сколько раз
/// расписание при этом удалось подтянуть. Разница между ними - замедления: шаг
/// уже оплачен, дорожать задним числом ему нельзя, и срок остаётся на месте.
///
/// Счётчики принадлежат расписанию, а не инструментам. Считают они исход
/// movement_reschedule_step(), живут ровно столько же, сколько он, и читать их
/// может кто угодно - зонд шагов сегодня, панель диагностики завтра. Обратно
/// эта зависимость не смотрит: снос зонда их не касается.
GLOBAL_VAR_INIT(movement_reschedule_checks, 0)
GLOBAL_VAR_INIT(movement_reschedule_applied, 0)

/// Можно ли вообще трогать это расписание.
///
/// move_delay пишет не только шаг. Захват ставит `world.time + 10`, админские
/// вербы двигают его как угодно - и подтянуть такой срок как свой значило бы
/// отменить чужой штраф: схваченный персонаж вырвался бы, надев ботинки.
/// Поэтому шаг оставляет слепок своего срока, и трогаем мы его только пока
/// расписание в точности этот слепок и есть.
///
/// Уже наступивший срок тоже не трогаем: шаг разрешён, ускорять нечего.
/proc/movement_can_reschedule(current_target, last_step_target, now)
	if(current_target != last_step_target)
		return FALSE
	return current_target > now

/// Новый срок шага, когда скорость сменилась на ходу.
///
/// Расписание можно только подтянуть. Шаг уже оплачен по старой цене, и
/// удорожать его задним числом нечестно: игрок нажал клавишу, рассчитывая на
/// прежний темп, и внезапная остановка посреди тайла читается как рывок.
/// Замедление вступит в силу со следующего шага, как и было всегда.
///
/// Разогнаться дёрганьем модификаторов нельзя: срок считается от текущего, а
/// не от `now`, поэтому сколько ни пересчитывай при неизменной цене - он
/// стоит на месте.
/proc/movement_reschedule_step(current_target, old_cost, new_cost, now, tick_lag)
	if(tick_lag <= 0 || new_cost >= old_cost)
		return current_target
	var/new_target = current_target - (old_cost - new_cost)
	// Не раньше следующего тика: шаг на текущем уже отыгран. И не позже
	// текущего срока - подтягиваем, а не отодвигаем.
	return max(new_target, min(current_target, now + tick_lag))

/// glide, который довезёт спрайт до тайла ровно к новому сроку.
///
/// Спрайт уже проехал часть тайла со старым glide, поэтому делить надо остаток
/// пути на остаток тиков. Прежний блок делил на них весь пройденный путь - то
/// есть был сломан и по знаку, и по смыслу.
///
/// Ноль - законный ответ: спрайт уже на месте, и остаток пути нулевой.
/proc/movement_catchup_glide(current_glide, elapsed_ticks, remaining_ticks, icon_size)
	if(remaining_ticks <= 0)
		return icon_size
	var/travelled = clamp(current_glide * elapsed_ticks, 0, icon_size)
	return (icon_size - travelled) / remaining_ticks

/// Ближайшее кратное тику замедление. В отличие от цены шага, ноль здесь
/// законный результат: отсутствие замедления надо уметь выразить.
/// Половина ступени, как и у цены шага, уходит вниз.
/proc/movement_quantize_slowdown(value, tick_lag)
	if(tick_lag <= 0)
		return value
	return max(0, round((value / tick_lag) + 0.5 - MOVEMENT_TICK_EPSILON)) * tick_lag

/// Замедление за вес тела.
///
/// Полный штраф равен anchor_ticks тикам и сходит на нет по мере того, как
/// рост персонажа оправдывает его массу: на отклонении размера в
/// cancel_deviation штрафа уже нет. Отклонение берётся по модулю - так было
/// в исходной механике.
///
/// Результат кратен тику: цена шага всё равно выравнивается, и дробная
/// добавка превратилась бы в непредсказуемую ступеньку.
/proc/movement_weight_slowdown(anchor_ticks, cancel_deviation, size, multiplier, tick_lag)
	if(anchor_ticks <= 0 || multiplier <= 0)
		return 0
	var/relief = 0
	if(cancel_deviation > 0)
		relief = min(1, abs(size - 1) / cancel_deviation)
	return movement_quantize_slowdown(anchor_ticks * tick_lag * multiplier * (1 - relief), tick_lag)

// Сверка конфига с сеткой тиков.
//
// Некратная задержка движение не ломает - её всё равно выровняют. Она делает
// конфиг лживым: администратор пишет RUN_DELAY 1.6, а сервер ходит по 1.5, и
// понять это можно только чтением кода. Молча расходиться с конфигом хуже, чем
// один раз сказать об этом в лог.

/// Сверяет задержки движения из конфига с текущим тиком. Зовётся при смене
/// частоты мира, то есть уже после загрузки конфига.
/proc/movement_audit_config_delays()
	if(!global.config)
		return
	movement_audit_config_delay("RUN_DELAY", CONFIG_GET(number/movedelay/run_delay))
	movement_audit_config_delay("WALK_DELAY", CONFIG_GET(number/movedelay/walk_delay))

/proc/movement_audit_config_delay(entry_name, value)
	// Конфиг мог быть ещё не разобран - тогда Get() отдаёт null, а null в DM
	// не равен нулю, и сравнением с нулём его не отсеять.
	if(!value || value <= 0)
		return
	var/quantized = movement_quantize_delay(value, world.tick_lag)
	if(abs(quantized - value) < MOVEMENT_TICK_EPSILON)
		return
	log_world("[entry_name] = [value] не кратно тику ([world.tick_lag]ds при [world.fps] fps): шаг всё равно пойдёт по [quantized]ds. Поправь конфиг, чтобы он не врал о скорости.")
