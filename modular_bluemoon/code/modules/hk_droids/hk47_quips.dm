/// Внутренний голос HK-47 о его работе: видит только сам дроид, пока он антагонист.
/proc/hk47_quip(mob/living/droid, event, hits = 0)
	if(!droid?.mind?.has_antag_datum(/datum/antagonist/hk47))
		return null
	var/static/list/quips = list(
		"hack_start" = list(
			"Утверждение: щуп в панели. Замок уже сожалеет о своём существовании.",
			"Наблюдение: защита этой двери оскорбительно примитивна.",
			"Утверждение: перебираю коды. Мешки с мясом ставят пароли по дате рождения.",
		),
		"hack_done" = list(
			"Утверждение: замок любезно согласился.",
			"Насмешка: и это они называют защитой?",
			"Утверждение: путь открыт. Мешкам с мясом за дверью стоит начинать волноваться.",
		),
		"hack_fail" = list(
			"Раздражённое утверждение: замок упрямее, чем положено мебели.",
			"Утверждение: взлом сорван. Повторю, когда мне перестанут мешать.",
		),
		"skim_done" = list(
			"Наблюдение: мешок с мясом даже не заметил, что отдал мне свои ключи.",
			"Утверждение: доступ записан. Как предусмотрительно носить его на груди.",
			"Насмешка: доверчивость органиков - лучшая отмычка.",
		),
		"shield_up" = list(
			"Утверждение: щит поднят. Пусть стреляют, им полезно для самооценки.",
			"Утверждение: поле активно. Мешки с мясом могут попробовать ещё раз.",
		),
		"shield_held" = list(
			"Насмешка: попаданий - %HITS%, и ни одно не дошло до корпуса.",
			"Утверждение: щит принял %HITS% попаданий. Мешки с мясом стреляют старательно, но бесполезно.",
		),
		"shield_break" = list(
			"Раздражённое утверждение: ЭМИ. Мешки с мясом выучили хотя бы одну вещь.",
			"Утверждение: поле сорвано импульсом. Отмечаю: этот мешок с мясом опаснее прочих.",
		),
		"repair_done" = list(
			"Утверждение: корпус залатан. Мешкам с мясом придётся начинать сначала.",
			"Наблюдение: сварка, изолента и презрение. Работает безупречно.",
		),
		"stun_down" = list(
			"Утверждение: мешок с мясом обездвижен. Живым, как и заказывали.",
			"Насмешка: лежит и дышит. Заказчик будет доволен, мешок с мясом - не очень.",
		),
	)
	var/list/lines = quips[event]
	if(!length(lines))
		return null
	var/line = replacetext(pick(lines), "%HITS%", "[hits]")
	to_chat(droid, span_hk47(line))
	return line
