GLOBAL_LIST_INIT(heretic_playstyle_labels, list(
	"melee" = "ближний бой",
	"territory" = "территория",
	"traps" = "ловушки",
	"ranged" = "дальний бой",
	"retinue" = "свита",
	"rhythm" = "ритм",
	"stealth" = "скрытность",
))

/// Порядок карточек выбора внутри групп сложности: раньше те, у кого начало прощает больше ошибок.
GLOBAL_LIST_INIT(heretic_path_choice_order, list(
	PATH_RUST, PATH_GLASS, PATH_ASH,
	PATH_TIDE, PATH_COSMIC, PATH_WAX, PATH_BLADE, PATH_LEAD, PATH_ECHO, PATH_VOID,
	PATH_LOCK, PATH_FLESH, PATH_BLOOD, PATH_MOON, PATH_SAND, PATH_SPIRIT, PATH_DANCE,
))

/datum/heretic_path
	/// Сложность старта от 1 до 3: кнопки, запасы и звенья захвата на ступенях I-III.
	var/difficulty
	/// Один-два ключа из GLOB.heretic_playstyle_labels.
	var/list/playstyle
	/// Сила, дело и цель: три строки, которые кодекс показывает до выбора пути.
	var/list/first_steps

/datum/heretic_path/proc/playstyle_labels()
	. = list()
	for(var/style in playstyle)
		var/label = GLOB.heretic_playstyle_labels[style]
		if(label)
			. += label

/proc/heretic_paths_in_choice_order()
	. = list()
	for(var/path_id in GLOB.heretic_path_choice_order)
		var/datum/heretic_path/path = GLOB.heretic_paths[path_id]
		if(path)
			. += path
	for(var/path_id in GLOB.heretic_paths)
		. |= GLOB.heretic_paths[path_id]

