/datum/status_effect/heretic_spirit/separated
	id = "heretic_spirit_separated"
	duration = 10 SECONDS
	tick_interval = 0.5 SECONDS
	status_type = STATUS_EFFECT_UNIQUE
	alert_type = /atom/movable/screen/alert/status_effect/heretic_spirit
