/datum/eldritch_knowledge/base_spirit/on_gain(mob/user)
	. = ..()
	var/datum/antag_training_session/session = GLOB.antag_training_sessions[user?.ckey]
	if(session?.current_body == user && !session.spirit_lesson)
		to_chat(user, span_notice("Для Духа на полигоне есть пошаговый урок: панель полигона, вкладка «Начать», раздел «2. Упражнение», кнопка «Урок Духа»."))

/datum/eldritch_knowledge/base_spirit/on_body_gain(mob/living/user)
	if(!user?.mind || spirit_body == user)
		return
	if(spirit_body)
		on_body_lose(spirit_body)
	spirit_body = user
	RegisterSignal(user, COMSIG_PARENT_QDELETING, PROC_REF(on_body_deleted))
	RegisterSignal(user, COMSIG_MOB_LOGIN, PROC_REF(on_body_login))
	RegisterSignal(user, COMSIG_MOB_CLIENT_LOGOUT, PROC_REF(on_body_logout))
	RegisterSignal(SSdcs, COMSIG_GLOB_MOB_DEATH, PROC_REF(on_any_death))
	show_death_marks(user)
	grant_combat_power(user)
	update_capacity()
	COOLDOWN_START(src, spirit_recovery, HERETIC_SPIRIT_RECOVERY)

/datum/eldritch_knowledge/base_spirit/on_body_lose(mob/living/user)
	if(spirit_body)
		UnregisterSignal(spirit_body, list(COMSIG_PARENT_QDELETING, COMSIG_MOB_LOGIN, COMSIG_MOB_CLIENT_LOGOUT))
	hide_death_marks()
	UnregisterSignal(SSdcs, COMSIG_GLOB_MOB_DEATH)
	unmoor()
	clear_spirit()
	spirit_body = null
	ascension_active = FALSE
	combat_resource = 0
	remove_combat_power()
	notify_resource_changed()

/datum/eldritch_knowledge/base_spirit/proc/on_body_deleted(datum/source)
	SIGNAL_HANDLER
	on_body_lose(spirit_body)

/datum/eldritch_knowledge/base_spirit/on_death(mob/user)
	clear_spirit()
	combat_resource = 0
	COOLDOWN_START(src, spirit_recovery, HERETIC_SPIRIT_RECOVERY)
	notify_resource_changed()

/datum/eldritch_knowledge/base_spirit/Destroy()
	on_body_lose(spirit_body)
	for(var/mob/living/corpse as anything in obols.Copy())
		remove_obol(corpse)
	obols.Cut()
	obol_ghosts.Cut()
	whisper_ready.Cut()
	point_ready.Cut()
	death_marks.Cut()
	death_times.Cut()
	deed_bodies.Cut()
	return ..()

/datum/eldritch_knowledge/base_spirit/proc/clear_spirit()
	soul_hold?.release("перевозчик потерял тело")
	QDEL_LIST(souls)
	QDEL_LIST(marks)
	QDEL_LIST(visuals)

/datum/eldritch_knowledge/base_spirit/proc/clear_knowledge_effects(datum/eldritch_knowledge/required)
	for(var/datum/status_effect/heretic_spirit/separated/soul as anything in souls.Copy())
		if(soul.knowledge_ref?.resolve() == required || soul.reaping_ref?.resolve() == required)
			qdel(soul)

/datum/eldritch_knowledge/base_spirit/proc/can_use(mob/living/user, allow_incapacitated = FALSE, ignore_grab = FALSE)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	return !QDELETED(src) && user && user == spirit_body && user.stat != DEAD && (allow_incapacitated || !heretic_incapacitated(user, ignore_grab)) && isturf(user.loc) && heretic?.selected_path == PATH_SPIRIT && !heretic.role_removed && heretic.get_knowledge(type) == src

/datum/eldritch_knowledge/base_spirit/proc/tile_open(turf/tile)
	return isopenturf(tile) && !tile.is_blocked_turf(exclude_mobs = TRUE)

/datum/eldritch_knowledge/base_spirit/proc/low_obstacle(obj/thing)
	return (thing.pass_flags_self & (PASSTABLE | LETPASSTHROW)) || istype(thing, /obj/structure/railing)

/datum/eldritch_knowledge/base_spirit/proc/tile_passable(turf/tile)
	if(!isopenturf(tile))
		return FALSE
	for(var/obj/thing in tile)
		if(thing.density && !(thing.flags_1 & ON_BORDER_1) && !low_obstacle(thing))
			return FALSE
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/edge_open(turf/from_turf, turf/to_turf)
	var/direction = get_dir(from_turf, to_turf)
	for(var/obj/thing in from_turf)
		if(thing.density && (thing.flags_1 & ON_BORDER_1) && thing.dir == direction && !low_obstacle(thing))
			return FALSE
	var/reverse = REVERSE_DIR(direction)
	for(var/obj/thing in to_turf)
		if(thing.density && (thing.flags_1 & ON_BORDER_1) && thing.dir == reverse && !low_obstacle(thing))
			return FALSE
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/step_open(turf/from_turf, turf/to_turf)
	if(from_turf.x == to_turf.x || from_turf.y == to_turf.y)
		return edge_open(from_turf, to_turf)
	var/turf/corner_a = locate(from_turf.x, to_turf.y, to_turf.z)
	var/turf/corner_b = locate(to_turf.x, from_turf.y, to_turf.z)
	return tile_passable(corner_a) && tile_passable(corner_b) && edge_open(from_turf, corner_a) && edge_open(corner_a, to_turf) && edge_open(from_turf, corner_b) && edge_open(corner_b, to_turf)

/datum/eldritch_knowledge/base_spirit/proc/line_clear(atom/start, atom/target, distance = HERETIC_SPIRIT_RANGE)
	var/turf/origin = get_turf(start)
	var/turf/destination = get_turf(target)
	if(!origin || !destination || origin.z != destination.z || get_dist(origin, destination) > distance)
		return FALSE
	var/turf/previous
	for(var/turf/tile as anything in get_line(origin, destination))
		if(!tile_passable(tile) || (previous && !step_open(previous, tile)))
			return FALSE
		previous = tile
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/own_soul_at(atom/target)
	var/turf/tile = get_turf(target)
	if(!tile)
		return null
	for(var/obj/structure/heretic_spirit_soul/anchor in tile)
		var/datum/status_effect/heretic_spirit/separated/soul = anchor.effect_ref?.resolve()
		if(soul?.spirit_ref?.resolve() == src)
			return anchor
	return null

/// Своя душа по клику на силуэт, на тело, чья это душа, или на тело, стоящее на ней.
/datum/eldritch_knowledge/base_spirit/proc/soul_anchor_of(atom/target)
	if(isliving(target))
		var/mob/living/victim = target
		var/datum/status_effect/heretic_spirit/separated/soul = victim.has_status_effect(/datum/status_effect/heretic_spirit/separated)
		if(soul?.spirit_ref?.resolve() == src && !QDELETED(soul.anchor))
			return soul.anchor
	return own_soul_at(target)

/datum/eldritch_knowledge/base_spirit/proc/refresh_soul_buttons()
	var/obj/effect/proc_holder/spell/pull = pull_spell(spirit_body)
	pull?.action?.UpdateButtons()

/datum/eldritch_knowledge/base_spirit/combat_resource_state()
	. = "Душ: [length(souls)] из [ascension_active ? HERETIC_SPIRIT_ASCENDED_SOUL_LIMIT : HERETIC_SPIRIT_SOUL_LIMIT]. Оболов на глазах: [length(obols)] из [HERETIC_SPIRIT_OBOL_LIMIT]."
	if(ascension_active)
		. += moored() ? " Причал горит в «[get_area_name(mooring, TRUE)]»." : " Причала нет."

/// Причал вознесения стоит: пока он горит, оболы идут быстрее, а смерть рядом платит.
/datum/eldritch_knowledge/base_spirit/proc/moored()
	return ascension_active && !QDELETED(mooring)

/datum/eldritch_knowledge/base_spirit/on_life(mob/user)
	if(!can_use(user) || !COOLDOWN_FINISHED(src, spirit_recovery))
		return
	var/fast = moored()
	if(fast || combat_resource < 2)
		gain_combat_resource()
	COOLDOWN_START(src, spirit_recovery, fast ? 4 SECONDS : HERETIC_SPIRIT_RECOVERY)

/datum/eldritch_knowledge/base_spirit/on_mark_detonated(mob/living/user, mob/living/target)
	if(can_use(user) && isturf(target?.loc) && heretic_can_affect(user, target, chargecost = 0))
		gain_combat_resource()

/datum/eldritch_knowledge/base_spirit/on_eldritch_blade(atom/target, mob/user, proximity_flag, click_parameters)
	if(!proximity_flag || !isliving(target) || !can_use(user) || !COOLDOWN_FINISHED(src, spirit_hook_income))
		return
	var/mob/living/victim = target
	var/datum/status_effect/heretic_spirit/separated/soul = victim.has_status_effect(/datum/status_effect/heretic_spirit/separated)
	if(soul?.spirit_ref?.resolve() != src || !soul.validate_link())
		return
	COOLDOWN_START(src, spirit_hook_income, HERETIC_SPIRIT_HOOK_INCOME)
	gain_combat_resource()
	heretic_vfx_pulse(user, heretic_path_ink(PATH_SPIRIT), 1, HERETIC_SPIRIT_INCOME_PULSE)
	playsound(user, 'modular_bluemoon/sound/heretic/spirit_obol_gain.ogg', 35, TRUE, SILENCED_SOUND_EXTRARANGE)

/datum/eldritch_knowledge/base_spirit/proc/update_capacity(ignore_purse = FALSE)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(spirit_body)
	var/datum/eldritch_knowledge/spirit_relic/purse = heretic?.get_knowledge(/datum/eldritch_knowledge/spirit_relic)
	combat_resource_max = ascension_active ? 8 : !ignore_purse && !QDELETED(purse) ? purse.passive_values[purse.passive_level] : initial(combat_resource_max)
	combat_resource = min(combat_resource, combat_resource_max)
	notify_resource_changed()

/datum/eldritch_knowledge/base_spirit/proc/separate(mob/living/victim, datum/eldritch_knowledge/required)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(spirit_body)
	if(!can_use(spirit_body) || QDELETED(required) || heretic.get_knowledge(required.type) != required || !isturf(victim?.loc) || !line_clear(spirit_body, victim) || !heretic_can_affect(spirit_body, victim, chargecost = 0))
		return null
	var/datum/status_effect/heretic_spirit/separated/existing = victim.has_status_effect(/datum/status_effect/heretic_spirit/separated)
	if(existing)
		return existing.spirit_ref?.resolve() == src ? existing : null
	if(length(souls) >= (ascension_active ? HERETIC_SPIRIT_ASCENDED_SOUL_LIMIT : HERETIC_SPIRIT_SOUL_LIMIT))
		qdel(souls[1])
	. = victim.apply_status_effect(/datum/status_effect/heretic_spirit/separated, src, required)
	if(.)
		SEND_SIGNAL(src, COMSIG_HERETIC_SPIRIT_EVENT, "separate", victim)

/datum/eldritch_knowledge/base_spirit/proc/collect(mob/living/user, datum/status_effect/heretic_spirit/separated/soul)
	if(!can_use(user) || QDELETED(soul) || soul.spirit_ref?.resolve() != src || !soul.validate_link() || !user.Adjacent(soul.anchor))
		return FALSE
	var/mob/living/victim = soul.owner
	var/reward = victim.mind && victim.mob_size >= MOB_SIZE_HUMAN && COOLDOWN_FINISHED(src, spirit_harvest)
	var/resource_before = combat_resource
	new /obj/effect/temp_visual/heretic_spirit/burst(get_turf(soul.anchor), src)
	soul.reap_end_reason = "перевозчик собрал душу"
	qdel(soul)
	if(reward)
		gain_combat_resource()
		user.adjustStaminaLoss(-HERETIC_SPIRIT_STAMINA_RESTORE)
		COOLDOWN_START(src, spirit_harvest, HERETIC_SPIRIT_HARVEST)
		to_chat(user, span_notice("Фонарь принимает плату за переправу. Вы получаете обол."))
	user.log_message("Собрана душа [key_name(victim)]: получено [combat_resource - resource_before] оболов, запас [combat_resource]/[combat_resource_max].", LOG_ATTACK)
	playsound(user, 'modular_bluemoon/sound/heretic/spirit_collect.ogg', 45, TRUE)
	return reward

/datum/eldritch_knowledge/base_spirit/proc/sever(mob/living/user, mob/living/victim)
	if(!can_use(user) || !isturf(victim?.loc) || !line_clear(user, victim) || !heretic_can_affect(user, victim, chargecost = 0) || !spend_combat_resource())
		return FALSE
	if(!heretic_can_affect(user, victim))
		return TRUE
	var/brute_before = victim.getBruteLoss()
	var/stamina_before = victim.getStaminaLoss()
	victim.adjustBruteLoss(20)
	if(!can_use(user) || QDELETED(victim))
		return TRUE
	victim.adjustStaminaLoss(15)
	log_combat(user, victim, "поражает Разлучением", addition = "фактически [round(victim.getBruteLoss() - brute_before, 0.1)] ушибов и [round(victim.getStaminaLoss() - stamina_before, 0.1)] выносливости")
	separate(victim, src)
	new /obj/effect/temp_visual/heretic_spirit/grasp(get_turf(victim), src)
	playsound(victim, 'modular_bluemoon/sound/heretic/spirit_grasp.ogg', 60, TRUE)
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/crossing_fail(reason)
	crossing_failure = reason
	return null

/datum/eldritch_knowledge/base_spirit/proc/crossing_destination(mob/living/user, atom/target)
	crossing_failure = null
	var/turf/origin = get_turf(user)
	var/turf/aim = get_turf(target)
	if(!origin || !aim || origin.z != aim.z)
		return crossing_fail("Выберите клетку на своём уровне.")
	var/obj/structure/heretic_spirit_soul/anchor = own_soul_at(target)
	var/datum/status_effect/heretic_spirit/separated/soul = anchor?.effect_ref?.resolve()
	var/step_range = soul?.validate_link() ? HERETIC_SPIRIT_RANGE : HERETIC_SPIRIT_STEP_RANGE
	var/distance = get_dist(origin, aim)
	if(distance > HERETIC_SPIRIT_RANGE)
		return crossing_fail("Слишком далеко: Переправа ведёт на [HERETIC_SPIRIT_STEP_RANGE] клетки, к своей душе — на [HERETIC_SPIRIT_RANGE].")
	if(distance > step_range)
		var/list/path = get_line(origin, aim)
		aim = path[step_range + 1]
	if(aim == origin)
		return crossing_fail("Выберите другую клетку, а не ту, где стоите.")
	if(!tile_open(aim))
		return crossing_fail("Место прибытия закрыто стеной или плотным предметом.")
	if(!line_clear(origin, aim, step_range))
		return crossing_fail("Путь закрыт стеной, окном или другой преградой.")
	if(!aim.is_blocked_turf())
		return aim
	var/back_dir = get_dir(aim, origin)
	for(var/turn_angle in list(0, 45, -45, 90, -90))
		var/turf/spot = get_step(aim, turn(back_dir, turn_angle))
		if(spot && spot != origin && tile_open(spot) && !spot.is_blocked_turf() && line_clear(spot, aim, 1) && line_clear(origin, spot, step_range))
			return spot
	return crossing_fail("Место занято, и рядом с ним с вашей стороны нет свободной клетки.")

/datum/eldritch_knowledge/base_spirit/proc/crossing_passenger(mob/living/user)
	var/mob/living/passenger = user.pulling
	if(!isliving(passenger) || !isturf(passenger.loc) || passenger.anchored || passenger.buckled || HAS_TRAIT(passenger, TRAIT_NO_TELEPORT))
		return null
	if(passenger.body_position != LYING_DOWN && !passenger.incapacitated())
		return null
	if(passenger.check_magic_resistance(chargecost = 0))
		return null
	return passenger

/datum/eldritch_knowledge/base_spirit/proc/carry_passenger(mob/living/user, mob/living/passenger, turf/origin, grab_state)
	if(QDELETED(passenger) || !isturf(passenger.loc) || get_dist(passenger, origin) > 1)
		return FALSE
	var/turf/landing = get_turf(user)
	var/back_dir = get_dir(landing, origin)
	for(var/turn_angle in list(0, 45, -45, 90, -90, 135, -135, 180))
		var/turf/spot = get_step(landing, turn(back_dir, turn_angle))
		if(!spot || !tile_open(spot) || spot.is_blocked_turf() || !line_clear(landing, spot, 1))
			continue
		if(!do_teleport(passenger, spot, channel = TELEPORT_CHANNEL_MAGIC) || get_turf(passenger) != spot)
			return FALSE
		// forceMove любого из двух мобов рвёт захват, поэтому он ставится заново.
		user.start_pulling(passenger, null, user.pull_force, TRUE)
		if(user.pulling == passenger && grab_state > GRAB_PASSIVE)
			user.setGrabState(grab_state)
			passenger.update_mobility()
		new /obj/effect/temp_visual/heretic_spirit/step(spot, src)
		log_combat(user, passenger, "переносит Переправой")
		return TRUE
	return FALSE

/datum/eldritch_knowledge/base_spirit/proc/cross(mob/living/user, atom/target, preserve_soul = FALSE)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/eldritch_knowledge/required = heretic?.get_knowledge(/datum/eldritch_knowledge/spell/spirit_step)
	crossing_failure = null
	if(!can_use(user) || QDELETED(required))
		return FALSE
	if(combat_resource < 1)
		crossing_failure = "Нужен 1 обол."
		return FALSE
	if(user.buckled || user.anchored || HAS_TRAIT(user, TRAIT_NO_TELEPORT))
		crossing_failure = "Вы пристёгнуты, закреплены или не можете телепортироваться."
		return FALSE
	var/turf/destination = crossing_destination(user, target)
	if(!destination)
		return FALSE
	var/obj/structure/heretic_spirit_soul/anchor = own_soul_at(target)
	var/datum/status_effect/heretic_spirit/separated/soul = anchor?.effect_ref?.resolve()
	var/mob/living/passenger = crossing_passenger(user)
	var/grab_state_before = user.grab_state
	var/turf/origin = get_turf(user)
	if(!do_teleport(user, destination, channel = TELEPORT_CHANNEL_MAGIC) || get_turf(user) != destination)
		crossing_failure = "Переход сорвался: это место закрыто для телепортации."
		return FALSE
	if(!can_use(user) || QDELETED(required))
		return TRUE
	spend_combat_resource()
	if(passenger)
		carry_passenger(user, passenger, origin, grab_state_before)
	new /obj/effect/temp_visual/heretic_spirit/step(origin, src)
	new /obj/effect/temp_visual/heretic_spirit/step(destination, src)
	heretic_spirit_afterimage(user, origin, destination)
	if(!preserve_soul && soul?.spirit_ref?.resolve() == src)
		collect(user, soul)
	else if(preserve_soul && !QDELETED(soul) && soul.spirit_ref?.resolve() == src)
		to_chat(user, span_notice("Душа остаётся на берегу: связь, её срок и накопленное истощение сохраняются."))
	user.adjustStaminaLoss(-HERETIC_SPIRIT_STAMINA_RESTORE)
	playsound(user, 'modular_bluemoon/sound/heretic/spirit_step.ogg', 55, TRUE)
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/can_shift_soul(mob/living/user, obj/structure/heretic_spirit_soul/anchor, turf/origin)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/status_effect/heretic_spirit/separated/soul = anchor?.effect_ref?.resolve()
	var/datum/eldritch_knowledge/required = heretic?.get_knowledge(/datum/eldritch_knowledge/spirit_grasp)
	shift_failure = null
	if(!can_use(user) || QDELETED(required))
		shift_failure = "Тянуть душу учит «Душа на ладони»; нужно своё тело еретика."
	else if(QDELETED(anchor) || soul?.spirit_ref?.resolve() != src)
		shift_failure = "Здесь нет ни живого врага, ни отделённой вами души. Укажите цель по телу: без души кнопка отделит её сама за обол."
	else if(soul.shifted)
		shift_failure = "Эту душу уже притянули. Отделите новую: каждую душу тянут только один раз."
	else if(origin && anchor.loc != origin)
		shift_failure = "Душа переместилась во время подготовки. Выберите её снова."
	else if(get_dist(user, anchor) < HERETIC_SPIRIT_PULL_MIN)
		shift_failure = "Вы слишком близко к душе: притянуть её можно из [HERETIC_SPIRIT_PULL_MIN]-[HERETIC_SPIRIT_RANGE] клеток."
	else if(get_dist(user, anchor) > HERETIC_SPIRIT_RANGE)
		shift_failure = "Душа слишком далеко. Подойдите на [HERETIC_SPIRIT_PULL_MIN]-[HERETIC_SPIRIT_RANGE] клеток."
	else if(!line_clear(user, anchor))
		shift_failure = "Путь к душе закрыт преградой. Встаньте на открытую линию."
	else if(!soul.validate_link())
		shift_failure = "Связь с телом оборвана. Снова отделите душу Разлучением."
	return !shift_failure

/// Клетка, куда притянется душа: до двух шагов к перевозчику, но не на его клетку.
/datum/eldritch_knowledge/base_spirit/proc/pull_destination(mob/living/user, turf/origin)
	var/turf/user_turf = get_turf(user)
	. = origin
	for(var/index in 1 to HERETIC_SPIRIT_PULL_STEPS)
		var/turf/next = get_step_towards(., user)
		if(!next || next == user_turf)
			return
		. = next

/datum/eldritch_knowledge/base_spirit/proc/shift_soul(mob/living/user, obj/structure/heretic_spirit_soul/anchor)
	if(!can_shift_soul(user, anchor))
		return FALSE
	var/datum/status_effect/heretic_spirit/separated/soul = anchor.effect_ref.resolve()
	if(soul.shifting)
		return FALSE
	var/turf/origin = get_turf(anchor)
	var/turf/destination = pull_destination(user, origin)
	if(destination == origin || !line_clear(origin, destination) || !line_clear(destination, soul.owner))
		shift_failure = "Душе некуда сдвинуться: между ней и вами преграда."
		return FALSE
	soul.shifting = TRUE
	soul.pull_line = user.Beam(anchor, icon_state = HERETIC_SPIRIT_PULL_LINE, icon = 'modular_bluemoon/icons/obj/heretic_spirit_effects.dmi', time = HERETIC_SPIRIT_PULL_LINE_TIME, maxdistance = HERETIC_SPIRIT_RANGE + 1)
	playsound(anchor, 'modular_bluemoon/sound/heretic/spirit_pull_strain.ogg', 50, FALSE)
	to_chat(soul.owner, span_userdanger("Перевозчик тянет вашу душу к себе! Коснитесь её или разбейте, чтобы оборвать связь."))
	var/completed = do_after(user, 1 SECONDS, target = user, extra_checks = CALLBACK(src, PROC_REF(can_shift_soul), user, anchor, origin))
	if(QDELETED(soul))
		return FALSE
	soul.shifting = FALSE
	QDEL_NULL(soul.pull_line)
	if(!completed || !can_shift_soul(user, anchor, origin) || !line_clear(origin, destination) || !line_clear(destination, soul.owner))
		return FALSE
	soul.shifted = TRUE
	anchor.forceMove(destination)
	heretic_spirit_afterimage(anchor, origin, destination)
	playsound(anchor, 'modular_bluemoon/sound/heretic/spirit_pull.ogg', 55, TRUE)
	log_combat(user, soul.owner, "притягивает отделённую душу")
	SEND_SIGNAL(src, COMSIG_HERETIC_SPIRIT_EVENT, "pull", soul.owner)
	return TRUE

/// Взрыв Метки Духа бросает душу за спину перевозчика: тело отрезано от неё, а её можно сразу взять в руку.
/datum/eldritch_knowledge/base_spirit/proc/yank_soul(mob/living/user, datum/status_effect/heretic_spirit/separated/soul)
	if(QDELETED(soul) || soul.shifting || soul.spirit_ref?.resolve() != src || !soul.validate_link() || !can_use(user))
		return FALSE
	var/turf/user_turf = get_turf(user)
	var/turf/body_turf = get_turf(soul.owner)
	var/turf/origin = get_turf(soul.anchor)
	var/back_dir = get_dir(body_turf, user_turf) || REVERSE_DIR(user.dir)
	for(var/turn_angle in list(0, 45, -45, 90, -90))
		var/turf/spot = get_step(user_turf, turn(back_dir, turn_angle))
		if(!spot || spot == body_turf || !tile_open(spot) || !line_clear(user_turf, spot, 1) || !line_clear(spot, soul.owner))
			continue
		soul.shifted = TRUE
		if(spot != origin)
			soul.anchor.forceMove(spot)
			if(QDELETED(soul))
				return FALSE
			heretic_spirit_afterimage(soul.anchor, origin, spot)
			playsound(spot, 'modular_bluemoon/sound/heretic/spirit_pull.ogg', 55, TRUE)
		to_chat(soul.owner, span_userdanger("Метка вырвала вашу душу за спину перевозчика! Обойдите его и коснитесь души, пока её не взяли в руку."))
		log_combat(user, soul.owner, "вырывает душу взрывом Метки Духа")
		SEND_SIGNAL(src, COMSIG_HERETIC_SPIRIT_EVENT, "pull", soul.owner)
		return TRUE
	return FALSE

/// Кошель утонувших: связь разумного врага, истощившая предел до дна, роняет обол.
/datum/eldritch_knowledge/base_spirit/proc/purse_toll(mob/living/victim)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(spirit_body)
	var/datum/eldritch_knowledge/spirit_relic/purse = heretic?.get_knowledge(/datum/eldritch_knowledge/spirit_relic)
	if(!can_use(spirit_body, TRUE) || QDELETED(purse) || !victim?.mind || victim.mob_size < MOB_SIZE_HUMAN)
		return FALSE
	gain_combat_resource()
	heretic_vfx_pulse(spirit_body, heretic_path_ink(PATH_SPIRIT), 1, HERETIC_SPIRIT_INCOME_PULSE)
	playsound(spirit_body, 'modular_bluemoon/sound/heretic/spirit_obol_gain.ogg', 35, TRUE, SILENCED_SOUND_EXTRARANGE)
	to_chat(spirit_body, span_notice("Связь [victim] истощилась до дна: в Кошеле утонувших звякнул новый обол."))
	return TRUE

/// Почему «Притянуть душу» не берёт эту цель: соседнюю душу кнопка берёт в руку, дальнюю - тянет к себе, у живого тела без души сперва отделяет её.
/datum/eldritch_knowledge/base_spirit/proc/soul_reach_reason(mob/living/user, atom/target)
	var/obj/structure/heretic_spirit_soul/anchor = soul_anchor_of(target)
	if(!anchor && isliving(target))
		return pull_separation_reason(user, target)
	if(anchor && anchor.z == user.z && get_dist(user, anchor) <= HERETIC_SPIRIT_HOLD_REACH)
		var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
		if(!heretic?.get_knowledge(/datum/eldritch_knowledge/spell/spirit_hold))
			return "Душа рядом с вами: в руку её берут со знанием «Удержать душу», а притянуть можно из [HERETIC_SPIRIT_PULL_MIN]-[HERETIC_SPIRIT_RANGE] клеток."
		return hold_block_reason(user, target)
	return can_shift_soul(user, anchor) ? null : shift_failure

/// Почему «Притянуть душу» не отделит душу этого тела сама; проверяется до траты обола.
/datum/eldritch_knowledge/base_spirit/proc/pull_separation_reason(mob/living/user, mob/living/victim)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/eldritch_knowledge/spirit_grasp/grasp = heretic?.get_knowledge(/datum/eldritch_knowledge/spirit_grasp)
	if(!can_use(user) || QDELETED(grasp))
		return "Способность недоступна вашему пути или текущему телу."
	if(victim == user || IS_HERETIC(victim) || IS_HERETIC_MONSTER(victim))
		return "Это союзник Мансуса: душу отделяют только у живого противника."
	if(victim.stat == DEAD || !isturf(victim.loc))
		return "Нужно живое тело вне шкафа или другого контейнера."
	if(victim.has_status_effect(/datum/status_effect/heretic_spirit/separated))
		return "Душу этой цели уже отделил другой перевозчик."
	if(!line_clear(user, victim))
		return "Цель должна быть не дальше [HERETIC_SPIRIT_RANGE] клеток по открытой линии без стен и преград."
	if(!heretic_can_affect(user, victim, chargecost = 0))
		return "Цель защищена от магии."
	if(victim.z == user.z && get_dist(user, victim) <= HERETIC_SPIRIT_HOLD_REACH)
		if(!heretic.get_knowledge(/datum/eldritch_knowledge/spell/spirit_hold))
			return "Цель рядом с вами: притянуть душу можно из [HERETIC_SPIRIT_PULL_MIN]-[HERETIC_SPIRIT_RANGE] клеток, а в руку её берут со знанием «Удержать душу»."
		var/hold_reason = hold_victim_reason(user, victim)
		if(hold_reason)
			return hold_reason
	if(combat_resource < 1)
		return "Отделить душу этой кнопкой стоит 1 обол, а кошель пуст: первые два обола вернутся сами."
	return null

/// «Притянуть душу» по живому телу без души: отделяет её за обол, без урона, прямо на месте тела.
/datum/eldritch_knowledge/base_spirit/proc/pull_separate(mob/living/user, mob/living/victim)
	shift_failure = pull_separation_reason(user, victim)
	if(shift_failure)
		return null
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/status_effect/heretic_spirit/separated/soul = separate(victim, heretic.get_knowledge(/datum/eldritch_knowledge/spirit_grasp))
	if(!soul)
		shift_failure = "Душа не отделилась: связь с телом не держится."
		return null
	spend_combat_resource()
	log_combat(user, victim, "отделяет душу кнопкой «Притянуть душу»")
	new /obj/effect/temp_visual/heretic_spirit/grasp(get_turf(victim), src)
	playsound(victim, 'modular_bluemoon/sound/heretic/spirit_grasp.ogg', 50, TRUE)
	return soul.anchor

/datum/eldritch_knowledge/base_spirit/proc/reap(mob/living/user, mob/living/victim)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/eldritch_knowledge/required = heretic?.get_knowledge(/datum/eldritch_knowledge/spell/spirit_reap)
	if(!can_use(user) || QDELETED(required) || !isturf(victim?.loc) || !line_clear(user, victim) || !heretic_can_affect(user, victim, chargecost = 0))
		return FALSE
	if(!heretic_can_affect(user, victim))
		return TRUE
	var/brute_before = victim.getBruteLoss()
	victim.adjustBruteLoss(22)
	if(!can_use(user) || QDELETED(victim))
		return TRUE
	log_combat(user, victim, "наносит первый удар Жатвы", addition = "фактически [round(victim.getBruteLoss() - brute_before, 0.1)] ушибов")
	var/datum/status_effect/heretic_spirit/separated/soul = separate(victim, required)
	soul?.arm(required, 25)
	new /obj/effect/temp_visual/heretic_spirit/reap(get_turf(victim), src)
	playsound(user, 'modular_bluemoon/sound/heretic/spirit_reap.ogg', 60, TRUE)
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/ring(mob/living/user, final_cast = FALSE)
	ring_failure = null
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/required_type = final_cast ? /datum/eldritch_knowledge/final_eldritch/spirit_final : /datum/eldritch_knowledge/spell/spirit_bell
	var/datum/eldritch_knowledge/required = heretic?.get_knowledge(required_type)
	if(!can_use(user) || QDELETED(required) || (final_cast && !ascension_active))
		ring_failure = "Звон недоступен вашему знанию, вознесению или текущему телу."
		return FALSE
	if(!final_cast && !spend_combat_resource(2))
		ring_failure = "Для Заупокойного звона нужны 2 обола; сейчас [combat_resource]."
		return FALSE
	var/radius = final_cast ? 4 : 3
	if(final_cast)
		last_voyage_fx(user)
		GLOB.heretic_sky.event(required)
	else
		toll_fx(user, radius)
	for(var/turf/tile in range(radius, user))
		if(!line_clear(user, tile, radius))
			continue
		for(var/mob/living/victim in tile)
			if(!heretic_can_affect(user, victim))
				continue
			new /obj/effect/temp_visual/heretic_spirit/burst(tile, src)
			victim.adjustBruteLoss(final_cast ? 30 : 20)
			if(!can_use(user))
				return TRUE
			if(QDELETED(victim))
				continue
			victim.adjustStaminaLoss(final_cast ? 25 : 20)
			var/datum/status_effect/heretic_spirit/separated/soul = separate(victim, required)
			soul?.arm(required, final_cast ? 40 : 25)
	if(final_cast)
		new /obj/effect/temp_visual/heretic_spirit/ascend(get_turf(user), src)
	playsound(user, final_cast ? 'modular_bluemoon/sound/heretic/spirit_voyage.ogg' : 'modular_bluemoon/sound/heretic/spirit_bell.ogg', 75, FALSE)
	return TRUE

/// Заупокойный звон: одна бледная волна от перевозчика на весь радиус, вспышка на нём самом.
/datum/eldritch_knowledge/base_spirit/proc/toll_fx(mob/living/user, radius)
	var/ink = heretic_path_ink(PATH_SPIRIT)
	heretic_vfx_shockwave(user, ink, radius, HERETIC_SPIRIT_TOLL_WAVE_TIME)
	heretic_vfx_pulse(user, ink, 2, HERETIC_SPIRIT_TOLL_PULSE)
	heretic_vfx_flash(user, ink, HERETIC_SPIRIT_TOLL_FLASH_RANGE_BELL, HERETIC_SPIRIT_TOLL_FLASH_POWER, HERETIC_SPIRIT_TOLL_FLASH_TIME)

/// Последний рейс: свет фонаря, бледная волна, души по спирали стягиваются к перевозчику, земля дрожит.
/datum/eldritch_knowledge/base_spirit/proc/last_voyage_fx(mob/living/user)
	var/ink = heretic_path_ink(PATH_SPIRIT)
	var/turf/center = get_turf(user)
	heretic_vfx_rays(user, ink, HERETIC_SPIRIT_VOYAGE_LANTERN_TIME)
	heretic_vfx_pulse(user, ink, 2, HERETIC_SPIRIT_VOYAGE_LANTERN_TIME / 2)
	heretic_vfx_flash(center, ink, HERETIC_SPIRIT_VOYAGE_FLASH_RANGE, HERETIC_SPIRIT_VOYAGE_FLASH_POWER, HERETIC_SPIRIT_VOYAGE_FLASH_TIME)
	heretic_vfx_shockwave(center, ink, HERETIC_SPIRIT_VOYAGE_WAVE_RADIUS, HERETIC_SPIRIT_VOYAGE_WAVE_TIME)
	heretic_vfx_burst(center, /particles/heretic_ascension/spirit)
	heretic_vfx_converge(center, /particles/heretic_ascension/spirit/spiral, HERETIC_SPIRIT_VOYAGE_SPIRAL_RADIUS, HERETIC_SPIRIT_VOYAGE_SPIRAL_TRAVEL, HERETIC_SPIRIT_VOYAGE_SPIRAL_EMIT, HERETIC_SPIRIT_VOYAGE_SPIRAL_ARMS, HERETIC_SPIRIT_VOYAGE_SPIRAL_SWIRL)
	heretic_vfx_quake(center, HERETIC_SPIRIT_VOYAGE_QUAKE_RADIUS, HERETIC_SPIRIT_VOYAGE_QUAKE, HERETIC_SPIRIT_VOYAGE_QUAKE_TIME)

/datum/eldritch_knowledge/base_spirit/on_mansus_grasp(atom/target, mob/user, proximity_flag, click_parameters)
	grasp_failure_reason = null
	if(!proximity_flag)
		return FALSE
	var/mob/living/corpse = obol_body_in(target)
	if(corpse)
		if(user.a_intent != INTENT_HELP)
			grasp_failure_reason = "Обол на глаза кладут в намерении «Помощь»."
			return FALSE
		return place_obol(user, corpse)
	if(user.a_intent != INTENT_HELP || isliving(target))
		return FALSE
	var/turf/place = get_turf(target)
	if(!place)
		return FALSE
	if(death_marks[place])
		return read_death_mark(user, place)
	var/turf/near_mark = nearest_death_mark(place)
	if(near_mark)
		grasp_failure_reason = "Холодный след рядом, в [get_dist(place, near_mark)] клетк[get_dist(place, near_mark) == 1 ? "е" : "ах"]: коснитесь Хваткой самого места смерти."
	return FALSE

/// Неостывший след в паре клеток от промаха Хватки.
/datum/eldritch_knowledge/base_spirit/proc/nearest_death_mark(turf/place)
	var/best = INFINITY
	for(var/turf/marked as anything in death_marks)
		var/list/mark = death_marks[marked]
		var/distance = get_dist(place, marked)
		if(marked.z == place.z && distance <= HERETIC_SPIRIT_DEATH_MARK_HINT && distance < best && world.time < mark["until"])
			best = distance
			. = marked

/// Мёртвое тело под Хваткой: само тело, тело в морге или крематории, тело в мешке.
/datum/eldritch_knowledge/base_spirit/proc/obol_body_in(atom/target)
	if(isliving(target))
		var/mob/living/body = target
		return body.stat == DEAD && heretic_spirit_obol_body(body) ? body : null
	if(!istype(target, /obj/structure/bodycontainer) && !istype(target, /obj/structure/closet/body_bag))
		return null
	for(var/atom/movable/thing in target)
		var/mob/living/body = istype(thing, /obj/structure/closet/body_bag) ? (locate(/mob/living) in thing) : thing
		if(isliving(body) && body.stat == DEAD && heretic_spirit_obol_body(body))
			return body
	return null

/// Тело, на чьи глаза ложится обол: человек, мартышка или живое существо не мельче кошки; машины, слуги Мансуса и мелочь - нет.
/proc/heretic_spirit_obol_body(mob/living/body)
	if(ishuman(body))
		return TRUE
	if(!isliving(body) || IS_HERETIC_MONSTER(body) || !(body.mob_biotypes & MOB_ORGANIC) || body.mob_size < MOB_SIZE_SMALL)
		return FALSE
	return ismonkey(body) || isanimal(body)

/// Тело на полу, в морге, крематории или мешке.
/proc/heretic_spirit_obol_reachable(mob/living/body)
	var/atom/holder = body?.loc
	if(istype(holder, /obj/structure/closet/body_bag))
		holder = holder.loc
	return isturf(holder) || istype(holder, /obj/structure/bodycontainer)

/datum/eldritch_knowledge/base_spirit/proc/place_obol(mob/living/user, mob/living/corpse)
	grasp_failure_reason = null
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	if(!heretic || !can_use(user) || !isliving(corpse) || corpse.stat != DEAD || !heretic_spirit_obol_body(corpse) || !heretic_spirit_obol_reachable(corpse))
		return FALSE
	if(corpse.GetComponent(/datum/component/heretic_craft))
		grasp_failure_reason = (corpse in obols) ? "На глазах этого тела уже лежит ваш обол." : "На этом теле уже лежит чужое ремесло."
		return FALSE
	var/deed_key = heretic.deed_key_for(corpse)
	var/paid = (WEAKREF(corpse) in deed_bodies)
	var/counts = heretic_spirit_deed_place(get_turf(corpse), heretic.simulated)
	if(!paid && counts)
		grasp_failure_reason = heretic.deed_wait_reason(deed_key)
		if(grasp_failure_reason)
			return FALSE
	while(length(obols) >= HERETIC_SPIRIT_OBOL_LIMIT)
		var/mob/living/oldest = obols[1]
		log_game("[key_name(user)] теряет обол Духа на [key_name(oldest)] в [AREACOORD(oldest)]: его вытеснил новый.")
		remove_obol(oldest)
	corpse.AddComponent(/datum/component/heretic_craft, src, HERETIC_SPIRIT_OBOL_CRAFT, HERETIC_SPIRIT_OBOL_CLUE, ishuman(corpse) ? heretic_spirit_eye_overlay(corpse, "spirit_obol_eyes", HERETIC_SPIRIT_OBOL_LAYER) : null)
	obols[corpse] = 0
	to_chat(user, span_eldritch(last_moment(corpse)))
	var/mob/dead/observer/ghost = corpse.get_ghost(TRUE)
	if(ghost?.client)
		open_whisper(corpse, ghost)
		to_chat(user, span_notice("Призрак [corpse.real_name] [HERETIC_SPIRIT_WHISPER_TIME / (1 MINUTES)] минут может шептать вам и указывать живых рядом с собой. Держится оболов: [length(obols)] из [HERETIC_SPIRIT_OBOL_LIMIT]."))
	else
		to_chat(user, span_notice("Призрака у этого тела нет: шептать и указывать вам некому. Держится оболов: [length(obols)] из [HERETIC_SPIRIT_OBOL_LIMIT]."))
	playsound(corpse, pick('modular_bluemoon/sound/heretic/spirit_obol_1.ogg', 'modular_bluemoon/sound/heretic/spirit_obol_2.ogg'), 40, TRUE, SILENCED_SOUND_EXTRARANGE)
	log_game("[key_name(user)] кладёт обол Духа на глаза [key_name(corpse)] в [AREACOORD(corpse)].")
	if(paid)
		if(heretic.deed && !heretic.deed.complete())
			to_chat(user, span_notice("Мансус уже принял плату за это тело: второй раз в дело оно не идёт."))
	else if(!counts)
		if(heretic.deed && !heretic.deed.complete())
			to_chat(user, span_notice("Это тело вне станции: обол держит шёпот, но в дело пути не идёт."))
	else if(heretic.advance_deed(deed_key, get_turf(corpse)))
		deed_bodies += WEAKREF(corpse)
	notify_resource_changed()
	SEND_SIGNAL(src, COMSIG_HERETIC_SPIRIT_EVENT, "obol", corpse)
	return TRUE

/// Оверлей на глаза человека: слой между маской и головным убором, со сдвигом глаз вида.
/proc/heretic_spirit_eye_overlay(mob/living/carbon/human/person, state, layer)
	var/mutable_appearance/eyes = mutable_appearance('modular_bluemoon/icons/obj/heretic_spirit_effects.dmi', state, -layer)
	var/list/offsets = person.dna?.species?.offset_features
	if(offsets && (OFFSET_EYES in offsets))
		eyes.pixel_x += offsets[OFFSET_EYES][1]
		eyes.pixel_y += offsets[OFFSET_EYES][2]
	return eyes

/// Дело Духа идёт на станции; у учебного перевозчика - только на полигоне, у настоящего - только вне его.
/proc/heretic_spirit_deed_place(turf/place, simulated = FALSE)
	if(!place)
		return FALSE
	var/training = istype(get_area(place), /area/antag_training)
	return simulated ? training : (!training && is_station_level(place.z))

/// Смерть на станции оставляет холодный след: Хватка в «Помощи» по тому полу засчитает отдел, даже если тело унесли или оживили.
/datum/eldritch_knowledge/base_spirit/proc/on_any_death(datum/source, mob/living/died, gibbed)
	SIGNAL_HANDLER
	note_death_time(died)
	if(QDELETED(spirit_body) || died == spirit_body || !heretic_spirit_obol_body(died))
		return
	var/datum/antagonist/heretic/heretic = IS_HERETIC(spirit_body)
	var/turf/place = get_turf(died)
	if(!heretic || !heretic_spirit_deed_place(place, heretic.simulated))
		return
	for(var/turf/old as anything in death_marks.Copy())
		var/list/old_mark = death_marks[old]
		if(world.time >= old_mark["until"])
			drop_death_mark(old)
	if(length(death_marks) >= HERETIC_SPIRIT_DEATH_MARK_LIMIT && !death_marks[place])
		drop_death_mark(death_marks[1])
	drop_death_mark(place)
	var/image/trail = image('modular_bluemoon/icons/obj/heretic_traces.dmi', place, "trace_spirit", TURF_DECAL_LAYER)
	trail.alpha = HERETIC_SPIRIT_DEATH_MARK_ALPHA
	trail.color = HERETIC_SPIRIT_SILVER_INK
	trail.appearance_flags = RESET_COLOR | KEEP_APART
	death_marks[place] = list("until" = world.time + HERETIC_SPIRIT_DEATH_MARK_TIME, "body" = WEAKREF(died), "image" = trail)
	show_death_marks(spirit_body)
	addtimer(CALLBACK(src, PROC_REF(expire_death_mark), place), HERETIC_SPIRIT_DEATH_MARK_TIME)
	if(ishuman(died) && died.mind && spirit_body.stat != DEAD && heretic.deed && !heretic.deed_error(heretic.deed_key_for(place), TRUE))
		to_chat(spirit_body, span_notice("В отделе «[get_area_name(place, TRUE)]» оборвалась жизнь. Холодный след продержится [HERETIC_SPIRIT_DEATH_MARK_TIME / (1 MINUTES)] минут: Хватка в «Помощи» по тому полу продвинет дело."))

/datum/eldritch_knowledge/base_spirit/proc/read_death_mark(mob/living/user, turf/place)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/list/mark = death_marks[place]
	if(!heretic || !mark || !can_use(user))
		return FALSE
	if(world.time >= mark["until"])
		drop_death_mark(place)
		grasp_failure_reason = "След смерти здесь уже остыл: он держится [HERETIC_SPIRIT_DEATH_MARK_TIME / (1 MINUTES)] минут."
		return FALSE
	var/datum/weakref/body_ref = mark["body"]
	if(body_ref && (body_ref in deed_bodies))
		grasp_failure_reason = "Мансус уже принял плату за эту смерть."
		return FALSE
	var/deed_key = heretic.deed_key_for(place)
	grasp_failure_reason = heretic.deed_wait_reason(deed_key) || heretic.deed_error(deed_key)
	if(grasp_failure_reason)
		return FALSE
	heretic.advance_deed(deed_key, place, silent = TRUE)
	drop_death_mark(place)
	if(body_ref)
		deed_bodies += body_ref
	var/mob/living/body = body_ref?.resolve()
	to_chat(user, span_eldritch(body ? "Холодный след. [last_moment(body)]" : "Холодный след: здесь недавно оборвалась жизнь, но тела уже нет."))
	log_game("[key_name(user)] читает холодный след Духа[body ? " [key_name(body)]" : ""] в [AREACOORD(place)].")
	SEND_SIGNAL(src, COMSIG_HERETIC_SPIRIT_EVENT, "death_mark", place)
	return TRUE

/datum/eldritch_knowledge/base_spirit/proc/expire_death_mark(turf/place)
	var/list/mark = death_marks[place]
	if(mark && world.time >= mark["until"])
		drop_death_mark(place)

/datum/eldritch_knowledge/base_spirit/proc/drop_death_mark(turf/place)
	var/list/mark = death_marks[place]
	if(!mark)
		return
	var/image/trail = mark["image"]
	var/client/viewer = marks_viewer_ckey ? GLOB.directory[marks_viewer_ckey] : null
	viewer?.images -= trail
	death_marks -= place

/datum/eldritch_knowledge/base_spirit/proc/show_death_marks(mob/living/viewer)
	if(!viewer?.client)
		return
	if(marks_viewer_ckey && marks_viewer_ckey != viewer.client.ckey)
		hide_death_marks()
	marks_viewer_ckey = viewer.client.ckey
	for(var/turf/place as anything in death_marks)
		var/list/mark = death_marks[place]
		viewer.client.images |= mark["image"]

/// Следы снимаются с того клиента, которому их показали, даже если он уже вышел из тела.
/datum/eldritch_knowledge/base_spirit/proc/hide_death_marks(client/leaving)
	var/list/viewers = list(leaving)
	if(marks_viewer_ckey)
		viewers |= GLOB.directory[marks_viewer_ckey]
	marks_viewer_ckey = null
	for(var/client/viewer as anything in viewers)
		if(!viewer)
			continue
		for(var/turf/place as anything in death_marks)
			var/list/mark = death_marks[place]
			viewer.images -= mark["image"]

/datum/eldritch_knowledge/base_spirit/proc/on_body_login(mob/living/source)
	SIGNAL_HANDLER
	show_death_marks(source)

/datum/eldritch_knowledge/base_spirit/proc/on_body_logout(mob/living/source, client/leaving)
	SIGNAL_HANDLER
	hide_death_marks(leaving)

/datum/eldritch_knowledge/base_spirit/proc/note_death_time(mob/living/died)
	var/died_key = ckey(died?.mind?.key || died?.key)
	if(!died_key)
		return
	for(var/old_key in death_times)
		if(world.time - death_times[old_key] >= HERETIC_SPIRIT_FERRY_GRACE)
			death_times -= old_key
	death_times[died_key] = world.time

/// Игрок сидит в этом призраке: клиент при нём, а не в другом теле.
/proc/heretic_spirit_ghost_player(mob/dead/observer/ghost)
	if(!ghost)
		return null
	var/client/player = ghost.client || GLOB.directory[ckey(ghost.mind?.key || ghost.key)]
	return player?.mob == ghost ? player : null

/datum/eldritch_knowledge/base_spirit/proc/remove_obol(mob/living/corpse)
	qdel(heretic_craft_on(corpse, HERETIC_SPIRIT_OBOL_CRAFT))
	close_whisper(corpse)
	obols -= corpse

/datum/eldritch_knowledge/base_spirit/on_craft_removed(atom/crafted, craft_id)
	if(craft_id != HERETIC_SPIRIT_OBOL_CRAFT)
		return
	close_whisper(crafted)
	obols -= crafted
	notify_resource_changed()

/datum/eldritch_knowledge/base_spirit/pocket_exits(mob/living/user)
	. = list()
	for(var/mob/living/corpse as anything in obols)
		if(isturf(corpse.loc))
			heretic_add_pocket_exit(., "Обол - [get_area_name(corpse, TRUE)]", heretic_pocket_beside(corpse))
	if(moored())
		heretic_add_pocket_exit(., "Причал - [get_area_name(mooring, TRUE)]", heretic_pocket_beside(mooring))

/datum/eldritch_knowledge/base_spirit/pocket_door(mob/living/user, mob/living/victim)
	if(!door_holds(user, victim))
		return null
	return list("name" = "за реку", "text" = door_text(victim), "time" = HERETIC_POCKET_PULL_TIME, "check" = CALLBACK(src, PROC_REF(door_holds), user, victim))

/datum/eldritch_knowledge/base_spirit/proc/door_text(mob/living/victim)
	return "Пустое тело [victim] уходит вслед за своей душой, как в тёмную воду."

/// Душа этой цели в руке еретика, тело рядом.
/datum/eldritch_knowledge/base_spirit/proc/door_holds(mob/living/user, mob/living/victim)
	var/datum/status_effect/heretic_spirit_hold/hold = soul_hold
	if(QDELETED(hold) || hold.owner != victim || hold.holder != user || !user.is_holding(hold.soul_item))
		return FALSE
	return can_use(user) && isturf(victim.loc) && victim.z == user.z && get_dist(user, victim) <= 1

/// Душа в руке открывает дверь сама: щелчок ею по своему телу уводит цель охоты в изнанку.
/datum/eldritch_knowledge/base_spirit/proc/ferry_body(mob/living/user, mob/living/victim)
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	if(!heretic || !door_holds(user, victim))
		to_chat(user, span_warning("Встаньте вплотную к телу, чья душа у вас в руке."))
		return FALSE
	return heretic.pocket_pull(user, victim, get_turf(victim), HERETIC_POCKET_PULL_TIME, CALLBACK(src, PROC_REF(door_holds), user, victim), door_text(victim))

/// Запись лога атак, после которой здоровье тела упало; схватить или обыскать - не ранить.
/datum/eldritch_knowledge/base_spirit/proc/last_blow(mob/living/corpse)
	var/list/entries = corpse.logging[num2text(LOG_VICTIM)]
	if(!length(entries))
		return null
	for(var/index in length(entries) to 1 step -1)
		var/list/entry = entries[index]
		var/health_before = corpse.maxHealth
		if(index > 1)
			var/list/previous = entries[index - 1]
			health_before = text2num(previous["health"])
		var/health_after = text2num(entry["health"])
		if(entry["target_name"] && !isnull(health_after) && !isnull(health_before) && health_after < health_before)
			return entry
	return null

/datum/eldritch_knowledge/base_spirit/proc/last_moment(mob/living/corpse)
	var/list/entry = last_blow(corpse)
	if(!entry)
		return "Последний миг [corpse.name]: смерть пришла тихо."
	var/list/parts = list("ранил «[entry["target_name"]]»")
	var/weapon = log_weapon(entry["what"])
	if(weapon)
		parts += "чем: [weapon]"
	var/elapsed = world.time - entry["timestamp"]
	parts += elapsed < 1 SECONDS ? "только что" : "[DisplayTimeText(elapsed, 1)] назад"
	var/where = entry["where"]
	var/coords_at = findlasttext(where, " (")
	if(length(where) > 2 && coords_at > 2)
		parts += "где: [copytext(where, 2, coords_at)]"
	return "Последний миг [corpse.name]: [jointext(parts, "; ")]."

/// Оружие из строки log_combat: предмет пишется как «[имя]», а имя строкой - как «имя[DC]».
/datum/eldritch_knowledge/base_spirit/proc/log_weapon(what)
	var/marker = "при помощи "
	var/start = findtext(what, marker)
	if(!start)
		return null
	start += length(marker)
	if(copytext(what, start, start + 1) == "\[")
		var/close = findtext(what, "\]", start + 1)
		return close ? copytext(what, start + 1, close) : null
	var/stop = length(what) + 1
	for(var/ending in list("\[DC\]", " (", "/(", "<"))
		var/found = findtext(what, ending, start)
		if(found)
			stop = min(stop, found)
	var/weapon = trim(copytext(what, start, stop))
	return length(weapon) ? weapon : null

/datum/eldritch_knowledge/base_spirit/proc/open_whisper(mob/living/corpse, mob/dead/observer/ghost)
	if(!(corpse in obols) || QDELETED(ghost))
		return FALSE
	obols[corpse] = world.time + HERETIC_SPIRIT_WHISPER_TIME
	obol_ghosts[corpse] = WEAKREF(ghost)
	heretic_spirit_grant_ghost_tools(ghost, /atom/movable/screen/alert/heretic_spirit_obol)
	to_chat(ghost, span_boldnotice("На глаза вашего тела положили обол."))
	to_chat(ghost, span_deadsay("[HERETIC_SPIRIT_WHISPER_TIME / (1 MINUTES)] минут вы можете шептать тому, кто его положил, и указывать ему живых рядом с собой: нажмите значок «Обол на глазах» справа вверху или «Шепнуть перевозчику» и «Указать перевозчику» во вкладке Ghost."))
	SEND_SOUND(ghost, sound('modular_bluemoon/sound/heretic/spirit_obol_gain.ogg', volume = 40))
	addtimer(CALLBACK(src, PROC_REF(expire_whisper), WEAKREF(corpse)), HERETIC_SPIRIT_WHISPER_TIME)
	return TRUE

/// Глаголы и значок призрака, который служит перевозчику: шёпот и указание живых.
/proc/heretic_spirit_grant_ghost_tools(mob/dead/observer/ghost, alert_type)
	add_verb(ghost, list(/mob/dead/observer/proc/heretic_spirit_whisper, /mob/dead/observer/proc/heretic_spirit_point))
	ghost.throw_alert(HERETIC_SPIRIT_OBOL_ALERT, alert_type)

/// Призрак, который больше никому не служит, теряет глаголы и значок; служащий другому перевозчику их сохраняет.
/proc/heretic_spirit_refresh_ghost_tools(mob/dead/observer/ghost)
	if(QDELETED(ghost) || heretic_spirit_master_of(ghost))
		return
	remove_verb(ghost, list(/mob/dead/observer/proc/heretic_spirit_whisper, /mob/dead/observer/proc/heretic_spirit_point))
	ghost.clear_alert(HERETIC_SPIRIT_OBOL_ALERT)

/// Перевозчик, которому служит призрак: под оболом своего тела или проявившись у Причала на его стороне.
/proc/heretic_spirit_master_of(mob/dead/observer/ghost)
	var/datum/component/heretic_craft/craft = heretic_craft_on(ghost?.mind?.current, HERETIC_SPIRIT_OBOL_CRAFT)
	var/datum/eldritch_knowledge/base_spirit/spirit = craft?.owner_ref?.resolve()
	if(istype(spirit) && spirit.informant_of(ghost))
		return spirit
	for(var/obj/structure/heretic_spirit_mooring/mooring as anything in GLOB.heretic_spirit_moorings)
		var/datum/eldritch_knowledge/base_spirit/owner = mooring.spirit_ref?.resolve()
		if(owner && mooring.ghost_side(ghost) == HERETIC_SPIRIT_GHOST_FERRY)
			return owner
	return null

/// Ключ осведомителя для пауз: тело под оболом или призрак у Причала на стороне перевозчика; null - призрак не служит.
/datum/eldritch_knowledge/base_spirit/proc/informant_of(mob/dead/observer/ghost)
	var/mob/living/corpse = ghost?.mind?.current
	var/datum/weakref/ghost_ref = corpse ? obol_ghosts[corpse] : null
	if(corpse && (corpse in obols) && ghost_ref?.resolve() == ghost)
		return corpse
	if(ghost && mooring?.ghost_side(ghost) == HERETIC_SPIRIT_GHOST_FERRY)
		return "ferry:[REF(ghost)]"
	return null

/datum/eldritch_knowledge/base_spirit/proc/informant_name(mob/dead/observer/ghost, informant)
	var/mob/living/corpse = informant
	return istype(corpse) ? corpse.real_name : ghost.name

/atom/movable/screen/alert/heretic_spirit_obol
	name = "Обол на глазах"
	desc = "Еретик положил обол на глаза вашего тела. Нажмите, чтобы шепнуть ему или указать живого человека рядом с вами: он почует, в какой тот стороне."
	icon = 'modular_bluemoon/icons/obj/heretic_alerts.dmi'
	icon_state = "sigil_spirit"

/atom/movable/screen/alert/heretic_spirit_obol/ferry
	name = "Слуга перевозчика"
	desc = "Вы проявились у Причала на стороне перевозчика. Нажмите, чтобы шепнуть ему или указать живого человека рядом с вами: он почует, в какой тот стороне."

/atom/movable/screen/alert/heretic_spirit_obol/Click(location, control, params)
	. = ..()
	if(!. || !isobserver(owner))
		return
	var/mob/dead/observer/ghost = owner
	var/choice = tgui_alert(ghost, "Что передать перевозчику?", name, list("Шепнуть", "Указать живого"))
	if(QDELETED(ghost))
		return
	if(choice == "Шепнуть")
		ghost.heretic_spirit_whisper()
	else if(choice == "Указать живого")
		ghost.heretic_spirit_point()

/datum/eldritch_knowledge/base_spirit/proc/expire_whisper(datum/weakref/corpse_ref)
	var/mob/living/corpse = corpse_ref?.resolve()
	if(corpse && (corpse in obols) && world.time >= obols[corpse])
		close_whisper(corpse)

/datum/eldritch_knowledge/base_spirit/proc/close_whisper(mob/living/corpse)
	var/datum/weakref/ghost_ref = obol_ghosts[corpse]
	obol_ghosts -= corpse
	whisper_ready -= corpse
	point_ready -= corpse
	var/mob/dead/observer/ghost = ghost_ref?.resolve()
	if(ghost)
		heretic_spirit_refresh_ghost_tools(ghost)

/datum/eldritch_knowledge/base_spirit/proc/deliver_whisper(mob/dead/observer/ghost, message)
	whisper_failure = null
	var/informant = informant_of(ghost)
	message = sanitize(trim(copytext_char(message, 1, HERETIC_SPIRIT_WHISPER_LENGTH)))
	if(!length(message))
		whisper_failure = "Пустой шёпот никто не услышит."
	else if(heretic_spirit_ghost_muted(ghost))
		whisper_failure = "Вам запрещено говорить: шёпот перевозчику не уйдёт."
	else if(!informant)
		whisper_failure = "На глазах вашего тела больше нет обола."
	else if(isliving(informant) && world.time >= obols[informant])
		whisper_failure = "Время шёпота вышло."
	else if(world.time < whisper_ready[informant])
		whisper_failure = "Слишком часто: следующий шёпот через [heretic_capture_seconds_left(whisper_ready[informant])] с."
	else if(QDELETED(spirit_body))
		whisper_failure = "Перевозчик вас не слышит."
	if(whisper_failure)
		return FALSE
	whisper_ready[informant] = world.time + HERETIC_SPIRIT_WHISPER_COOLDOWN
	to_chat(spirit_body, span_eldritch("Шёпот [informant_name(ghost, informant)]: «[message]»"))
	to_chat(ghost, span_deadsay("Вы шепчете перевозчику: «[message]»"))
	log_directed_talk(ghost, spirit_body, message, LOG_SAY, "шёпот перевозчику")
	return TRUE

/// Мут администратора или запрет мёртвого чата закрывают и шёпот перевозчику.
/proc/heretic_spirit_ghost_muted(mob/ghost)
	if(!ghost.client)
		return FALSE
	return (ghost.client.prefs?.muted & (MUTE_IC | MUTE_DEADCHAT)) || jobban_isbanned(ghost, "deadchat")

/mob/dead/observer/proc/heretic_spirit_whisper()
	set name = "Шепнуть перевозчику"
	set category = "Ghost"
	set desc = "Шепните еретику, которому вы служите: под оболом на глазах вашего тела или у его Причала. Услышит только он."
	var/datum/eldritch_knowledge/base_spirit/spirit = heretic_spirit_master_of(src)
	if(!istype(spirit))
		to_chat(src, span_warning("Вы больше не служите перевозчику: обол с вашего тела сняли или фонарь Причала погас."))
		heretic_spirit_refresh_ghost_tools(src)
		return
	var/message = tgui_input_text(src, "Что прошептать перевозчику? Услышит только он.", "Шёпот перевозчику", max_length = HERETIC_SPIRIT_WHISPER_LENGTH)
	if(!message || QDELETED(spirit))
		return
	if(!spirit.deliver_whisper(src, message))
		to_chat(src, span_warning(spirit.whisper_failure))

/// Призрак под оболом указывает живого человека рядом с собой: перевозчик чует, в какой он стороне.
/mob/dead/observer/proc/heretic_spirit_point()
	set name = "Указать перевозчику"
	set category = "Ghost"
	set desc = "Укажите еретику, которому вы служите, живого человека рядом с вами: он почует, в какой тот стороне."
	var/datum/eldritch_knowledge/base_spirit/spirit = heretic_spirit_master_of(src)
	if(!istype(spirit))
		to_chat(src, span_warning("Вы больше не служите перевозчику: обол с вашего тела сняли или фонарь Причала погас."))
		heretic_spirit_refresh_ghost_tools(src)
		return
	var/list/choices = spirit.point_choices(src)
	if(!length(choices))
		to_chat(src, span_warning("Рядом с вами нет живых людей: подлетите ближе к тому, кого хотите указать."))
		return
	var/choice = tgui_input_list(src, "Кого указать перевозчику? Он почует, в какой стороне этот человек.", "Указать перевозчику", choices)
	if(!choice || QDELETED(spirit))
		return
	if(!spirit.deliver_point(src, choices[choice]))
		to_chat(src, span_warning(spirit.point_failure))

/// Живые люди рядом с призраком, подписанные видимым именем.
/datum/eldritch_knowledge/base_spirit/proc/point_choices(mob/dead/observer/ghost)
	. = list()
	var/turf/ghost_turf = get_turf(ghost)
	if(!ghost_turf)
		return
	for(var/mob/living/carbon/human/person in range(HERETIC_SPIRIT_POINT_RANGE, ghost_turf))
		if(person.stat == DEAD || person == spirit_body)
			continue
		var/label = person.name
		var/index = 1
		while(.[label])
			label = "[person.name] ([++index])"
		.[label] = person

/datum/eldritch_knowledge/base_spirit/proc/deliver_point(mob/dead/observer/ghost, mob/living/carbon/human/person)
	point_failure = null
	var/informant = informant_of(ghost)
	var/turf/ghost_turf = get_turf(ghost)
	var/turf/person_turf = get_turf(person)
	if(heretic_spirit_ghost_muted(ghost))
		point_failure = "Вам запрещено говорить: перевозчик вас не услышит."
	else if(!informant)
		point_failure = "На глазах вашего тела больше нет обола."
	else if(isliving(informant) && world.time >= obols[informant])
		point_failure = "Время шёпота вышло."
	else if(world.time < point_ready[informant])
		point_failure = "Указать снова можно через [heretic_capture_seconds_left(point_ready[informant])] с."
	else if(QDELETED(spirit_body))
		point_failure = "Перевозчик вас не слышит."
	else if(QDELETED(person) || person.stat == DEAD || !ghost_turf || !person_turf || ghost_turf.z != person_turf.z || get_dist(ghost_turf, person_turf) > HERETIC_SPIRIT_POINT_RANGE)
		point_failure = "Этого человека уже нет рядом с вами."
	if(point_failure)
		return FALSE
	point_ready[informant] = world.time + HERETIC_SPIRIT_POINT_COOLDOWN
	var/informant_name = informant_name(ghost, informant)
	log_game("Призрак [key_name(ghost)] указывает перевозчику [key_name(spirit_body)] на [key_name(person)] в [AREACOORD(person)].")
	SEND_SOUND(spirit_body, sound('modular_bluemoon/sound/heretic/spirit_point.ogg', volume = 40))
	if(heretic_magic_ward(spirit_body, person, chargecost = 0, notify = FALSE))
		to_chat(spirit_body, span_eldritch("Призрак [informant_name] на кого-то указывает, но след укрыт защитой от магии."))
		to_chat(ghost, span_deadsay("Этого человека хранит защита от магии: перевозчик не почуял след."))
		return TRUE
	var/datum/antagonist/heretic/heretic = IS_HERETIC(spirit_body)
	var/hunted = heretic?.hunt_target && person.mind == heretic.hunt_target
	var/lead_time = hunted ? HERETIC_SPIRIT_LEAD_HUNT_TIME : HERETIC_SPIRIT_LEAD_TIME
	spirit_body.apply_status_effect(/datum/status_effect/heretic_spirit_lead, person, informant_name, lead_time)
	to_chat(spirit_body, span_eldritch("Призрак [informant_name] указывает: [person.name].[hunted ? " Это ваша цель охоты!" : ""] [DisplayTimeText(lead_time)] вы чуете, в какой стороне этот человек."))
	to_chat(ghost, span_deadsay("Вы указали перевозчику: [person.name]."))
	return TRUE

/datum/status_effect/heretic_spirit_lead
	id = "heretic_spirit_lead"
	duration = HERETIC_SPIRIT_LEAD_TIME
	tick_interval = HERETIC_SPIRIT_LEAD_INTERVAL
	status_type = STATUS_EFFECT_REPLACE
	alert_type = /atom/movable/screen/alert/status_effect/heretic_spirit_lead
	var/datum/weakref/quarry_ref
	var/quarry_name
	var/informant
	var/lead_text

/datum/status_effect/heretic_spirit_lead/on_creation(mob/living/new_owner, mob/living/quarry, informant_name, time)
	quarry_ref = WEAKREF(quarry)
	quarry_name = quarry?.name
	informant = informant_name
	if(time)
		duration = time
	. = ..()
	if(!QDELETED(src))
		update_lead()

/datum/status_effect/heretic_spirit_lead/tick()
	var/mob/living/quarry = quarry_ref?.resolve()
	if(quarry && heretic_magic_ward(owner, quarry, chargecost = 0, notify = FALSE))
		to_chat(owner, span_warning("След [quarry_name] обрывается: его укрыла защита от магии."))
		qdel(src)
		return
	update_lead()

/datum/status_effect/heretic_spirit_lead/proc/update_lead()
	var/mob/living/quarry = quarry_ref?.resolve()
	var/turf/here = get_turf(owner)
	var/turf/there = get_turf(quarry)
	var/state = "spirit_lead_null"
	var/direction = SOUTH
	if(!there || quarry.stat == DEAD)
		lead_text = "след оборвался"
	else if(here?.z != there.z)
		lead_text = "ушёл с уровня"
	else
		var/distance = get_dist(here, there)
		var/side = GLOB.heretic_mansus_directions["[get_dir(here, there)]"]
		if(!distance)
			lead_text = "прямо здесь"
			state = "spirit_lead_direct"
		else
			direction = get_dir(here, there)
			if(distance <= HERETIC_SPIRIT_LEAD_NEAR)
				lead_text = "рядом, [side]"
				state = "spirit_lead_close"
			else if(distance <= HERETIC_SPIRIT_LEAD_FAR)
				lead_text = "недалеко, [side]"
				state = "spirit_lead_medium"
			else
				lead_text = "далеко, [side]"
				state = "spirit_lead_far"
	if(!linked_alert)
		return
	linked_alert.name = "Указание призрака: [quarry_name]"
	linked_alert.desc = "Призрак [informant] указал на [quarry_name]: [lead_text]. Обновляется раз в [HERETIC_SPIRIT_LEAD_INTERVAL / (1 SECONDS)] секунды, только на вашем уровне."
	linked_alert.icon_state = state
	linked_alert.setDir(direction)

/atom/movable/screen/alert/status_effect/heretic_spirit_lead
