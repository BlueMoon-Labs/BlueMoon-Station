/// Перед Жатвой над душой занесён крюк, а сама она дрожит сильнее.
/obj/structure/heretic_spirit_soul/proc/warn_reap(active)
	if(reaping == active)
		return
	reaping = active
	var/datum/filter = get_filter(HERETIC_SPIRIT_SOUL_WAVE_FILTER)
	if(filter)
		animate(filter, size = active ? HERETIC_SPIRIT_REAP_WAVE_SIZE : HERETIC_SPIRIT_SOUL_WAVE_SIZE, time = HERETIC_SPIRIT_REAP_WARN_TIME, flags = ANIMATION_PARALLEL)
	if(active)
		reap_hook = mutable_appearance('modular_bluemoon/icons/obj/heretic_spirit_effects.dmi', "spirit_reap", FLOAT_LAYER, appearance_flags = RESET_COLOR | RESET_ALPHA | RESET_TRANSFORM | KEEP_APART)
		add_overlay(reap_hook)
		set_light(2, 1, "#b2ffe3")
		return
	cut_overlay(reap_hook)
	reap_hook = null
	set_light(1, 0.7, "#a8f5dc")

