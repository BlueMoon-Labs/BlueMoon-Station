/obj/item/heretic_path_relic/spirit/proc/beckon(mob/living/user)
	if(!isliving(user))
		return FALSE
	var/datum/antagonist/heretic/heretic = IS_HERETIC(user)
	var/datum/eldritch_knowledge/base_spirit/spirit = heretic?.get_knowledge(/datum/eldritch_knowledge/base_spirit)
	if(!authorized(user) || !spirit?.can_use(user) || !COOLDOWN_FINISHED(src, relic_cooldown))
		return FALSE
	var/acted = FALSE
	var/collected = FALSE
	var/healing = 0
	for(var/datum/status_effect/heretic_spirit/separated/soul as anything in spirit.souls.Copy())
		if(!soul.validate_link() || !spirit.line_clear(user, soul.anchor, 3))
			continue
		acted = TRUE
		if(!user.Adjacent(soul.anchor))
			var/turf/destination = get_step(soul.anchor, get_dir(soul.anchor, user))
			if(spirit.line_clear(soul.anchor, destination, 1))
				soul.anchor.forceMove(destination)
		if(QDELETED(soul))
			continue
		if(user.Adjacent(soul.anchor))
			collected = TRUE
			if(spirit.collect(user, soul))
				healing = HERETIC_SPIRIT_LANTERN_HEAL
	if(!acted)
		return FALSE
	heretic_heal_pool(user, healing)
	COOLDOWN_START(src, relic_cooldown, 20 SECONDS)
	new /obj/effect/temp_visual/heretic_spirit/grasp(get_turf(user), spirit)
	if(!collected)
		playsound(user, 'modular_bluemoon/sound/heretic/spirit_collect.ogg', 35, TRUE)
	return TRUE

/// Облик души: вытянутая полупрозрачная копия model без глаз и губ; свечение, невидимость и чужие фильтры не копируются. Цвет ставит heretic_spirit_wear_soul().
/proc/heretic_spirit_soul_look(mob/living/model)
	var/mutable_appearance/look = new(model)
	for(var/mutable_appearance/overlay as anything in look.overlays.Copy())
		if(overlay.layer == -BODY_LAYER || PLANE_TO_TRUE(overlay.plane) == EMISSIVE_PLANE)
			look.overlays -= overlay
	look.filters = null
	look.render_target = null
	look.render_source = null
	look.invisibility = 0
	look.alpha = HERETIC_SPIRIT_SOUL_ALPHA
	look.appearance_flags = KEEP_TOGETHER | LONG_GLIDE
	look.layer = ABOVE_MOB_LAYER
	look.pixel_x = model.base_pixel_x
	look.pixel_y = model.base_pixel_y
	var/matrix/stretch = matrix()
	stretch.Scale(1, HERETIC_SPIRIT_SOUL_STRETCH)
	stretch.Translate(0, HERETIC_SPIRIT_SOUL_LIFT)
	look.transform = stretch
	return look

/// Атом принимает облик души, но не плотность, непрозрачность и плоскость тела: копия /mutable_appearance всегда на FLOAT_PLANE и с пола не видна.
/atom/movable/proc/heretic_spirit_wear_soul(mob/living/model)
	var/own_density = density
	var/own_opacity = opacity
	var/own_plane = plane
	appearance = heretic_spirit_soul_look(model)
	color = heretic_vfx_ink_tint(heretic_path_ink(PATH_SPIRIT))
	density = own_density
	opacity = own_opacity
	plane = own_plane

/proc/heretic_spirit_fade_mask()
	var/static/icon/mask
	if(!mask)
		mask = icon('modular_bluemoon/icons/obj/heretic_spirit_effects.dmi', "spirit_soul_fade")
	return mask

/// Душа колышется: ноги тают в туман, фигура дрожит волной и покачивается в воздухе.
/proc/heretic_spirit_haunt(atom/movable/ghost, wave_size = HERETIC_SPIRIT_SOUL_WAVE_SIZE)
	ghost.add_filter(HERETIC_SPIRIT_SOUL_FADE_FILTER, 1, alpha_mask_filter(icon = heretic_spirit_fade_mask()))
	ghost.add_filter(HERETIC_SPIRIT_SOUL_WAVE_FILTER, 2, wave_filter(y = HERETIC_SPIRIT_SOUL_WAVELENGTH, size = wave_size, offset = rand()))
	animate(ghost.get_filter(HERETIC_SPIRIT_SOUL_WAVE_FILTER), offset = 1, time = HERETIC_SPIRIT_SOUL_WAVE_TIME, loop = -1, flags = ANIMATION_PARALLEL)
	var/base_y = ghost.pixel_y
	animate(ghost, pixel_y = base_y + HERETIC_SPIRIT_SOUL_BOB, time = HERETIC_SPIRIT_SOUL_BOB_TIME, loop = -1, easing = SINE_EASING, flags = ANIMATION_PARALLEL)
