/// Бледный отпечаток перевозчика остаётся на старом берегу и тает, сносимый к новому.
/proc/heretic_spirit_afterimage(mob/living/walker, turf/from, turf/to_turf)
	var/obj/effect/temp_visual/heretic_vfx/ghost/trail = heretic_vfx_ghost(walker, from, heretic_vfx_ink_tint(heretic_path_ink(PATH_SPIRIT)), HERETIC_SPIRIT_AFTERIMAGE_TIME, TRUE)
	if(!trail)
		return null
	trail.alpha = trail.model_share(HERETIC_SPIRIT_AFTERIMAGE_ALPHA)
	var/drift_x = to_turf ? clamp((to_turf.x - from.x) * world.icon_size / 2, -world.icon_size, world.icon_size) : 0
	var/drift_y = to_turf ? clamp((to_turf.y - from.y) * world.icon_size / 2, -world.icon_size, world.icon_size) : 0
	animate(trail, pixel_x = trail.pixel_x + drift_x, pixel_y = trail.pixel_y + drift_y, alpha = 0, time = HERETIC_SPIRIT_AFTERIMAGE_TIME, easing = SINE_EASING | EASE_IN)
	return trail

/// Шлейф шага сквозь живое, стол или чужие удары: отпечаток тянется за героем и тает, сквозь пройденное поднимаются огоньки.
/proc/heretic_spirit_passage_trail(mob/living/walker, turf/from, direction)
	var/obj/effect/temp_visual/heretic_vfx/ghost/trail = heretic_vfx_ghost(walker, from, heretic_vfx_ink_tint(heretic_path_ink(PATH_SPIRIT)), HERETIC_SPIRIT_PASSAGE_TIME, TRUE)
	if(trail)
		trail.alpha = trail.model_share(HERETIC_SPIRIT_PASSAGE_ALPHA)
		var/drift_x = ((direction & EAST) ? 1 : (direction & WEST) ? -1 : 0) * HERETIC_SPIRIT_PASSAGE_DRIFT
		var/drift_y = ((direction & NORTH) ? 1 : (direction & SOUTH) ? -1 : 0) * HERETIC_SPIRIT_PASSAGE_DRIFT
		animate(trail, pixel_x = trail.pixel_x + drift_x, pixel_y = trail.pixel_y + drift_y, alpha = 0, time = HERETIC_SPIRIT_PASSAGE_TIME, easing = SINE_EASING | EASE_IN)
	heretic_vfx_burst(walker, /particles/heretic_ascension/spirit/passage, HERETIC_VFX_BURST_TIME / 2)
	return trail

