# Copy this file to config/rsc_deploy.env in the TGS GameStaticFiles config
# directory. Only RSC_PUBLISH_DIR normally needs to be changed.

RSC_PUBLIC_BASE_URL=http://download.ss13-bluemoon.ru:8080/byond_rsc
# Optional semicolon-separated aliases or mirrors which serve the same archive
# names. PostCompile only writes RSC_PUBLISH_DIR, so every mirror must expose or
# synchronize that directory before the new DMB is activated.
#RSC_PUBLIC_MIRROR_BASE_URLS=https://rsc-mirror.example.com/byond_rsc;https://cdn.example.com/byond_rsc
RSC_PUBLISH_DIR=/var/www/byond_rsc
RSC_ARCHIVE_PREFIX=Moon-Blue
# Archive names are automatically namespaced by the persistent config path so
# separate TGS instances sharing RSC_PUBLISH_DIR cannot collide. Set an explicit
# stable safe name only when paths may be identical on different shared hosts.
#RSC_DEPLOYMENT_NAMESPACE=main-production

# 0 stores without compression, 1 is fastest, 9 is smallest. The RSC contains
# mostly pre-compressed media, so level 6 is a reasonable deployment default.
RSC_COMPRESSION_LEVEL=6

# Publishing fails before creating a new archive or enabling browser-assets if
# the target filesystem would have less than this many free bytes.
RSC_MIN_FREE_BYTES=536870912

# Automatically remove archives, lobby media and browser assets which are not
# referenced by any deployable DMB manifest/inventory below the TGS Game
# directory. The Game directory is inferred from this config path. If several
# TGS instances share RSC_PUBLISH_DIR, list every absolute Game directory
# separated by semicolons, for example:
# RSC_DEPLOYMENT_ROOTS=/srv/tgs/main/Game;/srv/tgs/test/Game
RSC_PRUNE_ENABLED=1
RSC_KEEP_UNREFERENCED=2
RSC_PRUNE_GRACE_HOURS=24
#RSC_DEPLOYMENT_ROOTS=/path/to/tgs/instance/Game

# Publish lobby backgrounds/music as content-addressed HTTP files and configure
# the built-in browser asset transport to use nginx. Both directories are
# created below RSC_PUBLISH_DIR and require no additional nginx location when
# that directory is already served recursively. PostCompile verifies write
# access, and DreamDaemon repeats a write probe before enabling this transport.
# IMPORTANT: browser-assets is loaded by TGUI from another origin. The HTTP
# server must return Access-Control-Allow-Origin and Vary headers described in
# tools/rsc_deploy/README.md, or TGUI elements will fail to load. Lobby images
# and audio do not require these CORS headers for normal playback.
RSC_PUBLISH_LOBBY_MEDIA=1
RSC_LOBBY_MEDIA_SUBDIR=lobby-media
RSC_ENABLE_ASSET_WEBROOT=1
RSC_ASSET_WEBROOT_SUBDIR=browser-assets
