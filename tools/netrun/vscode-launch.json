			"dreamDaemon": true
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamSeeker (GC_PROFILER)",
			"preLaunchTask": "Build All (GC_PROFILER)",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}"
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamSeeker (ABSOLUTE MINIMUM)",
			"preLaunchTask": "Build All (ABSOLUTE MINIMUM)",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}"
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamSeeker (TGUI DEV, LOWMEMORYMODE)",
			"preLaunchTask": "tgui: dev prelaunch (LOWMEMORYMODE)",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}",
			"env": {
				"TGUI_DEV_SERVER_IP": "127.0.0.1"
			}
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamSeeker (TGUI DEV, TESTING)",
			"preLaunchTask": "tgui: dev prelaunch (TESTING)",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}",
			"env": {
				"TGUI_DEV_SERVER_IP": "127.0.0.1"
			}
		},
		{
			"name": "NETRUN Core Host",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/tools/netrun/debug-host.mjs",
			"args": [
				"start"
			],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": [
				"<node_internals>/**"
			],
			"presentation": {
				"hidden": true
			}
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "NETRUN: Launch DreamSeeker",
			"preLaunchTask": "NETRUN: wait for Host",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}",
			"presentation": {
				"hidden": true
			},
			"env": {
				"NETRUN_CORE_MODE": "external",
				"NETRUN_CORE_PORT": "18462",
				"NETRUN_CORE_LIBRARY": "${workspaceFolder}/data/netrun-core/debug/netrun_bridge.dll",
				"NETRUN_CORE_TOKEN_FILE": "${workspaceFolder}/data/netrun-core/session-token.txt"
			}
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "NETRUN: Launch DreamSeeker (TRACY)",
			"preLaunchTask": "NETRUN: wait for Host",
			"dmb": "${workspaceFolder}/${command:CurrentDMB}",
			"presentation": {
				"hidden": true
			},
			"env": {
				"NETRUN_CORE_MODE": "external",
				"NETRUN_CORE_PORT": "18462",
