/obj/item/paper{
	default_raw_text = "<h1>Пометка сотрудникам DS-1 от Bioaegis Directive</h1><p>Благодаря успехам этого сектора в сфере био-органической инженерии, дополнительные модули были установлены для вашей платформы. Вторая фаза тестирований в процессе.</p><p>Напоминание: Хоть и официально от Триглава-НТ не было официальных заявлений, распространение органов вне DS-1 и DS-2 может быть наказуемо, однако каждый объект в праве заниматься печатью.<p>Flesh is weak, but deeds endure.</p>";
	name = "paper- 'Отчёт о Bioaegis Directive'"
	},
